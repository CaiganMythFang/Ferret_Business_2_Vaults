				}
				{
					id: "0A65C8885A799BAD"
					type: "item"
					item: "cookingforblockheads:preservation_chamber"
				}
			]
			rewards: [{
				id: "55AFBC7F6315A8DF"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Fine Slice"
			x: -6.75d
			y: 2.75d
			shape: "rsquare"
			description: [
				"&3&l[Head Chef Charlie] : &r&3A lovely, if brittle, knife! A useful tool on the farm and in the kitchen. Especially if you have youself a Cutting Board!"
				""
				"&2&l[Master Gardener Gray] : &r&2Brittle, perhaps, but razor sharp, Gardener Gray. But that Cutting Board is quite useful, I agree."
				""
				"&3&l[Head Chef Charlie] : &r&3It lets you slice some meats, cut produce and obtain seeds, and more. And it's quite simple to use. Just place it down, then Right Click something like...say a freshly caught Cod onto it."
				""
				"&3&l[Head Chef Charlie] : &r&3Then Right Click your Knife onto it to chop!"
				""
				"&4&l[Barista Bae] : &r&4Oh don't forget, it doesn't have to be a knife, at least in the FOPGame Server. A lot of tools work: axes, swords..."
				""
				"&2&l[Master Gardener Gray] : &r&2Is... that an Easel? For painting?!"
			]
			dependencies: ["5CA74EEBA6856C9B"]
			id: "3D8068D3592BCEFB"
