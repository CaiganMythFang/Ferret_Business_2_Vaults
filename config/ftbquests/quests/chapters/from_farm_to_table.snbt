				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Special Fertilizers"
			x: -9.25d
			y: 5.25d
			shape: "rsquare"
			description: [
				"&2&l[Master Gardener Gray] : &r&2One of the important things from real farming that the FOPGame Server has is... sometimes, the choice of soil can help your crops, Bandit."
				""
				"&2&l[Master Gardener Gray] : &r&2Take these three Fertilizers. Each one improves some aspect of farming, be it more crop yield, or faster growth."
				""
				"&4&l[Barista Bae] : &r&4Is... the speed one really red?"
				""
				"&3&l[Head Chef Charlie] : &r&3Of course it is. Red, as they say, goes faster. Or something."
			]
			dependencies: ["7D7C157DFC1B8A40"]
