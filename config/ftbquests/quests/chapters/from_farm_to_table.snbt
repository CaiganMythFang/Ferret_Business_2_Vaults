				}
			]
			rewards: [{
				id: "0673604D517AE464"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "A Stocked Storage"
			x: -6.75d
			y: 4.0d
			shape: "rsquare"
			description: [
				"&3&l[Head Chef Charlie] : &r&3When you've got a lot of ingredients, there's always the question about how to store em. "
				""
				"&2&l[Master Gardener Gray] : &r&2A good start's a Basket, I say. You can set it down, then toss stuff into the opening and it'll catch em. Good for partially automated farming too. "
				""
				"&4&l[Barista Bae] : &r&4Or Pantries! Kinda like cupboards. We tend to store extra supplies in the shop in them."
				""
				"&2&l[Master Gardener Gray] : &r&2Ah, don't forget you can bundle together various ingredients, much like you can Ingots. Potatoes and Straw are good examples."
			]
			dependencies: ["5CA74EEBA6856C9B"]
			id: "0FF9B044F0E6ACDE"
