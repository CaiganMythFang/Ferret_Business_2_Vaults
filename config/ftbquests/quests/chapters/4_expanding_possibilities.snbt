				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Charting the Limit"
			x: 1.0d
			y: -0.75d
			shape: "rsquare"
			subtitle: "Shape of : A Vault!"
			description: [
				"&dBandit, keep your eye out for a fairly rare piece of loot called an Etched Vault Layout. These are a disabled item that I re-enabled for you."
				""
				"&5Ye can take the Etched Vault Layout, and combine it with a Vault Crystal in an Anvil to set the layout of the Vault."
				""
				"&dWhich is how the rooms are laid out. Usually you find vaults as either Diamonds, Circles, or Squares."
				""
				"&5But there is special layouts. One is used for Cake Vaults. Another makes an endless Vault."
				""
				"&dThat last one isn't as useful unless you got a party of Assistants and ya'll chow down on tons of Vault Fruit."
			]
			hide_dependency_lines: true
			dependencies: ["59965C1CF354E4CE"]
