		{
			title: "Sealed For Freshness"
			icon: "the_vault:vorpal_focus"
			x: 2.75d
			y: -0.75d
			shape: "rsquare"
			subtitle: "Locking In Perfection"
			description: [
				"&5Bandit, have ye found the perfect piece of gear?"
				""
				"&dWant a chance to make it even better, Bandit?"
				""
				"&5Then ye'll want to take a gander at the Gear Sealer. Take yer piece of Gear, place it into the Gear Sealer, add some Ascendant Marks, Gold, and Painite, and hit the button."
				""
				"&dWhen you seal a piece of gear, it will lock all stats on it, as well as the transmog, preventing you from changing them."
				""
				"&5It will also either add, or replace, one of the modifiers with a special modifier. The pool of modifiers includes + skill modifiers, as well as unique affixes."
				""
				"&dSealing gear will not replace Frozen modifiers, however."
			]
			hide_dependency_lines: true
