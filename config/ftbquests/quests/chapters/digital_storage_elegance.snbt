		{
			title: "Detection"
			x: 6.25d
			y: 3.0d
			shape: "rsquare"
			description: [
				"&6The Detector is a device you can add to your network that emits a Redstone Signal when certain criteria are met. You can configure whether its looking for a specific item, and if it needs to have more, less, or equal to specific amounts."
				""
				"&6Though if you have it in Fluid mode, it will look for more precise amounts: in miliBuckets (mB) instead of full buckets! One bucket of liquid is 1,000 mB, so keep that in mind!"
			]
			dependencies: ["5AE5D722CB037119"]
			id: "705897FD5DAF4B60"
			tasks: [{
				id: "05352A8612DC474F"
				type: "item"
				item: "refinedstorage:detector"
			}]
			rewards: [{
				id: "04916FE3AC37B10D"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "A Refined Kitchen"
			x: 2.5d
			y: 6.0d
			shape: "rsquare"
			description: [
				"&6A bit of interesting cross-brand devices, Bandit. You can connect your Refined Storage system to your Cooking for Blockheads kitchen!"
				""
				"&6To start, you'll need to place a Kitchen Station in your Kitchen setup. Then a Kitchen Access Point in your Refined Storage network."
				""
				"&6Now take a Kitchen Network Card and Right Clicked onto the Kitchen Station, then placed into the Kitchen Access Point."
				""
				"&6Once that is done, your Kitchen will now be able to pull items from your Refined Storage system!"
			]
			dependencies: ["44263DCA4493364E"]
			id: "00666028C4F3351D"
			tasks: [
				{
					id: "1AA3B3BB8322888E"
