{
	id: "251DCDC885CD7B19"
	group: "499A93482811AC21"
	order_index: 6
	filename: "digital_storage_elegance"
	title: "Digital Storage Elegance"
	subtitle: [
		"MOD : Refined Storage"
		"MODS : Refined Cooking, Requestify"
		"MOD : Refined Storage Additions"
	]
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			title: "A Date with Data"
			x: 0.0d
			y: 0.0d
			shape: "square"
			subtitle: "MOD : Refined Storage"
			description: [
				"&6Well well, if it isn't Bandit again! Welcome! My name is Dataologist Dante. Don't know if you remember me, my friend Linguist Larry and I worked with you to research Applied Energistics before."
				""
				"&6The FOPGame Server doesn't seem to have stolen...I mean 'adopted'... that technology into their game yet. But they DO have a digital storage system in place called Refined Storage."
				""
				"&6In many ways it is similar, and other ways it is quite different. Shall we get started, Bandit?"
			]
			dependencies: ["1D0853ADC7295AEB"]
			id: "4B84C5D84D35A08B"
			tasks: [{
				id: "594A3EAB4B9DB78E"
				type: "checkmark"
			}]
		}
		{
			title: "First Steps"
			x: 0.0d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&6To get started with Refined Storage, you'll need a Contoller. This is like the heart of the Refined Storage system, it transfers data and power to the whole network."
				""
				"&6But to make the Controller, first you'll need to create the universe. Or, well, you'll need to stop into the Nether for some materials. Mostly, a whole lot of Nether Quartz."
				""
				"&6You'll need to make Quartz Enriched Iron for a Machine Casing, as well as an Advanced Processor."
				""
				"&6Oh, you'll also need to power the Controller. You'll have to unlock another DLC for that, or be lucky with your looting. I suggest either, hmm let me look at the list..."
				""
				"&6Ah, Power Up, Red or Orange Rank are all about power generation. Thermally and Travel in Style both have some power generation options as well."
			]
			dependencies: ["4B84C5D84D35A08B"]
			id: "68B018D34A6EDD15"
			tasks: [{
				id: "0884DCB69117A8DB"
				type: "item"
				title: "Any Refined Storage Controller"
				item: {
					id: "itemfilters:tag"
					Count: 1b
					tag: {
						value: "refinedstorage:controller"
					}
				}
			}]
			rewards: [{
				id: "29EA71CA970A6D82"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Where to Store It"
			x: 0.0d
			y: 3.0d
			shape: "rsquare"
			description: [
				"&6Now that you have the control center for a Refined Storage system, you need some data storage for all those items you want to put into the system."
				""
				"&6A good, expandable starting setup uses a Disk Drive. You can insert up to 8 Storage Disks into them, like the 1k Storage Disk."
				""
				"&6The 1k Storage Disk stores, you guessed it, One Thousand items!"
				""
				"&6Now, to hook up the Disk Drive to the Controller, you can just set it down so it's touching, or you can use a Cable."
			]
			dependencies: ["68B018D34A6EDD15"]
			id: "5AE5D722CB037119"
			tasks: [
				{
					id: "6C3CED2834DBC68B"
					type: "item"
					item: "refinedstorage:disk_drive"
				}
				{
					id: "2956F70CB699E2FC"
					type: "item"
					item: "refinedstorage:1k_storage_disk"
				}
				{
					id: "07B8D34A31BDE48E"
					type: "item"
					item: "refinedstorage:cable"
				}
			]
			rewards: [{
				id: "672E687B9BA0F4C8"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Access Terminals"
			x: 0.0d
			y: 4.5d
			shape: "rsquare"
			description: [
				"&6Now that you have the controller to direct the data, and the storage to hold the data, how do you access the data? Your items, I mean. "
				""
				"&6To interact with the data, you'll need a Grid. The basic Grid lets you put items in and take them out. You can also search through your items and sort them in different ways."
				""
				"&6For more functionality, though, you can use a Crafting Grid. It's just like a normal Grid, but you can craft with it too!"
			]
			dependencies: ["5AE5D722CB037119"]
			id: "70B567D96DD4C0ED"
			tasks: [
				{
					id: "72324BBCE997CE63"
					type: "item"
					title: "Any Refined Storage Basic Grid"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:grid"
						}
					}
				}
				{
					id: "059D0C0DDFAF30D0"
					type: "item"
					title: "Any Refined Storage Crafting Grid"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:crafting_grid"
						}
					}
				}
			]
			rewards: [{
				id: "6E863F41474AB4FB"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Simple Tool"
			x: 1.25d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&6Now, you'll find sometimes you want to rotate around these machines. And well, it's simple. You just use a Wrench like this one. Or one of the dozens the FOPGame Server features. There's a lot of very similar or just outright reduntant things in the FOPGame Server."
				""
				"&6Now, if you already haven't asked... if this is all digitized data in the first place, what IS being stored? Well..."
				""
				"&6...data. Just in a different way. It's basically just a convenient way to sell another piece of DLC for something different and 'questionably' more effecient."
			]
			dependencies: ["68B018D34A6EDD15"]
			id: "6A769DA1A88E297E"
			tasks: [{
				id: "607F04B08239A736"
				type: "item"
				item: "refinedstorage:wrench"
			}]
			rewards: [{
				id: "5ED27482C81DE374"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Out and In"
			x: 0.0d
			y: 6.0d
			shape: "rsquare"
			description: [
				"&6Interacting with your stored data with a Grid is all well and good, but having to hit a Grid just to deposit your items, or grab an item to put into something like a machine can get tedious, right? Enter the Importer and Exporter."
				""
				"&6When pointed at a chest or other inventory, the Importer will pull items into the data storage from it."
				""
				"&6The Exporter, when pointed at an inventory, will put items from your data storage into the inventory, but only if you configure it."
				""
				"&6Right Clicking either Importer or Exporter with an empty hand will let you configure it. The row of inventory slots in the center are Filters. Click items onto here that you want the Importer to either grab or ignore, depending on if you set the left hand option to Whitelist or Blacklist."
				""
				"&6The Exporter can only export items you set in it's filter, however."
			]
			dependencies: ["70B567D96DD4C0ED"]
			id: "44263DCA4493364E"
			tasks: [
				{
					id: "3BD9C1539CCBD1E2"
					type: "item"
					item: "refinedstorage:exporter"
				}
				{
					id: "4FF2C9A7A2CD3247"
					type: "item"
					item: "refinedstorage:importer"
				}
			]
			rewards: [{
				id: "38EFB87CB3F749E9"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Advanced Interfacing"
			x: 3.75d
			y: 6.0d
			shape: "rsquare"
			description: [
				"&6There's some advanced things you can use, sort of branching off of the Importer and Exporter, a combination of the two. It's called an Interface."
				""
				"&6Unlike the Importer or Exporter, the Interface has its own inventory, and can be configured to do do both Importing and Exporting of items."
				""
				"&6Though if you have some nice storage set up already, you can connect them to your network with an External Storage. Things inside the inventory will be counted and shown as part of your stored data. You can set up filters to Import or Export certain things as well."
			]
			dependencies: ["44263DCA4493364E"]
			id: "5EDB4F765E6D215B"
			tasks: [
				{
					id: "3F270EC455FF1837"
					type: "item"
					item: "refinedstorage:interface"
				}
				{
					id: "4D23E7C345389A0F"
					type: "item"
					item: "refinedstorage:external_storage"
				}
			]
			rewards: [{
				id: "3426121054F01D31"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Pretty Pattern"
			x: 0.0d
			y: 7.5d
			shape: "rsquare"
			description: [
				"&6Now the big stuff, Bandit. Turning your Refined Storage system into an automation system! At least, when it comes to crafting items!"
				""
				"&6To start auto-crafting items(when you request them), you'll need to start with a Pattern and a Pattern Grid. The Pattern Grid lets you set up crafting recipes to 'save' onto Patterns."
				""
				"&6The Pattern Grid has a few modes : If Exact Mode is on, it will use the recipe EXACTLY as you set it, with those specific items. Disable this if you want the pattern to use anything valid (such as using any Wood Planks for a Wood Hoe)."
				""
				"&6Pattern Mode is for using a machine or other block to craft. Just place the required ingredients into the left grid, then the output into the right grid."
				""
				"&6Oh! Patterns go to the right of the crafting area, above the arrow. Hit that to Create the Pattern!"
			]
			dependencies: ["44263DCA4493364E"]
			id: "6A4B16FB90025D10"
			tasks: [
				{
					id: "00F311A070152F4E"
					type: "item"
					item: "refinedstorage:pattern"
				}
				{
					id: "06AA3D02D2F53936"
					type: "item"
					title: "Any Color Pattern Grid"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:pattern_grid"
						}
					}
				}
			]
			rewards: [{
				id: "1121E41944816175"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "To Craft or Not To Craft"
			x: 1.25d
			y: 7.5d
			shape: "rsquare"
			description: [
				"&6Now that you have some prepared patterns, time to get them into your Refined Storage system. And to do that, you'll need a Crafter."
				""
				"&6For simple crafting Patterns, you just need to place the Pattern into the Crafter. You can increase the number of recipes you can have by adding more Crafters."
				""
				"&6Now when you open a Grid, you'll have the option of Crafting those items, using items stored in the system. If the recipe doesn't have all the ingredients, it will look for other Patterns that will make the components its missing!"
				""
				"&6If your Pattern is a Processing Pattern, you'll need to point the top of the Crafter at the appropriate machine (the side with a dot is the top!), as well as Import the item back into the system. NOTE: Many machines only accept items on specific sides. For example, the Furnace only accepts Items from the Top, and Fuel from the Sides."
			]
			dependencies: ["6A4B16FB90025D10"]
			id: "4FF72FBE2949E274"
			tasks: [{
				id: "7C329BB084BCB127"
				type: "item"
				title: "Any Color Refined Storage Crafter"
				item: {
					id: "itemfilters:tag"
					Count: 1b
					tag: {
						value: "refinedstorage:crafter"
					}
				}
			}]
			rewards: [{
				id: "7EE07230B2680A0D"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Crafty Plans"
			x: 2.5d
			y: 7.5d
			shape: "rsquare"
			description: [
				"&6A quick tip, as I'm sure you'll need lots of Crafters for how many things you can make in the FOPGame Server: You can rename your Crafter in an Anvil, and it will show up on your Refined Storage network with that name!"
				""
				"&6Which is helpful when you install a Crafter Manager. This lets you see all your connected Crafters and what patterns they hold."
				""
				"&6If you want to see the progress on your automated crafting, install a Crafting Monitor. It will show all your queued and ready patterns."
			]
			dependencies: ["4FF72FBE2949E274"]
			id: "74E1B6B09075A955"
			tasks: [
				{
					id: "3D0DB1806CAF5578"
					type: "item"
					title: "Any Color Crafting Monitor"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:crafting_monitor"
						}
					}
				}
				{
					id: "4BF1B9132485AB2E"
					type: "item"
					title: "Any Color Crafter Manager"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:crafter_manager"
						}
					}
				}
			]
			rewards: [{
				id: "21782AB44F691ED9"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Holding Your Drink"
			x: 2.5d
			y: 4.5d
			shape: "rsquare"
			description: [
				"&6Your Refined Storage network can hold more than just item data. With the right components, you can also store Fluids as... well, fluid data. "
				""
				"&6You'll need to add some Fluid Storage Disks first, as well as a Fluid Grid. Once you have both, you can insert liquid into the Fluid Grid (via buckets or other)."
				""
				"&6To take Fluid out, you'll need a Bucket or similar fluid storage item. Just Left Click the fluid in the Fluid Grid, and it'll auto fill the first appropriate container it finds."
				""
				"&6If the fluid doesn't fit into whatever containers you have, you'll have to use something else to extract the fluid."
			]
			dependencies: ["70B567D96DD4C0ED"]
			id: "719CA2564F0A01FA"
			tasks: [
				{
					id: "084A56815A9FEEC0"
					type: "item"
					title: "Any Color Fluid Grid"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:fluid_grid"
						}
					}
				}
				{
					id: "2032452242733558"
					type: "item"
					item: "refinedstorage:64k_fluid_storage_disk"
				}
			]
			rewards: [{
				id: "76539836542EA2E4"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Making Waves"
			x: 3.75d
			y: 4.5d
			shape: "rsquare"
			description: ["&6You can create a Fluid Interface to interact with your stored Fluids and external machines or tanks, much like an Interface does with stored items and external storage."]
			dependencies: [
				"719CA2564F0A01FA"
				"5EDB4F765E6D215B"
			]
			id: "51815750D5F95119"
			tasks: [{
				id: "052EA77BAD4F3E5E"
				type: "item"
				item: "refinedstorage:fluid_interface"
			}]
			rewards: [{
				id: "0F28861ADA83422D"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Disks? Blocked"
			x: 2.5d
			y: 3.0d
			shape: "rsquare"
			description: [
				"&6If you want a more... physical representation of your storage, you can craft Block versions of Storage Disks."
				""
				"&6Like other Refined Storage components, they need to be hooked up to your network."
				""
				"&6As well, breaking the Storage Blocks won't dump the items out, but will save them in the block."
				""
				"&6Storage Blocks also have an interface where you can filter what items go into it."
			]
			dependencies: [
				"5AE5D722CB037119"
				"719CA2564F0A01FA"
			]
			id: "0A578BB2258D3B46"
			tasks: [
				{
					id: "4E3DCE1E220C9C47"
					type: "item"
					item: "refinedstorage:1k_storage_block"
				}
				{
					id: "4492CE2E962ED81F"
					type: "item"
					item: "refinedstorage:64k_fluid_storage_block"
				}
			]
			rewards: [{
				id: "145813484E0CA839"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Keeping an Eye on It"
			x: 3.75d
			y: 3.0d
			shape: "rsquare"
			description: [
				"&6If you are wanting a visual way to see how many of an item you have in your Refined Storage system, you can use a Storage Monitor."
				""
				"&6Sneak + Right Click the Storage Monitor to open the interface. You can have it display an item or fluid by setting it into the slot. "
				""
				"&6You can grab a stack of an item, or a bucket of liquid, by simply Left Clicking the front of the Storage Monitor. You can also insert more of the shown item by Right Clicking it onto the Monitor."
			]
			dependencies: ["5AE5D722CB037119"]
			id: "079CAE53CACE132A"
			tasks: [{
				id: "03C2725836AEED1E"
				type: "item"
				item: "refinedstorage:storage_monitor"
			}]
			rewards: [{
				id: "0F7DE361D0FAEB84"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Visual Filtering"
			x: 1.25d
			y: 4.5d
			shape: "rsquare"
			description: [
				"&6If you want to control what items are shown on a specific Grid, you can use a Filter."
				""
				"&6Right Clicking the Filter into the air will open up the interface for it, letting you configure it. Then you can put it into the Grid interface in the upper right inventory slots."
			]
			dependencies: ["70B567D96DD4C0ED"]
			id: "3CC0925AB4F14CEF"
			tasks: [{
				id: "69BC29880EA3BD4E"
				type: "item"
				item: "refinedstorage:filter"
			}]
			rewards: [{
				id: "315E2FE4CEB9D00B"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Build and Destroy"
			x: 1.25d
			y: 6.0d
			shape: "rsquare"
			description: [
				"&6The Constructor and Destructor are a pair of devices you can use in some useful ways."
				""
				"&6The Constructor can be configured to either place a block, or drop an item, in front of it. As long as the space isn't blocked, and the block or item is able to be placed there (such as a sapling onto dirt)"
				""
				"&6The Destructor, its opposite, breaks blocks in front of it. It can be configured to instead pick up items dropped in front of it. You can also configure a Whitelist or Blacklist on what it can break."
			]
			dependencies: ["44263DCA4493364E"]
			id: "0B2EF60A3E9455B4"
			tasks: [
				{
					id: "73F01CC517FD0CA8"
					type: "item"
					item: "refinedstorage:constructor"
				}
				{
					id: "39F822B6D79D4907"
					type: "item"
					item: "refinedstorage:destructor"
				}
			]
			rewards: [{
				id: "44229F7BA512804F"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Security Clearance"
			x: 6.25d
			y: 4.5d
			shape: "rsquare"
			description: [
				"&6If you have a bunch of assistants or other Power Users around, you may want to add a security layer to your Refined Storage system."
				""
				"&6You'll need two things : A bunch of Security Cards, and a Security Manager."
				""
				"&6Connect the Security Manager to your network, and insert a new Security Card into it. You can then set the 'default permissions' for everyone without a Security Card. "
				""
				"&6To set up permissions for yourself, hold a new Security Card and Right Click it in the air. If you want to set permissions for someone else, have them do the same thing with a Security Card."
			]
			dependencies: ["70B567D96DD4C0ED"]
			id: "27B7402CFFBB8A86"
			tasks: [
				{
					id: "2CF1D5E3A9E7A5EE"
					type: "item"
					item: "refinedstorage:security_card"
				}
				{
					id: "19AF47D58A0EF319"
					type: "item"
					title: "Any Color Security Manager"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "refinedstorage:security_manager"
						}
					}
				}
			]
			rewards: [{
				id: "25A97E1EAA3EA665"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Shortest Distance"
			x: 2.5d
			y: 9.0d
			shape: "rsquare"
			description: [
				"&6Having a Refined Storage network at one base is good, but its expensive to set up in multiple bases, right? And they don't share inventories...."
				""
				"&6While its quite expensive, you could invest in a wireless network setup! You'll need a Network Card, a Network Transmitter, and a Network Receiver."
				""
				"&6First, place a Network Transmitter on your main Refined Storage network. Then make a Network Receiver, and place it in your other base. "
				""
				"&6Now take a Network Card and Right Click it onto the Receiver to record it's location. Then place the Network Card into the Transmitter back at your main base."
				""
				"&6Note that you should treat the Network Reciever like a Controller: IE, you can only have one."
			]
			dependencies: ["19F345E4D1C16509"]
			id: "17C35217FE2D4061"
			tasks: [
				{
					id: "7F09BF8286C5E0C9"
					type: "item"
					item: "refinedstorage:network_card"
				}
				{
					id: "372E33AF713CAF6B"
					type: "item"
					item: "refinedstorage:network_receiver"
				}
				{
					id: "44B37363F43C8292"
					type: "item"
					item: "refinedstorage:network_transmitter"
				}
			]
			rewards: [{
				id: "1F150547C92B1406"
				type: "choice"
				table_id: 2245246540467579945L
			}]
		}
		{
			title: "Toggle It"
			x: 1.25d
			y: 3.0d
			shape: "rsquare"
			description: [
				"&6The Relay is a useful block if you are trying to control how much Energy you use."
				""
				"&6It acts like a normal Cable, connecting to cables and machines, and transmitting data and power through it. But you can configure it to be on or off depending on the Redstone Signal. When it is off, it does not transmit data or energy through it."
			]
			dependencies: ["5AE5D722CB037119"]
			id: "41DDCEA76A8A36DC"
			tasks: [{
				id: "38D10DA03BD762CC"
				type: "item"
				item: "refinedstorage:relay"
			}]
			rewards: [{
				id: "5CFF201552A8FA08"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Refined Upgrades"
			x: 0.0d
			y: 10.25d
			shape: "rsquare"
			description: [
				"&6Many devices in Refined Storage can be Upgraded with these small devices. Mind, installing these will increase the amount of Energy the device uses. All of them start with an Upgrade base."
				""
				"&6Most devices can take a Speed Upgrade, which like it says, speeds up the device it is installed in."
				""
				"&6The Crafting Upgrade is used in an Interface, speeding up crafting of multistep items."
			]
			dependencies: ["44263DCA4493364E"]
			id: "149FB6ED0EC5424F"
			tasks: [
				{
					id: "1E05D596C90AD77F"
