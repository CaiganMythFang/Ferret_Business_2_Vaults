				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Stockpiles"
			x: 6.25d
			y: 10.25d
			shape: "rsquare"
			description: [
				"&6The Requester is a useful device if you have a good Autocrafting system set up as well. "
				""
				"&6You can configure how much of an item you want to keep Stockpiled in your Refined Storage system. If it is below the amount you list, the Requester will set up Autocrafting jobs till fill it out."
				""
				"&6Note that if you don't have the Crafting patterns and stuff installed for the items, nothing will happen."
			]
			dependencies: [
				"705897FD5DAF4B60"
				"149FB6ED0EC5424F"
