				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Enchanting Upgrades"
			x: 2.5d
			y: 10.25d
			shape: "rsquare"
			description: [
				"&6There are a couple of special upgrades for the Destructor : Silk Touch and Fortune."
				""
				"&6Both work just like the tool enchants : Silk Touch breaks the block as it is, instead of into other materials (Redstone Ore turns into Redstone Dust normally, for example)."
				""
				"&6And Fortune, there are three levels. Each one increases the chance of extra drops when it breaks a Block that breaks into pieces (Again, Redstone Ore into Redstone Dust for example)."
			]
			dependencies: ["149FB6ED0EC5424F"]
			id: "717A895C91A90336"
			tasks: [
				{
					id: "2258037B56D96CA6"
