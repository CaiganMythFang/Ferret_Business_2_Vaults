					item: "refinedstorage:crafting_upgrade"
				}
			]
			rewards: [{
				id: "594D552C0EA4EB13"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "No Wires"
			x: 0.0d
			y: 9.0d
			shape: "rsquare"
			description: [
				"&6If you're base is getting larger and you want to be able to access your Refined Storage system without having to run Cables and Grids everywhere, invest in a Wireless system."
				""
				"&6To start with, you'll need one or more Wireless Transmitters connected to your network. Each one has a 16 block range, so you may need to spread out multiple."
				""
				"&6Now you can use a Wireless Grid to access your network! It will require charging, which you'll need to charge with another DLC's machine or device."
			]
			dependencies: ["44263DCA4493364E"]
			id: "19F345E4D1C16509"
			tasks: [
				{
					id: "12108589F3B0FC81"
					type: "item"
					item: "refinedstorage:wireless_transmitter"
				}
				{
					id: "52FD907F724AE30D"
					type: "item"
					item: "refinedstorage:wireless_grid"
				}
			]
			rewards: [{
				id: "11D3CD453577D76A"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "More Upgrades"
			x: 1.25d
			y: 10.25d
			shape: "rsquare"
			description: [
				"&6There are plenty more upgrades you can add to your Refined Storage system!"
				""
				"&6The Range Upgrade is mostly used for your Wireless tools and devices. It increases the range, especially good for Wireless Transmitters."
				""
				"&6The Stack Upgrade is great for Importers, Exporters, Interfaces, and more. It changes it so instead of single items being moved around, it moves whole stacks."
				""
				"&6The Regulator Upgrade is for Exporters, and is used to keep a specific amount of select items stocked in that inventory. You can also combine this with a Crafting Upgrade in the Exporter to have it run Autocrafting tasks to keep the stock up."
			]
			dependencies: [
				"149FB6ED0EC5424F"
				"19F345E4D1C16509"
			]
			id: "764AD742BDEE3253"
			tasks: [
				{
					id: "7463D90D6A1399BA"
