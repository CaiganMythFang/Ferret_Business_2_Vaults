				table_id: 2640422954496342337L
			}]
		}
		{
			icon: "minecraft:gold_nugget"
			x: 3.75d
			y: 3.5d
			shape: "square"
			subtitle: "Rewarded For Doing"
			description: [
				"&dWow, looks like they added a mechanic that drops extra things the higher level you are in a skill."
				""
				"&5Like a Luck mechanic?"
				""
				"&dKind of. Except instead of hoping good gear you have also has Luck, or dumping points into Luck, you just level your Project MMO skills."
				""
				"&5Ah, there's the stick again. What do you get, what's the carrot?"
				""
				"&dNot much for a good while. The occasional nugget of Iron from Stone. Bones from Dirt. Apples from Leaves."
				""
				"&dLevel your skills enough though and you can find Enchanted Golden Apples from breaking Leaves!"
				""
				"&5...and the catch, sis?"
				""
				"&dWell, for the Enchanted Golden Apple, you gotta be level 50 to start for a 0.2% chance. Yes, 0.2, not 2%. That's only if you hit level 150. "
			]
			dependencies: ["4A7F919339917ED3"]
