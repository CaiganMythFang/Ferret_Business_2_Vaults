				table_id: 2640422954496342337L
			}]
		}
		{
			x: 5.5d
			y: 0.0d
			shape: "hexagon"
			subtitle: "Two Paths, One Goal"
			description: [
				"&dOkay, so infecting the items and Scrypto Coins is step 1. Step 2? Get them back into the system of course."
				""
				"&5You have a choice here, Bandit. You can sell items and trade Scrypto Coins back to FOP and purchase their AMAZINGLY priced DLC..."
				""
				"&dOr you can sell the items to us. We'll keep a portion of them, and send the rest back into their system. The Audubon Worm will very slowly spread without the FOP noticing."
				""
				"&5Take this TFB Shop Tablet. You can buy a resources from us, and learn how to sell to either us or the FOP."
				""
				"&dFOP Scrypto Coins are hard to earn, but we agree you should probably sell to both parties. Some things are easier to get Scrypto with, others Silver Coins. Either way, we get the Worm in their system."
				""
				"&dOkay, we're opening up the rest of the Q.U.E.S.T. sections to you, as well."
			]
			dependencies: ["65766106B865F4F9"]
			hide: true
			id: "14E05D152CF5C051"
			tasks: [{
				id: "7202B9F55F939F79"
