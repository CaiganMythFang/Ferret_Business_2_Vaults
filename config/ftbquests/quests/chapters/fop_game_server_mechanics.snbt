				item: "hardcorequesting:quest_book"
			}]
		}
		{
			title: "Twisting Worlds"
			icon: "decocraft:globe"
			x: 3.4285714285714306d
			y: 3.4464285714285765d
			shape: "gear"
			subtitle: "Worlds, Gamefied"
			description: [
				"&dSo we haven't quite explained what these Vaults are yet. It's kind of a doozy, I have to say."
				""
				"&5Well, I don't think its too hard to understand, sis. It's like that movie, uh... the one with The One and the computer program government agents..."
				""
				"&dThe Matrix"
				""
				"&5Yeah that one. Except the fake world the FOP created to control all the Power Users were real, they were just... digitized and rearranged into a game. So each Vault is actually small parts of an actual world they captured."
				""
				"&dSo you are saying all the loot..."
				""
				"&5Yeah, everything 'important' is made to look like a some kind of game loot. Precious metals and gems become Carbon and Vault Gems. Real Weapons become Vault Weapons. Money become Vault Coins."
				""
				"&dI don't know if thats a brilliant or wonky way to explain it..."
			]
			dependencies: ["78B5BCD7C6C45779"]
			size: 0.75d
			id: "2BBEFF6E9B2C2E8A"
			tasks: [{
				id: "097B79599A40CEB5"
				type: "checkmark"
			}]
		}
