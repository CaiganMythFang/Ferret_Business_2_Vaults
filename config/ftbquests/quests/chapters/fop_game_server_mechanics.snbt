				table_id: 2640422954496342337L
			}]
		}
		{
			title: "All The Ways to Chop Wood"
			x: -3.0d
			y: 2.25d
			shape: "square"
			description: [
				"&dSo, because the FOP added a new game layer with Project MMO, there are a few skills that are well... duplicates?"
				""
				"&5But at the same time, different?"
				""
				"&dTake Logging for example. This is the Advent of Ascension skill you train by chopping down trees, and which can get you bonus items the higher level they are."
				""
				"&5Then the Project MMO skill is... Woodcutting! Which also raises when you cut down trees. This, though, helps determine how far you can Veinmine logs. And also can give you bonus items the..... higher level it is...."
				""
				"&dAnd the extra items you can find are different between the two skills."
			]
			dependencies: ["14E05D152CF5C051"]
			id: "764D1D5E68CF8085"
