				id: "the_vault:vault_artifact"
				Count: 1b
				tag: {
					CustomModelData: 12
				}
			}
			x: 4.75d
			y: -5.25d
			shape: "pentagon"
			subtitle: "MOD: Vault Hunters"
			description: [
				"&5So this is the big one you'll have to deal with. The entire FOP Game Server is built around the Vault Hunters game."
				""
				"&dIt adds and changes so many things to a 'vanilla' game of Minecraft that the Game is based on."
				""
				"&5The Game Server is so expansive, it may as well BE the entirety of the FOP corporation at this point. They do all their manufacturing through it, base their advertising from it..."
				""
				"&dHell, even some of their CEOs and board of directors live IN the game."
				""
				"&5Right. For now, if you hit H on your Keyboard, you'll bring up your Vault Hunters GUI. You can access your stats and skills here, as well as the Quests they give you."
			]
			hide_dependency_lines: true
			dependencies: ["04D5AA9EB9007560"]
