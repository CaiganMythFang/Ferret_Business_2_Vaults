			}]
			rewards: [{
				id: "12ED88887188DAC6"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Loot Loot Loot Loot"
			icon: "supplementaries:sack"
			x: 11.25d
			y: 1.5d
			shape: "hexagon"
			subtitle: "Fight! Loot! Loot! Fight!"
			description: [
				"&dOkay, head on in, Bandit (if you haven't already, that is!). Every Vault is sectioned off into a grid of large Rooms, all connected with in each cardinal direction."
				""
				"&5Except the Portal Room! This room only has one entrance, and you'll want to remember where it is!"
				""
				"&dSome Objectives can only be completed if you exit out of the Portal here. Or, if you can't complete the Objective, you'll need to get out via this Portal to not 'fail' the Vault."
				""
				"&5For now, failing will only damage your equipment a little bit. After Level 19 though..."
				""
				"&dWe can cover that later. For now, you'll want to mark your path through the vault somehow. Ideas, brother?"
				""
				"&5Well...here, take these blocks. Mark the hallway entrance or exit with them. They should stand out nicely. Also, these special Unobtanium Blocks can be crafted into Ingots...then back into a block...but you get an extra Ingot. So if you keep repeating that..."
			]
			dependencies: ["1F2875BC889232AC"]
