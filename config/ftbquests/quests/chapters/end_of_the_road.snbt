		{
			title: "The Final Battle"
			x: 12.75d
			y: 0.0d
			shape: "diamond"
			description: [
				"&dCraexxeus is known as the Ancient of War. Of all the Board Members, he's survived the longest and won the most fights against Power Users... to the point where he got bored of accepting them."
				""
				"&5Craexxeus will start the fight up on his mount, firing projectiles at you. If he stops firing for a bit, he's probably charging up his Nuke shot. Careful!"
				""
				"&dKill his mount, and he'll take the battlefield himself in a second phase, known as Xxeus. He will constantly run, jump, and fly at you, endlessly attacking. "
				""
				"&5If you manage to take him down, he may give up one of his powerful weapons."
			]
			dependencies: ["1D6EC9E75250EA83"]
			id: "61FC27DC9F62D458"
			tasks: [{
				id: "230900BB2B13E35C"
				type: "item"
				item: "kubejs:boss_card_craexxeus"
			}]
