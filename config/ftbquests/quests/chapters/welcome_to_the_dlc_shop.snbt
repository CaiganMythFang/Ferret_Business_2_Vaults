		}
		{
			x: -3.5d
			y: -1.25d
			shape: "pentagon"
			subtitle: "Earned and Spent"
			description: [
				"&2The primary form of currency for the Game Server is called Vault Coins! "
				""
				"&2Every Vault Coin is actually a piece of cryptocurrency that the server tracks for your safety! How secure!"
				""
				"&2Vault Coins are only useable in the FOP Game Server! They are used for many things : buying Shop DLC, purchasing items in the Black Market, paying for gear rerolls, and for buying your body back if you die! And much more!"
				""
				"&2There are six tiers of Vault Coins - Copper, Silver, Gold, Platinum, Palladium, and Iridum! Each tier trades up to the next tier at a 9:1 ratio! So 9 Vault Copper turns into 1 Vault Silver!"
				""
				"&2Please take this Starter Wallet, a handy place to store ALL your money."
				""
				"&dYeah and when you die you lose it and have to buy it back to get the money. You know what, let me fix that... And bam... Soulbound!"
			]
			dependencies: ["6D986E5817BEF5A1"]
			hide: true
			id: "05F4CBBD146B0DBB"
