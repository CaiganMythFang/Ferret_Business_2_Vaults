	quests: [
		{
			x: -3.5d
			y: -1.75d
			shape: "pentagon"
			subtitle: "EXPLANATION OF PURCHASE BENEFITS"
			description: [
				"&2Welcome Power User. You've been granted access to the DLC shop!"
				""
				"&2We at the FOP believe that to obtain the highest sense of Pride and Accomplishment, as well as protect users new to the Game Server, that everything beyond basic components and systems are not available to new users. Instead, users must earn access!"
				""
				"&2As you can see, the Store DLC is organized into Ranks. As you progress in levels in Vault Hunters, you unlock higher ranks, and with them more items will become available to purchase in the Shop!"
				""
				"&2Infra Red, or Rank 0, has some very basic items available for you to purchase. As a reward for unlocking the DLC Shop, please accept this Iron Pickaxe! May you harvest much with it!"
			]
			dependencies: ["1B6761988ABBBC4A"]
			hide: true
			id: "6D986E5817BEF5A1"
			tasks: [{
				id: "63AA2C135C5C6B55"
				type: "checkmark"
				title: "Welcome to the DLC Shop!"
			}]
			rewards: [{
				id: "54E8FFD4389969BC"
				type: "item"
				item: {
					id: "minecraft:iron_pickaxe"
					Count: 1b
