	subtitle: ["Pirate DLC Shop"]
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			icon: {
				id: "fairylights:skull_light"
				Count: 1b
				tag: {
					color: 16383998
				}
			}
			x: 0.0d
			y: -1.75d
			shape: "pentagon"
			subtitle: "Yo ho ho ho!"
			description: [
				"&7Welcome welcome, Bandit. A good fitting name for what we're about to do."
				""
				"&7As the bosses introduced me, I'm ByteSize, or just Byte really. Computer mouse and second in command or whatever job title they gave me."
				""
				"&7Now, you know one way to get that shiny DLC the FOP offer, yeah? Do their tasks, fight their monsters, and send them expensive things for pennies. Or, well, pixels or... Digitized Items as they call them?"
				""
				"&7It's literally a bag of pixels...but I guess it fits! Digital items for a digital currency in a digital world that's just a digital prison for your digitized soul."
				""
				"&7So how about we sail the digital seas and pirate the lot of it, yeah?"
			]
			dependencies: ["14E05D152CF5C051"]
			id: "15363C5FC01E875C"
			tasks: [{
				id: "4A4AE474601F6684"
				type: "checkmark"
				title: "...a Pirate is Free!"
			}]
		}
		{
			title: "The Weak Point"
			icon: "architects_palette:cracked_coal_ore_bricks"
			x: 1.25d
			y: -1.75d
			shape: "pentagon"
			subtitle: "Where to aim the cannon"
			description: [
				"&7So such a large and complex system like the FOP Game Server, its gonna have some weak points. Little bugs, big bugs, bad coding decisions, all sorts of things can weaken a system."
				""
				"&7Especially if you cut corners, try to control too much, don't invest in your security and IT workers, and generally are just a bit dumb in your hiring process, you get BIG weak points."
				""
				"&7The FOP are good at 'reacting' to security breaches, I'll give them that. They closed up the obvious big changes Kowa hit them with early on. But they missed the smaller breaches where we hooked up a conveyor belt to their database."
				""
				"&7That kind of weakness we can exploit. I'll show you, grab a bunch of Glitched Blocks from the Vaults. "
			]
			dependencies: ["15363C5FC01E875C"]
			id: "2EADF7C8D0A49C89"
			tasks: [{
				id: "101AA159D38803FD"
				type: "item"
				title: "5 Glitched Blocks"
				item: {
					id: "itemfilters:tag"
					Count: 1b
					tag: {
						value: "tfb2:glitched_block"
					}
				}
				count: 5L
			}]
			rewards: [{
				id: "16082ACC88CDF7A4"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "A Crack in the Hull"
			icon: {
				id: "create:potato_cannon"
				Count: 1b
				tag: {
					Damage: 0
				}
			}
			x: 2.5d
			y: -1.75d
			shape: "pentagon"
			subtitle: "Shooting The Glowing Spot!"
			description: [
				"&7With so many systems, patches, updates, worlds, and heck even the presence of magic, it all makes nice little weak points we can exploit. But, how do we find them?"
				""
				"&7We need to find Glitches. We at The Ferret Business can use these to bypass the security surrounding their DLC packages. How you ask?"
				""
				"&7As mentioned before, when you are running Vaults, keep an eye out for blocks that are glitching out."
				""
				"&7As well, the bosses should have unlocked the ability to get Glitched items as well. If not, be sure to follow the \"Main Questline\" as well!"
				""
				"&7Be sure to collect all of these you can. "
			]
			dependencies: ["2EADF7C8D0A49C89"]
			id: "2723584BBFD0062D"
			tasks: [{
				id: "0C908F7053658C08"
				type: "checkmark"
			}]
			rewards: [{
				id: "376F5E556E56CE06"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Greasing the Wheels"
			icon: "minecraft:emerald"
			x: 3.75d
			y: -1.75d
			shape: "pentagon"
			subtitle: "Staff Mistreatment"
			description: [
				"&7See that Code Snippet you found?  Hold it and Right Click to have your Q.U.E.S.T. Tablet examine it. You'll find a kind of Vulnerability. I programmed the Tablet to make it a bit easier to understand... and to hide what it actually is."
				""
				"&7Yeah yeah I know, the images and tooltips are a bit silly. I wasn't sure what else to do, and they are kinda fun. "
				""
				"&7Start collecting those, we're going to need a whole lot over time. And the more you Salvage, the higher your skill, and the easier it'll be to find these Vulnerabilities."
				""
				"&7Another way to find them is to talk to Villagers and start trading with them. Some may eventually have a bit of 'special' stock for you: A vulnerability."
				""
				"&7Let's just say the FOP don't treat their staff, real or NPCs, very well."
			]
			dependencies: ["2723584BBFD0062D"]
			id: "4F1D548DFF6D2C28"
			tasks: [{
				id: "394B6C665D72CC1D"
				type: "item"
				item: "kubejs:vulnerability_card"
				count: 2L
			}]
			rewards: [{
				id: "3F864A5CBC525669"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "The Bigger They Are..."
			icon: "majruszs_difficulty:wither_treasure_bag"
			x: 5.0d
			y: -1.75d
			shape: "pentagon"
			subtitle: "...the more stuff they can carry!"
			description: [
				"&7Most any action or RPG game has its share of bosses, and the FOP Game Server is no different."
				""
				"&7They have their own versions of the Wither and Ender Dragon we know already, but it seems they have at least thirty, or more (we aren't sure) bosses besides those!"
				""
				"&7Lots of worlds to protect, I guess. But getting their stronger powers to play nice with the system layers has some issues. And if you defeat a boss, you should get a Code Snippet guaranteed."
			]
			dependencies: ["4F1D548DFF6D2C28"]
			id: "0F59DB9FD98F0E2E"
			tasks: [{
				id: "544E9A34FEC4BFE9"
				type: "item"
				item: "kubejs:vulnerability_card"
				count: 3L
			}]
			rewards: [{
				id: "3CB4AEAB58641C15"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Crime"
			x: 5.0d
			y: -0.5d
			shape: "pentagon"
			subtitle: "or How To Pirate For Blockheads"
			description: [
				"&7Okay, you know how to find these vulnerabilities. You've started collecting them. But how are we gonna use them to unlock DLC so we don't gotta pay that ridiculous price?"
				""
				"&7Well, thats a job for the researchers over here. Choose the DLC you want to unlock, send us the right number of Vulnerabilities, and voila, DLC!"
				""
				"&7Your job? Just to find the Vulnerabilities and keep pumping in that Audobon Worm. But I do have to warn you, Bandit..."
				""
				"&7The higher rank DLC is much more strongly protected, and thus will cost a lot more Tokens. It'll take a whole lot of Vulnerabilities to get around their security layers."
				""
				"&7Oh, right! No matter how you unlock the DLC, we should be able to make it purchasable again from the Shop Tablet. But for, you know, Silver Ferret Coins instead of Tokens or Scrypto."
			]
			dependencies: ["30F6D2F31395772F"]
			id: "29003EE631630364"
			tasks: [{
				id: "768CBB0461D508F1"
				type: "item"
				title: "Any 5 Vulnerability Tokens"
				item: {
