			}]
		}
		{
			title: "To Arm an Army"
			x: 0.5d
			y: -3.0d
			shape: "diamond"
			subtitle: "BOSS BRIBE"
			description: [
				"&5Placating both the army and the boss of Precasia is not going to be a simple task. Tyrosaur is old school, so a lot of what he wants and what his army uses are similarly 'old school'."
				""
				"&dThe simplest parts of the bribe are bones. Lots of bones. Regular and Fragments. And Ingots."
				""
				"&5Then you'll want a bunch of Buckets of Milk. Because they make strong bones. No vitamin supplements, thats new fangled stuff."
				"&dThen the simple bits of Iron Ingots and Diamonds for more equipment. And for buying equipment."
				""
				"&dAnd last, you want some Strength Potions, Healing Potions (for him), and Harm Potions (for the army)."
			]
			dependencies: ["7440103C453A765D"]
