	title: "Deep Green"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: -8.75d
			y: -1.25d
			shape: "hexagon"
			description: [
				"&dFrom here, Bandit, you have two dimensions you'll need to go. Both are fairly.... green in color."
				""
				"&5Both are also very dangerous, of course. You'll especially want to bolster your defence for these upcoming worlds."
			]
			dependencies: ["6CF74503417AAC2D"]
			id: "289B674FAC7C3441"
			tasks: [{
				id: "1BB12A803D2EE4E5"
				type: "checkmark"
				title: "Two Mean Greens"
			}]
		}
		{
			title: "The World of Creepers"
			x: -7.25d
			y: 1.5d
			shape: "diamond"
			description: [
				"&5Those explosive green plant creatures you've found both in your previous world, and this Game server... well, they have their own world here."
				""
				"&dWe've not really encountered them too many places. A couple dimensions here and there seem to have some variation of them."
				""
				"&5In one of them, they are pig shaped but still explode."
				""
				"&dThat place was... strange. But anyways, here the FOP have digitized an entire world of Creepers called Creeponia. "
				""
				"&5To gain access to it, you'll need to take a little risk, Bandit. Get yourself some normal, vanilla TNT, a Flint and Steel to set it off..."
				""
				"&dAnd some armor to survive a Creeper explosion. You need to ACTIVATE the TNT before a Creeper tries to blow you up. Survive, and you get the Creeponia Realmstone."
			]
			dependencies: ["289B674FAC7C3441"]
			id: "605F269244A3D7CD"
			tasks: [{
				id: "3118B2695B7BA164"
				type: "item"
				item: "aoa3:creeponia_realmstone"
			}]
			rewards: [{
				id: "52CBA54F71FE6F03"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Land of Green and Explosives"
			x: -5.25d
			y: 1.5d
			shape: "pentagon"
			description: [
				"&5Keep your eyes peeled in Creeponia, Bandit. Creepers are well suited to their home world, blending in quite well."
				""
				"&dNot every Creeper is dangerous, but they are much rarer than the more... hostile kind. "
				""
				"&5Thankfully this world has a much more normal night and day cycle than a lot of the worlds you've jumped to so far. Eternal day or eternal night is less interesting after a while."
				""
				"&dThe world itself is also pretty normal. It has an surface world, then underground caves and tunnels. Go deep enough, and the stone changes a few times, and you can find different Ores and creatures."
			]
			dependencies: ["605F269244A3D7CD"]
			id: "61774348D74453BD"
			tasks: [{
				id: "289AEF3F2B6D5ECF"
				type: "dimension"
				dimension: "aoa3:creeponia"
			}]
			rewards: [{
				id: "6BEE4C946E643AAA"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Creeped Resources"
			x: -3.5d
			y: 1.5d
			shape: "hexagon"
			description: [
				"&dWhile the topside is pretty lively in Creeponia, you'll want to focus on the underground pretty early."
				""
				"&5The first layer of stone is Creep Stone. Not much to find here, except the occasional Creep Crystal. It's found in all layers underground, not a lot of uses for it other than as a nice light source."
				""
				"&dBelow that is Pressed Creep Stone. You'll find Gemenyte and Jewelyte Ores here, as well as more Creep Crystals."
				""
				"&5The lowest layer, well, that isn't that strange Dimensional Fabric stuff, is Primed Stone. The third ore, Ornamyte, is down here."
			]
			dependencies: ["61774348D74453BD"]
			id: "148B2FCB551EF53B"
			tasks: [
				{
					id: "1518C103EC57FF00"
