	quests: [
		{
			icon: {
				id: "botania:cosmetic_questgiver_mark"
				Count: 1b
				tag: { }
			}
			x: -0.5d
			y: -4.0d
			shape: "pentagon"
			subtitle: "Second Verse, Same as the First"
			description: [
				"&5Bandit? Bandit! Can you hear me? Or, well, really, read me, but that is beside the point!"
				" "
				"&5Phew, still with us. Had me worried! Who am I?"
				""
				"&5I'm Caigan, the co-owner of The Ferret Business, remember? Well, I'll catch you back up to speed later, there's more important things..."
				""
				"&5When you used the Sword of the Cosmos to return home, you..."
				""
				"&5You don't remember that, you say?"
				""
				"&5Okay, this is going to take a small bit to explain. Make sure you are somewhere safe for a few moments, yeah?"
				""
				"&5Preferably get yourself a seat too, it could be a lot to take in if you really don't remember anything..."
			]
			id: "5DD803E2DB661B66"
			tasks: [{
				id: "37A8CF4751CBD764"
				type: "checkmark"
				title: "Here We Go Again..."
			}]
		}
		{
			x: 1.0d
			y: -4.0d
			shape: "pentagon"
			description: [
				"&5So, some time ago, you were a new intern at The Ferret Business. And unfortunately, a research lab accident sent you into another world..."
				""
				"&5We found something was blocking us from getting you back. A cosmic force or an act of gods, we don't know, but you and us worked together to research new technologies."
				""
				"&5Eventually, together, we found something that could get you past the barriers between our dimensions: The Sword of the Cosmos. You created the legendary weapon with your own paws."
				""
				"&5The Sword would put you in suspended animation as you travelled through space and dimensions, and we estimated it would take a week or so to get home."
				""
				"&5When you didn't arrive, we were concerned. But we were still tracking your Q.U.E.S.T. Tablet signal... suddenly it vanished. We learned that you had been... intercepted."
				""
				""
			]
			dependencies: ["5DD803E2DB661B66"]
			hide: true
			id: "19DD5DBBECEACA48"
			tasks: [{
				id: "351909F1249A7B6C"
				type: "checkmark"
				title: "Travels Interrupted"
			}]
		}
		{
			x: 2.5d
			y: -4.0d
			shape: "pentagon"
			description: [
				"&5We've spent the last month trying to track you down. And lo and behold, here you are! We found you!"
				""
				"&5But that is where the good news ends, I'm afraid. We also found out who intercepted you, and how. "
				""
				"&5You've probably noticed by now the world your in is very.... well, different than both our world and the one you escaped. You have levels, stats, skills; things are locked down, advertisements, microtransactions galore...."
				""
				"&5I'll put it simply : You've been captured by our rival corporation and placed into their massive 'game world'. They are known as FOP."
				""
				"&5The Feathers of Parliament."
			]
			dependencies: ["19DD5DBBECEACA48"]
			hide: true
			id: "5136BFD11A07D7D0"
			tasks: [{
				id: "13656E047D8BD2BB"
				type: "checkmark"
				title: "Trapped"
			}]
		}
		{
			x: 4.0d
			y: -4.0d
			shape: "pentagon"
			subtitle: "....Right?"
			description: [
				"&5When I say Game World, you probably think you are safe. You can't die permanently, just like the world you broke free from."
				""
				"&5But this is a bit more insideous. The FOP digitize entire planets and put them into their game world. And by gamefying everything, trapping Users in an endless loop of gathering resources and money to buy microtransactions, so they can earn more money to buy more..."
				""
				"&5You not only drain a world of every last valuable resource, you also get the world itself to manufacture every product you sell at the same time. Why bother doing it  yourself, if you get the prisoner to do everything?"
				""
				"&5This is, unfortunately, the game that you are now trapped in."
			]
			dependencies: ["5136BFD11A07D7D0"]
			hide: true
			id: "1C67908469019A64"
			tasks: [{
				id: "6690DF0C44971A38"
				type: "checkmark"
				title: "It's Just a Game!"
			}]
		}
		{
			x: 5.5d
			y: -4.0d
			shape: "pentagon"
			subtitle: "What do they want?!"
			description: [
				"&5We figure they discovered you had the fabled Sword of the Cosmos, and wanted it for themselves."
				""
				"&5So they digitized you, in the hopes that you would have the Sword and they could just take it. But, well... you don't have it. Nor do they, or we'd all be in much more trouble."
				""
				"&5The Sword of the Cosmos is... well, its much more than a sword. It probably couldn't stop you from being digitized, so it instead vanished. "
				""
				"&5But knowing The FOP, as I do, just the fact that you forged the Sword of the Cosmos is enough for them to imprison you and drain you of everything they can."
			]
			dependencies: ["1C67908469019A64"]
			hide: true
			id: "0931055624F2533A"
			tasks: [{
				id: "691760055BA77617"
				type: "checkmark"
				title: "Reasons and Suspicions"
			}]
		}
		{
			x: 2.5d
			y: -2.5d
			shape: "hexagon"
			subtitle: "A Mistake Was Made... But Not For You!"
			description: [
				"&5Okay, I was talking to some of my researchers, and we all agree. Not all is lost."
				""
				"&5In fact, the FOP made a grave mistake. They digitized you completely: body mind and soul. Then they put you into their Game Server."
				""
				"&5You, who have touched the power of the Gods, fought and defeated some of them, and forged the Sword of the Cosmos in your journey home."
				""
				"&5You, Bandit, who also holds a link to the outside world : Your Q.U.E.S.T. Tablet. And thus, a link to us."
				""
				"&5So, Bandit. Shall we work together again, to not only get you home, but also to teach the FOP a lesson?"
			]
			dependencies: ["0931055624F2533A"]
			hide: true
			id: "25604555CD6C8A65"
			tasks: [{
				id: "54A4B3622DC5D393"
				type: "checkmark"
				title: "Problem, or Solution?"
			}]
		}
		{
			icon: "aoa3:mecha_gear"
