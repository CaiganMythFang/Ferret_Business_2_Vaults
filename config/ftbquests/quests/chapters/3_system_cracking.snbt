				type: "choice"
				exclude_from_claim_all: true
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Baubles n' Trinkets"
			x: -4.75d
			y: 1.25d
			shape: "rsquare"
			subtitle: "Accessorize with Power"
			description: [
				"&dA new piece of equipment that'll start showing up, albeit very rarely, is Vault Trinkets"
				""
				"&5Sorta like magic rings or amulets, Bandit. They give some sort of bonus or power in the Vaults when worn."
				""
				"&dThey are sorted into two colors : Blue and Red. You can only equip one trinket of each color."
				""
				"&5And note they have limited uses, Bandit. Each time you enter a Vault with one, it consumes a use."
				""
				"&dThough many of them are useful outside of the vault too. That double jump one for example, or the wall climbing one."
				""
				"&5Here ye go, we snuck an extra one out for ye. A test, but also a reward."
			]
			hide_dependency_lines: true
			dependencies: ["2EC8B80AE1A271D5"]
			id: "59D6A7EF6A2A5123"
