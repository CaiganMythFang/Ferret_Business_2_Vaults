		{
			title: "Voiding Possibilities"
			x: -3.25d
			y: -3.0d
			shape: "rsquare"
			subtitle: "Just Say No"
			description: [
				"&dBandit, by Researching Junk Management, you gain access to a helpful tool to keeping your backpacks and inventory clear of extra blocks, especially if you use a hammer : The Void Crucible."
				""
				"&5Aye, it lets you choose which blocks to void or keep when you have ye magnet in Pickup + Void mode."
				""
				"&dBlocks voided this way won't take durability from your Magnet. Or shouldn't, at least."
				""
				"&5In the Void Crucible interface, in the top tab, ye can look through the different themes and select blocks to blacklist and disable voiding on."
				""
				"&dThe bottom tab will show you all the items you have blacklisted, and you can click to remove them."
				""
				"&l&4(RESEARCH REQUIRED)"
			]
