		{
			title: "Potion Seller!"
			x: -9.25d
			y: 2.5d
			shape: "rsquare"
			subtitle: "Give Me Your Strongest Potions"
			description: [
				"&dIn the larger Dungeons in Vaults, you have a chance of finding an Alchemy Archive."
				""
				"&5Using one gives you the choice between three new modifiers you can put on your Vault Potions."
				""
				"&dThese are usually fairly powerful, which is why the FOP put them into the Dungeons to find. As another incentive, of course."
			]
			hide_dependency_lines: true
			dependencies: ["0E520C1ADD9E71DF"]
