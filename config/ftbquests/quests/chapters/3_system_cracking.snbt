			}]
		}
		{
			title: "A Filter of the Void"
			x: -2.25d
			y: -3.0d
			shape: "rsquare"
			subtitle: "More Void Power"
			description: [
				"&dThe issue with the Void Crucible and Voiding pickup mode, as they are, is that they void all non-Vault blocks, and the blacklist function has a max of 54 blocks to save from Voiding."
				""
				"&5Which is an issue as, especially in the FOP Game Server, there are LOTS of great blocks ye might want to keep to ship out to us, or use in yer own builds."
				""
				"&dEnter the Filter Necklace! Using the power of Create's Filter and Attribute Filter, you can instead be more selective on what you want to Void."
				""
				"&5Hold the Filter Necklace and Right Click with it to open it up, and ye can fit plenty of Filters or Attribute Filters in."
				""
				"&dWhen worn, the Filter Necklace will only void blocks that match the settings in any filters you have inside it."
				""
				"&4&lThe Filter Necklace unlocks with the Void Crucible research!"
			]
			hide_dependency_lines: true
			dependencies: ["6CA424DD23A91F38"]
			hide: true
			id: "71C0F8F2A9785A59"
			tasks: [{
