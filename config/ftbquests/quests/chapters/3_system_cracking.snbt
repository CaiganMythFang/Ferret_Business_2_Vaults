				table_id: 2640422954496342337L
			}]
		}
		{
			title: "My Little Modification"
			x: -4.25d
			y: -2.75d
			shape: "rsquare"
			subtitle: "I Asked For This"
			description: [
				"&dThe Modification Table is a useful thing to make early, Bandit, as it lets you add a Prefix or Suffix of your choice to a piece of gear"
				""
				"&5The gear has to have a slot free, and ye need to have the modifier unlocked to apply it."
				""
				"&dThere's a couple ways to unlock modifiers, Bandit, we'll go over those shortly. But do note that applying or removing a modifier has a cost."
				""
				"&5Aye, usually some Vault Gold and materials. Ye can only add one Modifier, and remove said modifier. It'll be marked with a pickaxe in the gear stats, so ye know what you've added can can remove."
			]
			hide_dependency_lines: true
			dependencies: ["2EC8B80AE1A271D5"]
			id: "62B48188693E8FF5"
			tasks: [{
				id: "6B269DE4268F4E03"
				type: "item"
				item: "the_vault:modifier_workbench"
			}]
			rewards: [{
				id: "1637495099117BD3"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Potion Seller!"
			x: -9.25d
			y: 2.25d
			shape: "rsquare"
			subtitle: "Give Me Your Strongest Potions"
			description: [
				"&dIn the larger Dungeons in Vaults, you have a chance of finding an Alchemy Archive."
				""
				"&5Using one gives you the choice between three new modifiers you can put on your Vault Potions."
				""
				"&dThese are usually fairly powerful, which is why the FOP put them into the Dungeons to find. As another incentive, of course."
			]
			hide_dependency_lines: true
			dependencies: ["0E520C1ADD9E71DF"]
			id: "13F372A316D67ABA"
			tasks: [{
				id: "21817CFEE523A409"
