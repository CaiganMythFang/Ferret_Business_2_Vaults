				table_id: 2640422954496342337L
			}]
		}
		{
			title: "The \"True\" Hunt"
			x: -6.75d
			y: 0.25d
			shape: "pentagon"
			subtitle: "Artifacts 5 by 5"
			description: [
				"&dNow that you are level 20, Bandit, you'll start finding Unidentified Artifacts in your Completion Crates."
				""
				"&5They'll also occasionally show up in the Black Market. And maybe the Bounty table, I've not seen that myself though."
				""
				"&dEither way, the FOP give Users and Power Users a way to 'win' : Collect all 25 Artifacts, complete the 'tapestry', and defeat the final boss."
				""
				"&5The Herald is it's name, apparently. It's the avatar of the CEO of FOP."
				""
				"&dFor Power Users, the FOP tell them this is their only way to freedom. But there's a bit of a catch, Bandit."
				""
				"&5You will never obtain all 25 artifacts. The game is rigged from the start."
				""
				"&dBut heck to that. We have a while before we can truely start modifying things around the artifacts, its a fairly controlled system. But not invincible."
			]
			dependencies: ["1881243BF68F0FAC"]
			id: "2EC8B80AE1A271D5"
			tasks: [{
				id: "0E348B08B753AA85"
				type: "item"
				item: "the_vault:artifact_projector_block"
			}]
			rewards: [{
				id: "57FE043DE4C905F7"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Inscribing a Path"
			icon: "the_vault:vault_catalyst_infused"
			x: -6.25d
			y: 2.25d
			shape: "rsquare"
			subtitle: "Determined Destiny"
			description: [
				"&dBandit, it seems at around level 24 you'll start finding Catalyst fragments in Gilded Chests."
				""
				"&524? What an odd level..."
				""
				"&dRight? Bandit, Catalyst fragments can be combined, and then brought into a Catalyst Infusion Table and turned into something useful."
				""
				"&5Infused Catalysts can be applied to your Vault Crystal (in the Crystal Workbench, of course), and can increase the amount of chests you get, or coins, or other useful things."
				""
				"&dOh, the notes here say you can only find them in unmodified Vaults. Apparently now that means 'any vault with 2 or less Catalysts applied to it'."
				""
				"&5I guess that's good to know. Oh! Almost forgot to tell him, sis. We've snuck in a new kind of 'blind' box into the FOP loot pools : The Catalyst Box. Obvious what is in it, of course."
			]
			hide_dependency_lines: true
			dependencies: ["2EC8B80AE1A271D5"]
			id: "46082D6F0590EDD4"
			tasks: [
				{
					id: "3ECECEB3891A0EE3"
					type: "item"
					item: "the_vault:catalyst_infusion_table"
				}
				{
					id: "40B665B067EE0A96"
					type: "item"
					item: "the_vault:vault_catalyst_fragment"
				}
			]
			rewards: [
				{
					id: "2DC40071E3BCF9F5"
					type: "choice"
					table_id: 5632731352558517809L
				}
				{
					id: "2D49A7C4C483B355"
					type: "item"
					item: "woldsvaults:catalyst_box"
				}
			]
		}
		{
			title: "A Jump to 40"
			x: -4.75d
			y: 0.25d
			shape: "hexagon"
			subtitle: "The Eyes of the Gods"
			description: [
				"&dAlright Bandit, not much else unlocks for you in the Vaults until you hit 40."
				""
				"&5It may be tempting to eat a bunch of Vault Burgers, yeh? I recommend resisting, Bandit, level 50 is when things start ta slow down even more."
				""
				"&dPlus it's a good idea to gather as much Vault Resources as you can, and get some mods 'researched' and started up"
				""
				"&5Yep yep. Okay, so what DOES open up?"
				""
				"&dAh, now you'll start finding God Altars in the Vaults. You've probably seen these already : they look like giant moai statue heads. Now these will have an Altar to one of the four Vault Gods."
				""
				"&5Ah, I remember these! Ye see, Bandit, ye can activate one of these Altars to get a timed challenge from that 'Vault God'. If ye complete it, ye get a reward! If not, punishment..."
			]
			dependencies: ["2EC8B80AE1A271D5"]
			id: "1799D40CDE8D8F82"
			tasks: [{
				id: "7106D78AD137F801"
				type: "observation"
				title: "Find a God Altar"
				icon: {
					id: "the_vault:god_altar"
					Count: 1b
					tag: {
						god: "idona"
					}
				}
				timer: 0L
				observe_type: 0
				to_observe: "the_vault:god_altar"
			}]
			rewards: [{
				id: "669278B6EBCFFB14"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Warding Your Inventory"
			x: -6.75d
			y: -0.75d
			shape: "rsquare"
			subtitle: "KeepInventory=true"
			description: [
				"&dWith death changing at level 20, you might be feeling a bit under geared, or unprepared, or just don't want to deal with losing your inventory, you can make a Warden's Vault Rock."
				""
				"&5Ye place these on a Vault Altar like a normal Vault Rock, and pay the price for the crystal as usual. But the Vault Crystal ye get back will be marked with Afterlife."
				""
				"&dThe Afterlife modifier lets you keep your inventory if you die or fail the Vault, but in return you can't modify it further in a Crystal Workbench."
				""
				"&5Oh, be warned Bandit, it also halves the experience you get from the Vault. Slows down yer leveling a bit and gives ye time to upgrade yer gear."
			]
			hide_dependency_lines: true
			dependencies: ["2EC8B80AE1A271D5"]
			id: "4B2756DABC97E4C6"
			tasks: [{
				id: "4CC4C21A3F94DF6B"
				type: "item"
				item: "the_vault:wardens_pearl"
			}]
			rewards: [{
				id: "3F4B4417C63DCBAD"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Bigger Modifiers"
			x: -8.25d
			y: 2.25d
			shape: "rsquare"
			subtitle: "Make My Modifier Grow!"
			description: [
				"&dInside Dungeons in Vaults, you have a small chance of finding a Modifier Archive"
				""
				"&5The Magic Repair Dust is needed for each repair, as well as for making the table. You can find it in Treasure Boxes, from various monsters in every dimension, in loot chests all over, and many other places."
			]
			hide_dependency_lines: true
			dependencies: [
				"62B48188693E8FF5"
				"0E520C1ADD9E71DF"
