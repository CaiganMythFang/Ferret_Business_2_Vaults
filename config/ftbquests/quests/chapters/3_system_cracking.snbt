				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Good Crate"
			x: -11.25d
			y: 0.25d
			shape: "rsquare"
			subtitle: "For a Tough Battle"
			description: [
				"&dSo we'll eventually need some Tokens from these Scavenger Crates, Bandit, but for now they aren't required."
				""
				"&5Scavenger is the toughest for a solo User to complete. It's easier with some Assistants, but Power Users don't always have the luxury of other Power Users joining them."
				""
				"&dScav Crates tend to have the best loot chances in them. Brazier crates have the worst, relatively, because of how easy Brazier is to complete."
				""
				"&5Ya can just ignore most of the mobs in em. Don't get ya a lot of souls that way but..."
			]
			hide_dependency_lines: true
			dependencies: ["1881243BF68F0FAC"]
			id: "1AA95F28498D1C57"
			tasks: [{
				id: "590F16B5A7F2DCAB"
				type: "item"
				item: "the_vault:vault_crate_scavenger"
			}]
			rewards: [{
				id: "1AEF77A9FC59D468"
