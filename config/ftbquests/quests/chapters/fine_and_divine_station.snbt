	quests: [
		{
			title: "Dealing with the Divine"
			x: -0.5d
			y: 1.75d
			shape: "octagon"
			description: [
				"&7Well, the bosses tasked me with researching all the Divine Station combinations while they finish helping get you a way out of that game server."
				""
				"&7Lessee hmmm.... let me put out a few messages to some folks. Older Power Users who may have heard or discovered some of these themselves. I don't want to poke into the system itself, since you're so close to getting out. Don't wanna risk the FOP actually finding a way to stop the Aubudon Worm or you."
				""
				"&7--------------------"
				""
				"&7Okay Bandit, got a bunch of leads! Messages are still trickling in so I'll compile what I've found. You'll need Weapon Upgrade Kits of course, and one of the Weapons it is used with. And, of course, the Divine Station."
			]
			dependencies: ["7E44C96E66017AD0"]
			id: "041653153304B0ED"
			tasks: [{
				id: "0CFFF734078FE497"
				type: "item"
				item: "aoa3:divine_station"
			}]
		}
