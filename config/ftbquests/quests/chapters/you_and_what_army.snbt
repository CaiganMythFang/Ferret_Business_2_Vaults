		{
			title: "Crushed"
			x: 6.25d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7The Crusher is used to crush certain blocks into other blocks."
				""
				"&7The amount it can crush in a single day depends on the Crusher's level."
				""
				"&7It can crush Cobblestone into Gravel, with a chance at some Flint."
				""
				"&7It can crush Gravel into Sand. And then it can crush Sand into Clay."
			]
			dependencies: ["76754F745F3BDAB3"]
			id: "357D31D66E459063"
