		}
		{
			title: "Molten Forging"
			x: 8.75d
			y: -4.75d
			shape: "square"
			description: [
				"&7The Smeltery is used to turn Ores into Ingots."
				""
				"&7The Level of the Smeltery building, as well as the Smelter Worker's strength, gives you a higher chance of Doubling the Ingots it makes from one Ore."
				""
				"&7By default, all the Ores the Colony system knows about are activated in the interface. Some of the newer, or changed ores might not show up or be disabled, and you may be able to activate them or add them as a Recipe."
			]
			dependencies: ["04ADADBC03C283FD"]
			id: "30DC8CE5E4D26597"
			tasks: [{
				id: "5CF7E1D72FEF53D4"
