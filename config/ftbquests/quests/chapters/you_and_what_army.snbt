			]
			rewards: [{
				id: "2E520F8FDB6B7AB3"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Colorful Colony"
			x: 5.0d
			y: -2.25d
			shape: "rsquare"
			description: [
				"&7The Dyer's Hut is used for supplying colored blocks like Red Sand, Wool, etc for Builders and other workers when they request them."
				""
				"&7The Dyer's Hut starts with knowing how to make Red Sand and Green Dye. You must teach it other recipes and supply it with the materials it needs to make other items."
			]
			dependencies: ["1AAE96FA945E486D"]
			id: "6C344CD5495E2B09"
			tasks: [{
				id: "529503FE34CE4CCE"
