			}]
		}
		{
			title: "Mechanically Inclined"
			x: 3.75d
			y: -2.25d
			shape: "rsquare"
			description: [
				"&7The Mechanic's Hut is used to craft all manner of Redstone and other similar items. It is also used to craft Storage Blocks (like Blocks of Iron), and many other things when requested by another Citizen or Building."
				""
				"&7For the Mechanic's Hut to craft something,  you must teach it the Recipe."
			]
			dependencies: ["6F74DE164AB120DD"]
