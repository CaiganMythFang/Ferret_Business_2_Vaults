				item: "minecolonies:blockhutsmeltery"
			}]
			rewards: [{
				id: "4A6CB511B3FFB120"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Smelting Further"
			x: 8.75d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7The Stone Smeltery is used to smelt various Stone related blocks."
				""
				"&7It can be used to turn Cobblestone into Stone, Stone Bricks into Cracked Stone Bricks, Clay into Terracota into Glazed Terracota, etc. It will do this only if the Stone Smeltery has been taught the appropriate recipe, it has the resources, and another Worker or Building has requested it."
				""
				"&7The Glassblower's Hut, like the Stone Smeltery, will only smelt Glass and Glass Planes, as long as it has been taught the appropriate recipes."
				""
