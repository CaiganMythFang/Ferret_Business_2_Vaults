			}]
		}
		{
			title: "A Grand Smithy"
			x: 3.75d
			y: -4.75d
			shape: "square"
			description: [
				"&7To keep your Citizens supplied with Tools, Weapons, and Armor, I highly suggest a Blacksmith's Hut be built."
				""
				"&7You can teach it any 'vanilla' recipe for tools and armor, and it will make those items when another Citizen or Building requests them."
				""
				"&7On reaching Level 5, the Blacksmith's Hut will automatically learn how to make Netherite recipes."
			]
			dependencies: ["056D01CFBD6E1603"]
			id: "6F74DE164AB120DD"
			tasks: [{
				id: "6B7B50EFE6D2D63A"
