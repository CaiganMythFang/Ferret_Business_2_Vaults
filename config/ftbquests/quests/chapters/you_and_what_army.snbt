			}]
		}
		{
			title: "Stringed Up"
			x: 7.5d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7The Flether's Hut makes Bows, Arrows, and items that use String or Wool, like Fishing Poles and Paintings."
				""
				"&7You must teach the Fletcher's Hut the appropriate recipe, it must have the materials on hand, and the item must be requested by another Worker or Building."
				""
				"&7The Sifter is used to sift through Dirt, Gravel, Sand, and Soul Sand to look for treasure."
				""
				"&7The Sifter will requre a Mesh to sift through the blocks. The higher material the Mesh is, the higher the chance of treasure. Each Mesh is made by a specific Building."
			]
			dependencies: ["04ADADBC03C283FD"]
			id: "2FF91360F60621AD"
