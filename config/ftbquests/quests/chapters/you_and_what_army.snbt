			}]
		}
		{
			title: "Daily Fish n Bread"
			x: -1.25d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7You can build a Fisherman's Hut and get a slow, steady supply of fish. It requires at least a 7x7 area of water minimum close to the Hut, as well as Fishing Rods for the Fisher."
				""
				"&7Another thing you can make to supply your Restaurant with is a Bakery. The Baker will cook and bake food only when it's requested from the Restaurant or another building, and if you set the Recipe in the Bakery interface."
				""
				"&7At higher levels, the Bakery can make special breads."
			]
			dependencies: ["2235E571003AAC12"]
			id: "4763EADFC9408AE6"
			tasks: [
				{
					id: "32DFA9943031B4F4"
