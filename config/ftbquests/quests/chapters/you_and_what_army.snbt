					item: "minecolonies:blockhutfisherman"
				}
				{
					id: "29ACDFC96D3318EC"
					type: "item"
					item: "minecolonies:blockhutbaker"
				}
			]
			rewards: [{
				id: "057736FD49F8632E"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Shipping and Receiving"
			x: -2.5d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7So, the Warehouse stores a lot of items, right? But adding items to it yourself is a bit troublesome if you put the Warehouse in the middle of everything."
				""
				"&7Instead, you can make Postboxes and Stashes. These act like pick up and drop off points for the Courier."
				""
				"&7At the Postbox, you can request items from your Warehouses."
				""
				"&7If you have items you want put into the Warehouse, put them in a Stash."
			]
			dependencies: ["182125537D52D5CB"]
			id: "7C0F14D898BFD1D3"
			tasks: [
				{
					id: "03A32B8327DEB593"
					type: "item"
					item: "minecolonies:blockpostbox"
				}
				{
					id: "4636D645FAB1E6BA"
					type: "item"
					item: "minecolonies:blockstash"
				}
			]
			rewards: [{
				id: "0FD5D0BC6758C082"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Higher Learning"
			x: 2.5d
			y: -4.75d
			shape: "square"
			description: [
				"&7Looks like if we want to make any of the rest of the buildings, you'll have to send the Colony off to College. University, to be exact."
				""
				"&7This is a pretty large building, but with it you'll be able to unlock the ability for your Citizens to build advanced buildings, as well as unlock skills and improvements for them."
				""
				"&7There are three research trees: Civilian, Combat, and Technology. Each of these trees has multiple branches of research."
				""
				"&7Each Column in the research page is tied to the level of the University. So you'll need to level up your Builders, your Builder Huts, and your University as well. Each research takes time and materials too."
				""
				"&7Oh! Any fork that has (OR) on it, means you can only learn one OR the other of that fork. "
			]
			dependencies: [
				"21B9FFB35339D0A3"
				"2235E571003AAC12"
			]
			id: "056D01CFBD6E1603"
			tasks: [{
				id: "19094665747CD8AC"
				type: "item"
				item: "minecolonies:blockhutuniversity"
			}]
			rewards: [{
				id: "6B71FD0394ED1E63"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Living and Dead"
			x: 2.5d
			y: -6.0d
			shape: "rsquare"
			description: [
				"&7The first path is the Civilian Path, and two important buildings to build early are the Hospital and the Graveyard."
				""
				"&7The Hospital is good to help keep your Citizens healthy. The Colony system has some diseases built into it. They are pretty easy to cure, but only if you have the items on hand. With the Hospital, you don't have to give the cure to each Citizen yourself."
				""
				"&7Influenza is cured with a Potato and a Carrot; Measles with Dandelion, Kelp, and Poppy; and Smallpox with Honey Bottles and Golden Apples."
				""
				"&7The Graveyard not only lets you easily retrieve the posessions of the deceased, it also gives you a chance of 'resurrecting' a Citizen after death. The Undertaker will have higher chances if you have  Mystical Site and an Enchanting Tower they can visit."
			]
			dependencies: ["056D01CFBD6E1603"]
			id: "2EAF3168FC2CF740"
			tasks: [
				{
					id: "12C0F5BE9CE068A4"
					type: "item"
					item: "minecolonies:blockhuthospital"
				}
				{
					id: "5355A942CD0424E2"
					type: "item"
					item: "minecolonies:blockhutgraveyard"
				}
			]
			rewards: [{
				id: "3FA1E1DE96A5858F"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Thought and Prayer"
			x: 2.5d
			y: -7.25d
			shape: "rsquare"
			description: [
				"&7The School is an excellent building, as it lets Citizens teach 'children' and improve their skills before they grow up. And the Library enables 'adults' to increase their skills and knowledge as well."
				""
				"&7Remember, a lot of 'adults' and all 'children' are just stand ins right now for Power Users that have died and come back into the system. This helps get them up to speed before they 'grow up', and lessens the chance of the FOP finding out this system is reactivated."
				""
				"&7As for the Mystical Site, it doesn't really have a worker. It increases the Colony Happiness just by existing, and a few different advanced professions will visit it to improve themselves."
				""
				"&7For example, the Undertaker visits it to increase their Mana skill, which helps give them a chance to resurrected dead Citizens."
			]
			dependencies: ["2EAF3168FC2CF740"]
			id: "6134932FC34AF47B"
			tasks: [
				{
					id: "224A0ECC47C70D24"
					type: "item"
					item: "minecolonies:blockhutschool"
				}
				{
					id: "45ECD685B33C88C8"
					type: "item"
					item: "minecolonies:blockhutlibrary"
				}
				{
					id: "6B8317D7955959B4"
					type: "item"
					item: "minecolonies:blockhutmysticalsite"
				}
			]
			rewards: [{
				id: "28EEFEE50C0A9569"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Offense and Defense"
			x: 3.75d
			y: -6.0d
			shape: "rsquare"
			description: [
				"&7The second path is the Combat path. It improves your Guards to the point that they can more easily handle some of the rough Advent of Ascension creatures, as well as the occasional raid that happens."
				""
				"&7The Barracks enables you to have even more Guards, which are housed in the Barracks Towers. Your Barracks can have four Towers up, and each level of the Barracks increases the number of Guards per Tower."
				""
				"&7You can also house Gold Ingots in the Barracks to pay for spies to weaken Raids."
				""
				"&7The Barracks Towers themselves are usually placed by the layout you choose when constructing the Barracks, and are a second Construction that needs to be built."
			]
			dependencies: ["056D01CFBD6E1603"]
			id: "35BDED3713653924"
			tasks: [{
				id: "49F34D1E8C7EAEB5"
				type: "item"
				item: "minecolonies:blockhutbarracks"
			}]
			rewards: [{
				id: "402FFC3E491E4113"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "From Squire to Knight"
			x: 5.0d
			y: -7.25d
			shape: "rsquare"
			description: [
				"&7The Combat Academy will turn your Guards into Knights, much stronger defenders. It can't be built until you have at least a level 3 Barracks."
				""
				"&7They start off as Knights in Training, which will not defend your Colony until they are done Training. Then they become Knight Guards."
				""
				"&7If you would prefer ranged guards, though, the Archery will be needed."
				""
				"&7Like the Combat Academy, Archers in Training will not defend your Colony. But once they are trained, they become Archer Guards."
			]
			dependencies: ["35BDED3713653924"]
			id: "7A07F9E4A5EF71A2"
			tasks: [
				{
					id: "4E5FDC514E4EE246"
					type: "item"
					item: "minecolonies:blockhutcombatacademy"
				}
				{
					id: "06C8EC2F28D7B620"
					type: "item"
					item: "minecolonies:blockhutarchery"
				}
			]
			rewards: [{
				id: "1FC7D5FF9E930D75"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Tower of Enchantment"
			x: 2.5d
			y: -1.0d
			shape: "rsquare"
			description: [
				"&7Bandit, I highly suggest getting an Enchanter's Tower up early. It's very useful both in getting random Enchantments, but also helping your Citizens and buildings."
				""
				"&7You'll need to supply Ancient Tomes to the Enchanter, which are obtained from the various Raids the Colony system will throw at you. "
				""
				"&7The Enchanter will then go around collecting XP from various workers, and use this to craft Enchanted Books."
				""
				"&7The Enchanter's Tower can also craft various Scrolls."
			]
			dependencies: ["0123828D337D81E2"]
			id: "04D159ACEDCAD04D"
			tasks: [{
				id: "47EE23D415901F71"
				type: "item"
				item: "minecolonies:blockhutenchanter"
			}]
			rewards: [{
				id: "58FD2766F7579C3C"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Attacks like Clockwork"
			x: -0.5d
			y: -1.0d
			shape: "rsquare"
			description: [
				"&7When you have enough Citizens moving into your Colony, whether they are still there or not (in case some, you know, died?), the Colony system will start to send Raids to you."
				""
				"&7These Raids can vary, from Pirates by water, to Amazonians or Barbarians by land. They'll usually spawn a Hex or two away and then start heading to your town. You'll want to use a Rallying Banner to gather your Guards to defend the Colony."
				""
				"&7Most Raids will spawn a set number of attackers, except ones like the Pirates. Pirate ships will have spawners on them, and you'll need to board the boat and destroy it to stop the Raid."
				""
				"&7Each Raid has at least one Leader, who will drop an Ancient Tome. This is useful for certain buildings like the Enchanter's Tower. The Ancient Tome will also glow before a Raid night."
			]
			dependencies: ["0660E08D755B3BB6"]
			id: "0123828D337D81E2"
			tasks: [
				{
					id: "41B0B1E38DD2EA34"
					type: "item"
					item: "minecolonies:ancienttome"
				}
				{
					id: "5CBE41A007BA29D6"
					type: "item"
					item: {
						id: "minecolonies:banner_rally_guards"
						Count: 1b
						tag: {
							isActive: 0b
							guardtowerpositions: [ ]
						}
					}
				}
			]
			rewards: [{
				id: "6283D4F6E04A6BBD"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Plant Recycling"
			x: 5.0d
			y: -4.75d
			shape: "square"
			description: [
				"&7The third path is the Technology Path. One of the first things you should consider making is the Composter."
				""
				"&7The Composter uses Composting Barrels and various plants to make either Compost or Dirt. You can select which one you want in the interface."
				""
				"&7By default, the Composter has no plants selected for Composting. Be sure to select the ones you want to Compost from the valid list in the interface."
				""
				"&7A good idea is to check your warehouses when you can for plants that your Builders and Guards collect while working."
				""
				"&7Compost is used by Farmers like Bonemeal, to make the farms grow food faster."
			]
			dependencies: ["056D01CFBD6E1603"]
			id: "2C529DC9CBD39277"
			tasks: [
				{
					id: "0293DBBD7352437E"
					type: "item"
					item: "minecolonies:blockhutcomposter"
				}
				{
					id: "4E965E5B7319AD98"
					type: "item"
					item: "minecolonies:barrel_block"
				}
			]
			rewards: [{
				id: "016AEF1B2DC2198B"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "More Farming"
			x: 5.0d
			y: -3.5d
			shape: "rsquare"
			description: [
				"&7If you want to expand what you can farm for, two good Buildings are the Flower Shop and the Plantation."
				""
				"&7The Flower Shop will grow various flowers every day if you supply it with an Axe and Compost."
				""
				"&7The Plantation, though, is for growing Bamboo, Sugar Cane, and Cactus."
				""
				"&7You can also teach the Plantation how to make Paper, Books, Sugar, etc."
				""
				"&7You can choose which of the three plants the Plantation will grow in the Interface. With certain University research, this screen chooses the one they WILL NOT grow."
			]
			dependencies: ["2C529DC9CBD39277"]
			id: "1AAE96FA945E486D"
			tasks: [
				{
					id: "6F18EA1E7D4DF1B1"
