			}]
		}
		{
			title: "Rough Rider"
			x: 4.5d
			y: 1.5d
			shape: "diamond"
			subtitle: "BOSS FIGHT"
			description: [
				"&dIf you want to face Rockrider, you should find a large area on one of the sky islands, because you want to make sure you won't get knocked off."
				""
				"&5Rockrider hits hard and throws hard, Bandit. Be careful when fighting it. "
				""
				"&dWhen you are ready, take that Heavy Boulder and just... throw it on the ground. This will signal to Rockrider that you want to challenge them."
				""
				"&5Rockrider's dual nature lets them swap between two forms : one is very resistant to melee, the other very resistant to ranged attack."
				""
				"&dSo plan your arsenal accordingly. If you defeat them, you'll have a chance of getting a special sword or sniper rifle."
			]
			dependencies: ["7AD8FF7AF46E5F0B"]
			id: "4F4D7E7860F465DC"
