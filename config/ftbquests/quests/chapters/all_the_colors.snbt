				}
				{
					id: "0CB3A04242B31283"
					type: "item"
					item: "aoa3:hardened_confetti_ball"
				}
			]
			rewards: [{
				id: "75FF630141B14E77"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
