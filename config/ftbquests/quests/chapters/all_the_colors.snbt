				table_id: 2245246540467579945L
			}]
		}
		{
			title: "Protecting Every Creature"
			x: 4.5d
			y: 5.25d
			shape: "diamond"
			subtitle: "BOSS BRIBE"
			description: [
				"&dWe've figured out how to get past the Four Guardians, Bandit. It involves acting as 'security' contractors and providing some much requested defense equipment."
				""
				"&5The FOP are very stingy with a lot of their systems, teams, and bosses. And given the Four Guardians are semi-advanced AI, we can't just bribe them directly."
				""
				"&dInstead, we can pose as approved contractors and supply some defense materials they've had requested for a long time."
				""
				"&5A lot of this is locked behind DLC, unfortunately. But getting all of it, and a Security Card, should be good."
				""
				"&dWell, not ALL of it. If they got ALL of what they requested, it'd get flagged quick. This is maybe 1/10th of their request."
			]
