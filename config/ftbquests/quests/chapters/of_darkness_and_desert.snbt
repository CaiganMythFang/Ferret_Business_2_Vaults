		{
			title: "Arocknid and Cave Creep"
			x: 4.25d
			y: 1.0d
			shape: "rsquare"
			description: [
				"&5Arocknids are creatures that in Arocknid Caves, domed structures found scattered in the Deeplands. "
				""
				"&5Arocknids can climb walls like Spiders, and will cause Weakness if they damage you."
				""
				"&5Arocknids can drop Chitin, which is good for Crafting. They also have a rare chance at dropping a Rock-Pick Sword."
				""
				"&5Cave Creeps are creatures that spawn all over the Deeplands."
				""
				"&5Cave Creeps can drop Chitin, which is good for crafting."
			]
			dependencies: ["0B2F7C0BF6DBF195"]
			id: "3228458C31469019"
