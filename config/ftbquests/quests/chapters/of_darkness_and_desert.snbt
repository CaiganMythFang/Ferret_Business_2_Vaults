		{
			x: 5.25d
			y: 1.0d
			shape: "rsquare"
			description: [
				"&5Case Constructs are creatures that can rarely be found in the Deeplands."
				""
				"&5Case Constructs are immune to all fire types of damage, including Lava."
				""
				"&5Case Constructs can drop Deep Cases."
				""
				"&5The Doubler is a rare creature that spawns in the Deeplands."
				""
				"&5The Doubler inflicts Blindness to enemies close to it."
			]
			dependencies: ["0B2F7C0BF6DBF195"]
			id: "27DD56BC3F5221AD"
			tasks: [
				{
					id: "4B88A3A461C00F22"
					type: "kill"
					entity: "aoa3:case_construct"
					value: 2L
