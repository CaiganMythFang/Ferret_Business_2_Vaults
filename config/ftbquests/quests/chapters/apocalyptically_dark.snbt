			}]
		}
		{
			title: "Unknown Levels of Twisted"
			x: 4.75d
			y: 3.25d
			shape: "diamond"
			subtitle: "BOSS FIGHT"
			description: [
				"&5Scattered around the Vox Ponds you can find Voxxulon Platforms, tributes to Voxxulon. Each one has a few Voxxulon Altars on them, and you can Right Click the Vile Stone onto any of them to summon Voxxulon to fight."
				""
				"&dVoxxulon changed his form to be so big and powerful he doesn't have to move. He'll stay in the same spot usually, and attack you if you get close."
				""
				"&5Mostly stationary... he has the ability to teleport randomly up to you, as well as inflict poison on everyone around him. "
				""
				"&dOh, and watch out for the random Meteors he summons too. Don't forget those."
				""
				"&5Finish off Voxxulon, and he might drop a vile staff or greatsword, along with other things."
			]
			dependencies: ["329AAEAD023CD38F"]
			id: "0BE470AF58C4261B"
			tasks: [{
