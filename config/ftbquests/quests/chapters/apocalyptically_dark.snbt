	quests: [
		{
			title: "Grim Choices"
			x: -8.5d
			y: 0.75d
			shape: "hexagon"
			description: [
				"&5Seems the next two areas branch off of Creeponia, Bandit. And well..."
				""
				"&dThey are quite rough. One's a poisonous mushroom world, the other is a toxic wasteland."
				""
				"&5I highly suggest both some night vision gear, and some anti poison or similar. "
			]
			dependencies: ["59FEA090B57BA3DE"]
			id: "0F2B296548FC8B14"
			tasks: [{
				id: "284C7D37400EC339"
