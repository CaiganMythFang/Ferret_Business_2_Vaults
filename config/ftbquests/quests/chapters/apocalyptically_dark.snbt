			}]
		}
		{
			title: "Of Many Poisons"
			x: -6.75d
			y: -1.75d
			shape: "diamond"
			description: [
				"&5Looks like it's time to head to Mysterium, Bandit. "
				""
				"&dThis is a pretty dangerous world. It's full of poisonous and dangerous mushrooms. "
				""
				"&5And getting there is dangerous too. Grab yourself a Blank Realmstone, and some way to poison yourself."
				""
				"&dPotions are the most reliable way I guess. The requirements for creating the Mysterium Realmstone are always a bit brutal..."
				""
				"&5Okay, now what you need to do is find a Creepird, make sure you are poisoned, then KILL the Creepird."
				""
				"&dWhile poisoned. And having a blank Realmstone in your pocket."
				""
				"&5Yep..."
			]
			dependencies: ["0F2B296548FC8B14"]
			id: "7A07246A536ACEB2"
			tasks: [{
				id: "78950CE440AE97B5"
