				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Land of Mushrooms"
			x: -4.0d
			y: -1.75d
			shape: "pentagon"
			description: [
				"&5While the world of Mysterium has a surface, most of its flora and fauna live within the vast fungal caverns below."
				""
				"&dThoug the plant life up top does get fairly... psychadelic?"
				""
				"&5Very colorful at least, yeah. But either way, be careful when traversing Mysterium. Bring lots of antidotes with you."
			]
