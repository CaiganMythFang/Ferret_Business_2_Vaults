			}]
		}
		{
			title: "Create Set"
			x: -3.75d
			y: -2.25d
			shape: "diamond"
			description: [
				"&3One of the special expansion sets of Buddycards is for the Create mod. Instead of finding them in dungeons, or buying them from a shop, you make them."
				""
				"&3To make it, you'll first need to take some of your unwanted Buddycards and..."
				""
				"&3Shred Them. Between a pair of Crushing Wheels. This'll get you some Shredded Buddycards. Then you'll want to reconstitute and form them back into Recycled Buddycards in a Mechanical Mixer with some Water."
				""
				"&3Then, finally, you'll need to use a Sequenced Assembly line, Deploying the Recycled Buddycard onto a Luminous Sheet, and splashing it with Water with a Spout so it sticks to the Luminous Sheet. Repeat this Four times for a single Luminous Sheet, and the magic of the Luminous will form a Create Buddycard Pack."
			]
			dependencies: [
				"54AEE29A46710545"
				"37BFFC79E7D31977"
			]
			id: "60FAD21D19C2E9CE"
			tasks: [
				{
					id: "01583C3CAA49F01C"
					type: "item"
					item: "buddycards:shredded_buddycard"
				}
				{
					id: "2EEB6384376B6600"
					type: "item"
					item: "buddycards:recycled_buddycard"
				}
				{
					id: "542D4AE32EBC8BB0"
					type: "item"
					item: "buddycards:pack.5"
				}
			]
			rewards: [{
				id: "2484B0746D751C61"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Farmer's Delight Set"
			x: -4.75d
			y: -1.25d
			shape: "diamond"
			description: [
				"&3One of the special expansion sets of Buddycards is for the Farmer's Delight mod. You can rarely find them when harvesting a crop, but you can also cook them up!"
				""
				"&3First you'll need to take that Buddysteel Knife you use to chop up Grass, and use it on a Cutting Board with one of your unwanted Buddycards. Chop Chop chop, Bandit! "
				""
				"&3Now that you got a couple Shredded Buddycards, toss em into a Cooking Pot with some Buddybeans, meat, and sugar (for the special surprise in every pack!)"
				""
				"&3See, each pack of Farmer's Delight cards only has 3 Buddycards, cause its a smaller set. The fourth card? A delicious gummi!"
			]
			dependencies: [
				"54AEE29A46710545"
				"22FED65777C0F119"
