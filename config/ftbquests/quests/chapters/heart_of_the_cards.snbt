		{
			title: "Aquaculture Set"
			x: -2.75d
			y: -1.25d
			shape: "diamond"
			description: ["&3One of the special expansion sets of Buddycards is for the Aquaculture mod. Instead of finding them in dungeons, or buying them from a shop, you can either fish them up when using a Buddysteel Hook, or crafting them!"]
			dependencies: [
