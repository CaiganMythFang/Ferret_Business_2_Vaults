			}]
		}
		{
			title: "Now This is a Knife"
			x: 3.25d
			y: -1.25d
			shape: "pentagon"
			description: [
				"&3Making a Buddysteel Knife is an odd choice, but can be quite helpful when you are wanting to make some Farmer's Delight components."
				""
				"&3It acts much like Farmer's Delight knives: Breaking grass with it can net you more seeds and some useful fibers. And sometimes, sometimes it will find some Buddybeans."
				""
				"&3They are pretty tasty I have to say!"
			]
			dependencies: [
				"37922460FDB0D05A"
