				table_id: 2245246540467579945L
			}]
		}
		{
			title: "Worthy Challenge"
			x: 8.5d
			y: -4.0d
			shape: "diamond"
			subtitle: "BOSS FIGHT"
			description: [
				"&5If you aren't able to procure all the components for the Bribe path, Bandit, its understandable. We're near end game with the FOP, so things are...quite more difficult to do now."
				""
				"&dFacing Corallus in her home turf is going to be quite a challenge. When you are ready, just throw the Amphibiyte Heart out  into the water of L'Borean to summon her."
				""
				"&5Corallus is a strong opponent both in and out of water. If you are on land when she hits you, you'll be Slowed and and Weakened. If you are in water, she will launch you down, deeper into the ocean."
				""
				"&dBe careful if she changes to a dark blue color, she has boosted her Strength heavily for a bit."
				""
				"&5If you can defeat her, she may drop some aquatic staffs or a special helmet."
			]
			dependencies: ["285E2046D6E7C043"]
			id: "31FE5F5EB86F94B1"
