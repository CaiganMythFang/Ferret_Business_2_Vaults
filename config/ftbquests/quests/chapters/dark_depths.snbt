			}]
		}
		{
			title: "Aquatic Machinations"
			x: 7.0d
			y: -0.75d
			shape: "pentagon"
			description: [
				"&5Dracyon is a smart boss, there's a reason he's on the Board of Directors."
				""
				"&dAt this stage, we probably won't get far in bribing anyone on the Board of Directors, Bandit. I'm sorry to say. "
				""
				"&5We'll look into it though. If we can get to even one of them, it'll cut their power down."
				""
				"&dYou should prepare to face Dracyon either way, Bandit. In his off time, Dracyon likes fishing, and requires any Power User who wants to face him to fish as well."
				""
				"&5Strange, we know. But just start fishing here in L'Borean. You will eventually fish up a Call of the Drake, which gives you permission to summon him for an audience."
			]
			dependencies: ["6F4BC7533A3F122E"]
			id: "678586175505BC35"
			tasks: [{
				id: "1851C3656298EBD6"
				type: "item"
				item: "aoa3:call_of_the_drake"
			}]
			rewards: [{
