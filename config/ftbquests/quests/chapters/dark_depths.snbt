				table_id: 2245246540467579945L
			}]
		}
		{
			title: "And Beyond"
			x: -0.75d
			y: 3.0d
			shape: "pentagon"
			description: [
				"&5Welcome to Lunalus, Bandit. You brought a space helmet right? Or well, one of the breathing helmets you used back at Vox Ponds at least."
				""
				"&dAs you can see, this is an endless field asteroids, various Belts digitized by the FOP, and the unfortunate space travelers trapped within."
				""
				"&5Falling to the bottom of this space will teleport you up to the top of it. An endless falling loop until you decide to stop yourself."
				""
				"&dAlso, when traveling around, Bandit, be careful. Most of the creatures in here, sentient or not, are trapped in here. Space faring folks will realize they are trapped, and may be very defensive."
			]
			dependencies: ["343CA0931F27556D"]
			id: "5CE1D23027E8631E"
