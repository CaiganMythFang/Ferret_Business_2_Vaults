		{
			title: "Standing Ground"
			x: 6.25d
			y: 1.0d
			shape: "hexagon"
			description: [
				"&5Clunkhead will only show up if you call him with the big amount of magic the Mega Rune Stone can send out. Bring it to a Clunkhead Arena, a large two story structure that rarely generates in Runandor."
				""
				"&dIn the Arena, you can find a Clunkhead Altar to use the Mega Rune Stone on. This will summon Clunkhead for an audience."
				""
				"&5Clunkhead is a heavyweight on the Board of Directors. Knockback will not work on them. Keep moving to avoid their projectiles."
				""
				"&dWhen they hit half health, they'll start regenerating now and then. You'll need to outpace their damage, Bandit."
				""
				"&5But if you win, you not only knock another Board Member off, you may also get special Runic gear."
			]
			dependencies: ["2B3248715A299566"]
			id: "56621830E6DA1B57"
			tasks: [{
				id: "7E4F233F54F7018A"
				type: "item"
				item: "kubejs:boss_card_clunkhead"
			}]
			rewards: [{
				id: "5704AE0E341ADA94"
				type: "choice"
				table_id: 818089594093312426L
			}]
		}
