	quests: [
		{
			title: "Back to the Nether"
			x: -7.25d
			y: 0.25d
			shape: "hexagon"
			description: [
				"&dOkay you should be a bit better equipped to handle the demons of hell here."
				""
				"&5You might need some climbing gear or something... Byte might cover something useful for that amongst the DLC packages."
				""
				"&dOr just get really good at parkour and building quick staircases I guess."
				""
				"&5I dunno sis, I'd prefer a grappling hook I think. But that's a tangent, sorry Bandit. "
				""
				"&dRight. The first thing you'll need to find is some Emberstone Ore. "
				""
				"&5Oh, and don't forget to mark where your portal is on the map. M for map, and Right Click your icon."
			]
			dependencies: ["59F3969498D4078C"]
			id: "1881243BF68F0FAC"
