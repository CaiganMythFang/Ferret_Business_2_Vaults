			}]
		}
		{
			title: "A Different Path to Hell"
			x: -7.25d
			y: -0.75d
			shape: "rsquare"
			description: [
				"&dSo, you can make yourself a Nether Realmstone as well if you want to use that fancy Ancient Teleporter instead of an Obsidian one."
				""
				"&5It's pretty easy. Just chuck yourself in Lava and then throw the Realmstone out with Q."
				""
				"&dWell, easy to say, hard to do. You'll probably want Fire Resist potions or gear. "
				""
				"&5Probably both. Or be very quick before you die."
			]
			dependencies: ["1881243BF68F0FAC"]
			id: "4905625BD3C4B3C4"
			tasks: [{
				id: "0C33068C54F708D3"
