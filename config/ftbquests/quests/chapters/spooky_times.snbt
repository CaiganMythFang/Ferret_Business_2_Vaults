				table_id: 2245246540467579945L
			}]
		}
		{
			title: "Facing the Music"
			x: 12.25d
			y: -3.25d
			shape: "diamond"
			subtitle: "BOSS FIGHT"
			description: [
				"&5Well Bandit, we kind of figure either way you choose, you'll be helping the Ancient Ones in the end."
				""
				"&dBy fighting them, you give them a chance to hang out jam together for a bit. Even if you defeat them, they get a chance to hang and you'll be a step closer to freeing them."
				""
				"&5If that is your choice, you'll need to find a Primordial Altar, which has a row of Dark Lamps on it. Light each Lamp with a Darkly Powder, and upon lighting the fifth one, the Primordial Five will arrive."
				""
				"&dEach one will fight you one on one. First Kajaros, then Miskel, then Harkos, then Raxxan, and finally the band leader Okazor."
				""
				"&5Upon defeating Okazor, you may get one of their Primordial weapons."
			]
			dependencies: ["196984E67524FD40"]
			id: "44C55CF8E4D75854"
			tasks: [{
