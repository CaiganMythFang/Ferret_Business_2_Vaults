	quests: [
		{
			title: "Exploring the Dark"
			x: -2.0d
			y: 0.0d
			shape: "pentagon"
			description: [
				"&5Okay Bandit, we've worked out the first worlds of Tier 3 you should visit."
				""
				"&dAt this high level of FOP Game Worlds, there are less worlds to visit and more danger. "
				""
				"&5We're continuing the trek into dark worlds that require Night Vision of some sort, Bandit. "
				""
				"&dAlso, while these dimensions branch off of the Abyss..."
				""
				"&5...they aren't as overly ridiculously edgy."
			]
			dependencies: ["3614A04B234B4A20"]
			id: "2F85F104F5FA32CB"
			tasks: [{
				id: "617A6D41EC7B51D5"
				type: "checkmark"
			}]
		}
		{
			title: "The Uncolored Place"
			x: 0.5d
			y: -2.5d
			shape: "diamond"
			description: [
				"&5As we mentioned, Bandit, you'll be wanting to keep your Night Vision here."
				""
				"&dDustopia is a fairly dark and colorless place. "
				""
				"&5Getting there is also rough, as the Dustopia Realmstone requires you to face the Abyss boss Shadowlord."
				""
				"&dYou don't have to defeat them, but you have to summon them with a Blank Realmstone in your inventory, while having Night Vision activated."
				""
				"&5Then you can skedaddle, unless you want to take down Shadowlord again that is."
				""
				"&dDon't forget you'll need the Blue Dimensions DLC for the next couple worlds."
			]
			dependencies: ["2F85F104F5FA32CB"]
			id: "26DFA71F53F3FE29"
			tasks: [{
				id: "2873786E4516584F"
