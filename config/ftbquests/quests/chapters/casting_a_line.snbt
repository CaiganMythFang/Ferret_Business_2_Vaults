					item: "aquaculture:bobber"
				}
			]
			rewards: [{
				id: "2394BB557F7BB5DF"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "A Little Message"
			x: 5.25d
			y: -0.5d
			shape: "rsquare"
			description: [
				"&3Sometimes ya find an old can, or a bit of driftwood. Sometimes, ya find a bottle. "
				""
				"&3And sometimes, that bottle has a little message for ya. They aren't super useful, but they can be pretty interesting."
				""
				"&3They can also be dang annoying cause the FOPGame Server has it as another way to advertise to ya, so... I guess that is yer warning, Bandit."
			]
			dependencies: ["61F3F6680887946E"]
			id: "4A4138708BACDF4A"
			tasks: [{
				id: "2003D91D9BDCF846"
				type: "item"
				item: "aquaculture:message_in_a_bottle"
			}]
			rewards: [{
				id: "455376C79965B382"
