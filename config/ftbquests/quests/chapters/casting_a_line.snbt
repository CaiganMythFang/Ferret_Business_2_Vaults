				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Power of the Sea"
			x: 6.75d
			y: 1.0d
			shape: "rsquare"
			description: [
				"&3Ya been upgrading your equipment I hope, Bandit? An Iron Rod and an Iron Hook are all well and good to start with, but yer gonna need something a bit more elegant if you want to catch both the big fish and the big treasures."
				""
				"&3A Diamond Rod is good, but Enchant it with Luck of the Sea for the best chances. And a Gold Hook is good for Luck as well, though if you can somehow spare a Nether Star, well... Let's stick with the Gold Hook, yeah?"
				""
				"&3It'll take a while, but if yer Luck is good, you may find one of these rare treasures, imbued with the luck and power of the sea: The Neptune's Bounty, a chest full of treasures small (usually) and big (if you are lucky)."
			]
			dependencies: ["61F3F6680887946E"]
			id: "3A0DF96A91CA4B14"
			tasks: [{
				id: "137B599B4651FE5C"
				type: "item"
				item: "aquaculture:neptunes_bounty"
			}]
			rewards: [{
				id: "2F1DA596EAA89615"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
