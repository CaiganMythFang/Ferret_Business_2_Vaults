		}
		{
			title: "Vault Death, Level 20, And You"
			icon: "minecraft:skeleton_skull"
			x: 6.191964285714285d
			y: -1.2232142857142918d
			shape: "pentagon"
			subtitle: "A Difficulty Tweak"
			description: [
				"&dBandit, when you hit 20, you should wait before going into another Vault!"
				""
				"&5Aye, things get a bit more difficult for you now...see, now when you die in a Vault, you will lose most of the equipment you are carrying."
				""
				"&dNot permanently(usually...). Your Coin Pouch should stay with you at least, and any Soulbound equipment. Either at your Bed or your World Spawn should be your Ghost Body."
				""
				"&5To get your equipment back, you'll need to Right Click and pick this body up, and bring it to a Spirit Extractor. Then Right Click the body onto it."
				""
				"&dThe Spirit Extractor will list how much Vault Gold it costs to get your equipment back. It's calculated off of your Vault Gear, Backpacks, and a few other things."
				""
				"&5It's a good idea to have a few backup sets of equipment, just in case..."
			]
			dependencies: ["3011291910FDA2DC"]
			dependency_requirement: "one_completed"
			id: "148669A61C9EFBF4"
			tasks: [{
				id: "5449035872332A83"
				type: "checkmark"
			}]
			rewards: [{
				id: "7797EC090D62CFF3"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Carefully Shaped Jewels"
			x: -7.5d
			y: 1.0d
			shape: "rsquare"
			subtitle: "Better Tool Power"
			description: [
				"&dHuh, what happened to the old Jewel Cutting Station?"
				""
				"&5I guess this is another system they replaced. Any idea how it works now?"
				""
				"&dWell, according to the forums.... not great. Good idea, but flawed execution."
				""
				"&5So yer saying it needs cutting down and polishing? A diamond in the rough?"
				""
				"&dMore like cutting up. I thiiink I can sneak in a very quiet change... as long as I keep changes small, I can nudge things in your favor, Bandit."
				""
				"&5But for Bandit's sake, how's it work?"
				""
				"&dOH, sorry Bandit. Okay, the Jewels you find in Vaults have special effects. Bonuses to loot, etc. But the tools you put them on, only cover one type of tool. Pickaxe, axe, etc."
				""
				"&dUsing this Jewel Crafting Station, and the gemstones you get from Recycling unused Jewels, you can craft and add more Tool types and special abilities to your Vault Tools."
			]
			hide_dependency_lines: true
			dependencies: [
				"5252A91CF03F9FFB"
				"29198B5EA727A867"
			]
			id: "5F19CA4A2A21E708"
			tasks: [{
				id: "0ECCE31A31699702"
				type: "item"
				item: "the_vault:jewel_crafting_table"
			}]
		}
		{
			title: "A Tool for All Occasions"
			x: -8.25d
			y: 0.0d
			shape: "rsquare"
			subtitle: "There are many like it..."
			description: [
				"&dTo try encouraging Users to make and send in all sorts of normal tools, the FOP encourages you to use the special Vault Tools you can make in the Tool Station."
				""
				"&5Vault Tools have a good amount of durabiility, even at the lower tiers. As you increase your Vault Level, you can make bigger and bigger tools."
				""
				"&dYou can only repair them a set number of times, though. But early on you'll be upgrading your tools regularly anyways."
				""
				"&5They can't really be used as weapons like some other tools can, though...At least not effectively."
				""
				"&dVersatility makes up for that, brother. You can augment and upgrade your tools with Jewels, which will need its own quests to explain~."
			]
			dependencies: ["232779928B96328E"]
			id: "3E4FCFC9637F8B61"
			tasks: [{
				id: "184F0D0442BC5BC8"
				type: "item"
				item: "the_vault:tool_station"
			}]
		}
		{
			title: "Easily Enchanting"
			x: -9.75d
			y: -3.5d
			shape: "rsquare"
			subtitle: "For just a few emeralds..."
			description: [
				"&dBandit, in your previous world, you enchanted gear either with an enchanting table..."
				""
				"&5...or by looting Enchanted Books. "
				""
				"&dThe FOP have made it a lot easier to apply enchantments to your gear, to get you in and out of Vaults more smoothly."
				""
				"&5The Vault Enchanter is your one stop shop for almost any Enchantment. Though they don't come free..."
				""
				"&d ...but are quite cheap. Usually just some Emeralds and some XP levels."
				""
				"&5Though it looks like there are some special high cost Enchantments you can get. Probably best saved for higher level gear."
			]
			hide_dependency_lines: true
			dependencies: ["7543E03FC25521E7"]
			id: "76705D95215E5BCA"
			tasks: [{
				id: "469035E1A26F175F"
