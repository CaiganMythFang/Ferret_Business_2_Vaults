				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Bomb Carriers and Bone Backs"
			x: -3.75d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&5Bandit, be careful of the Bomb Carrier. This crazy human has a stockpile of TNT it likes to fight with. It can't hurt itself or terrain with the explosions, but YOU are squishy and blow up nicely apparently. They can spawn ANYWHERE so be careful!"
				""
				"&5The Boneback, though, spawns only in savanna type biomes. They are fairly aggressive too."
				""
				"&5Neither of these drop anything super unique."
			]
			dependencies: ["3E3E6553CBF3C30D"]
