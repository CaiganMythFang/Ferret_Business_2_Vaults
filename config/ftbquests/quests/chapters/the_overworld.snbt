			}]
		}
		{
			title: "A Little Regretful"
			icon: "the_vault:regret_orb"
			x: 2.25d
			y: -3.5d
			shape: "rsquare"
			subtitle: "Forget What You Knew"
			description: [
				"&dYou've probably already come across these little red nuggets in Living Chests. A bunch of these can be combined together into an Orb of Regret."
				""
				"&5The Skill system in Vault Hunters has a lot of options, and since you get a Skill Point every level, you'll eventually select a skill you don't like anymore."
				""
				"&dFor this, you can use Orbs of Regret to unlearn one level's worth of a skill."
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
			id: "0F213FAC45AAB2D3"
			tasks: [
