		{
			title: "Bush Baby and Chimera"
			x: -2.75d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&5Busy Babies can be found in Jungle type biomes.  These are extremely weird creatures and pretty fast, so watch out. "
				""
				"&5The Chimera is a fairly dangerous creature to new Users. They can take a lot of hits and dish out a lot of damage if you are pretty new to the game. You can get a Raw Chimera Chop, a decent food item when cooked."
			]
			dependencies: ["3E3E6553CBF3C30D"]
