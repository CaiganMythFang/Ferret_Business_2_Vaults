		{
			title: "Adding and Subtracting"
			x: -3.5d
			y: 1.0d
			shape: "rsquare"
			subtitle: "More or Less Focused"
			description: [
				"&dIf your piece of gear has an empty Prefix or Suffix slot or two, Bandit, you can use an Amplifying Focus to add something to one of those slots."
				""
				"&5The flip side of that coin is the Nullifying Focus, Bandit. It's a bit of a gamble, as you will remove a single Suffix or Prefix and free up the slot."
				""
				"&dIt takes less Crafting Potential to use these, versus using a Wild Focus to reroll the entire thing."
			]
			hide_dependency_lines: true
			dependencies: ["6473A9F33F692821"]
			id: "3B4C4700E242F1FB"
			tasks: [
				{
