		{
			title: "Chompers and Cyclops"
			x: 0.25d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&5Chompers can be found in Swamp type biomes. Be careful when fighting it, it can slow you down with its attacks. Deadly in the already muddy, watery swamps."
				""
				"&5Chompers can drop Ivory, which is important for a few crafting things."
				""
				"&5Cyclops can be found in most every biome. They are pretty strong creatures, and dangerous if you aren't equipped up. They don't drop anything unique."
			]
			dependencies: ["3E3E6553CBF3C30D"]
			id: "7E188858BD36A7BE"
			tasks: [
				{
					id: "3A8602ACB6585E05"
