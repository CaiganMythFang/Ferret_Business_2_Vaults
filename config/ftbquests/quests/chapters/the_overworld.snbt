		{
			title: "The Charger King"
			x: -0.75d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&5Rarely you can find the King Charger in any biome in the Overworld."
				""
				"&5This big Charger is very dangerous, and hits like a truck!"
				""
				"&5The only special things the King Charger drops is the Charger Shank like other Chargers, and Sharp Claws, which various other Advent creatures can drop. Be sure to keep it for later crafting."
			]
			dependencies: ["3E3E6553CBF3C30D"]
