				item: "the_vault:wild_focus"
			}]
		}
		{
			title: "Stand and Identify"
			x: 0.25d
			y: -3.5d
			shape: "rsquare"
			subtitle: "Instant Roll of the Dice"
			description: [
				"&dAs you level up, Bandit, the amount of Vault Gear you find in the Vaults will increase. Especially if you tailor your skill and equipment to getting more loot."
				""
				"&5Which I always highly suggest. More loot means more chance of getting what ye really want."
				""
				"&dRight! But \"Rolling\" every single piece of gear sounds fun to me, but most folks find it tedious after a while. So, enter the Identification Stand."
				""
				"&5Just keep this somewhere in yer base, and when you have an inventory full of Unidentified Gear (Including yer backpacks!), you can Right Click that stand to auto identify all of them at once."
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
			id: "7B4E0CC53475C2C5"
