	filename: "the_overworld"
	title: "Cracking the Surface"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			title: "A Hella Warm Place to Visit"
			x: -3.5d
			y: -1.25d
			shape: "hexagon"
			subtitle: "Where to begin?!"
			description: [
				"&dOkay Bandit, we've had time to figure out some of the FOP Game Server layout. What a doozy..."
				""
				"&5The system map of the game is over twenty worlds..."
				""
				"&dThey all can't be important, right? But I won't know till I examine one of the Tier 1 worlds..."
				""
				"&5Lets try getting Bandit into the Nether then, or whatever the FOP have put as their own version of the Nether."
				""
				"&dGood idea. You remember the drill, right Bandit? Make a 4 wide, 5 tall ring of Obsidian, and light the opening with a Flint and Steel."
				""
				"&5You'll need to unlock Yellow Rank Ore DLC to get Diamonds for Obidian. Or get lucky with looting. Or be creative."
				""
				"&dBe sure to check out Byte's section and the FOP DLC Shop for the different ways to unlock the DLC."
			]
			id: "69C663CDD23190A9"
			tasks: [{
				id: "5192AB72FF5D2F7A"
				type: "dimension"
				title: "Enter the Nether"
				dimension: "minecraft:the_nether"
			}]
			rewards: [{
				id: "18E30E4C3FF5FF8C"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			x: -3.5d
			y: -0.4553571428571459d
			shape: "gear"
			description: [
				"&5Wow, even accessing something as simple as the Nether requires DLC."
				""
				"&dKind of ridiculous, especially when you WANT people to tear out all the resources for you."
				""
				"&5Eh, guess if someone works hard enough to 'earn' it, they'll feel like they HAVE to utilize it as much as possible."
				""
				"&dYep... if it isn't obvious, Bandit, you'll also need the Red Rank Dimensions DLC to get INTO the Nether. "
			]
			dependencies: ["69C663CDD23190A9"]
			dependency_requirement: "all_started"
			size: 0.75d
			id: "745405F9B434F931"
			tasks: [{
				id: "2535781CB291B4C4"
				type: "checkmark"
				title: "DLC for that too?!"
			}]
		}
		{
			icon: {
				id: "adfinders:mineral_finder"
				Count: 1b
				tag: {
					Damage: 0
				}
			}
			x: -2.25d
			y: -1.25d
			shape: "pentagon"
			subtitle: "Only For Now..."
			description: [
				"&dOkay, head back Bandit. I got my scans. You might not be equipped to handle the Nether just yet. It's much more dangerous than the regular Nether of your previous world."
				""
				"&5Those scans looked kinda rough. But a lot of interesting things to find... "
				""
				"&dMy brother is talking about treasure. Ores, gems..."
				""
				"&5Magical trinkets. Weird weapons. Etc."
				""
				"&dFirst thing, though. We're going to need to build the device that'll get you to other worlds: The Ancient Teleporter."
				""
				"&5You'll need a few things. Like Ancient Rock. The FOP 'hid' a lot of broken teleporters underground. Around Y 10 to 20. Take this Mineral Finder. It will track a few various useful minerals, and angles a pointer towards them when you are close enough. The color of the pointer matches the color of the Mineral, so look for Black."
			]
			dependencies: ["69C663CDD23190A9"]
			id: "5FC0C65E68336246"
			tasks: [{
				id: "2A26065803FF5667"
				type: "checkmark"
				title: "Staying Out of the Kitchen"
			}]
			rewards: [{
				id: "284F7565A68D5437"
				type: "item"
				item: {
					id: "adfinders:mineral_finder"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
		}
		{
			title: "Stones of Power"
			icon: "aoa3:carved_rune_of_travel"
			x: -1.0d
			y: -1.25d
			shape: "pentagon"
			subtitle: "Infinity They Ain't"
			description: [
				"&dOkay, using that scanner, you should be able to find one of the 'hidden' Ancient Teleporter ruins the FOP hid underground. Air quotes there, because the FOP wants to encourage Power Users to dig up all they can, and send them whatevers found."
				""
				"&5You got better things to do, Bandit. When you find the ruins, most likely all the Power Runes are gone. Grab all the Ancient Stone you can, though, you'll need at least 13 of them."
				""
				"&dYou'll also need five other Runes. Four of these drop from monsters in the Overworld, or sometimes Villagers have them stashed in chests."
				""
				"&5You should also be able to find them in dungeons, mineshafts, temples, etc. The FOP hid them pretty liberally around creatures and places they want you to hunt and explore and break into."
			]
			dependencies: ["5FC0C65E68336246"]
			id: "7C074ABF2EDF12C1"
			tasks: [
				{
					id: "15D5A728E4A614EC"
					type: "item"
					item: "aoa3:ancient_rock"
					count: 13L
				}
				{
					id: "0E9263AC63EA8767"
					type: "item"
					item: "aoa3:carved_rune_of_travel"
				}
				{
					id: "2913E6944A2FA36D"
					type: "item"
					item: "aoa3:carved_rune_of_space"
				}
				{
					id: "424EDE80F5E2D518"
					type: "item"
					item: "aoa3:carved_rune_of_reality"
				}
				{
					id: "4AF96E7F8EDA62A5"
					type: "item"
					item: "aoa3:carved_rune_of_direction"
				}
			]
			rewards: [{
				id: "6C1005BAB66C32F4"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "A Strange Book"
			x: 0.25d
			y: -1.25d
			shape: "hexagon"
			subtitle: "...From a Strange Person"
			description: [
				"&dHmmm, you didn't happen to see anyone around the ruins of that teleporter, did you? I've been trying to find out how to get the 5th Rune you need for the Teleporter, and it looks like he has the key. A.... Corrupted Traveler?"
				""
				"&5That's frustrating. You mean the key to the Teleporter is on an NPC that may not even spawn?"
				""
				"&dProbably not intentionally. They've messed with the world generation enough that these ruins are buried in random stone, so the poor NPC probably just dies."
				""
				"&5Gruesome... wait, if its an NPC can you do something with spellcode, sis?"
				""
				"&dHmmm, actually yeah. Bandit, if you check the Fab Creatures section in the Shop Tablet, I should have something you can purchase."
				""
				"&5Find or spawn a Corrupted Traveller. Then give him some food. Any food."
			]
			dependencies: ["7C074ABF2EDF12C1"]
			id: "76B7D44E338DC9B7"
			tasks: [{
				id: "55006AEA406FF0FF"
				type: "item"
				item: {
					id: "patchouli:guide_book"
					Count: 1b
					tag: {
						"patchouli:book": "aoa3:worn_book"
					}
				}
			}]
			rewards: [{
				id: "44731FDDB12709FC"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Stones and Runes"
			x: 1.75d
			y: -1.25d
			shape: "pentagon"
			subtitle: "Stepping Stones"
			description: [
				"&dOkay, that Worn Book? And that Blank Realmstone the Corrupted Traveller gave you? Important. Each time you open that book and don't have a Blank Realmstone in your inventory, it will spawn one for you. You'll need a whole lot of them..."
				""
				"&5There's a lot of worlds to visit..."
				""
				"&dAlso be sure to start saving up Runium Ore. You should have the Yellow Ore DLC already, otherwise... I'd probably go get it. A bunch of the metals and gems you'll need soon are Yellow Rank."
				""
				"&5You'll need Runium to make the 5th Rune, the Rune of Power. That and an Eye of Ender, which will take some stuff from The Nether to make. May want the Green Ore DLC too...lots of nice materials in the Nether."
				""
				"&dYou'll want them to make better equipment. The next world might be even rougher than The Nether."
			]
			dependencies: ["76B7D44E338DC9B7"]
			id: "10F607F18CE03D39"
			tasks: [
				{
					id: "58C0CDAF1670BC94"
					type: "item"
					item: "aoa3:blank_realmstone"
				}
				{
					id: "2B4B2F0651EEFC4C"
					type: "item"
					item: "aoa3:carved_rune_of_power"
				}
				{
					id: "573597F237A2A7F3"
					type: "item"
					item: "aoa3:runium_ore"
					count: 2L
				}
			]
			rewards: [{
				id: "324481C298B2397F"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "The Gate to Everywhere"
			x: 3.25d
			y: -1.25d
			shape: "pentagon"
			subtitle: "The Right Key in the Right Place"
			description: [
				"&dOkay, to build this teleporter, you'll need to make a frame 5 wide and 6 tall of the Ancient Stones and Runes."
				""
				"&5The Rune of Power MUST be the bottom center block of the entire thing."
				""
				"&dThe other four can be put anywhere else in the frame."
				""
				"&5Don't forget the corners. Unlike the Nether Portal, you must have corners."
				""
				"&dRight Click that Blank Realmstone, you'll see how most of the FOP Game Server is laid out. We should figure out the first world for you to go to..."
				""
				"&5Hm...Leylatia sounds safe for a first journey. And the requirements are simple. Just fall 26 blocks and hit the ground."
				""
				"&dWell, you can't use Feather Fall, or fall into Water, unfortunately. Thankfully you're stuff will be safe in your temporary Gravestone."
			]
			dependencies: ["10F607F18CE03D39"]
			id: "3E2831A2D27654C0"
			tasks: [
				{
					id: "29A99E23734A15F1"
					type: "item"
					item: "aoa3:carved_rune_of_power"
				}
				{
					id: "3305D09B67DA5BD3"
					type: "item"
					item: "aoa3:lelyetia_realmstone"
				}
			]
			rewards: [{
				id: "001A41EB98B1D2AA"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "ADVENT FIGHTS"
			x: -2.25d
			y: 0.25d
			shape: "square"
			description: [
				"&5Hey Bandit, while you are exploring the Overworld and trying to get this Ancient Teleporter up and running, how about I give you a bit of encouragement?"
				""
				"&5Not that you'll need it, but you'll get extra rewards for these tasks. Mostly its hunting down the various Advent of Ascension creatures in each world. "
				""
				"&5And I'll explain if they drop anything interesting! A lot of the equipment you'll need to survive these other worlds can be found either on monsters or by doing various things."
			]
			dependencies: ["5FC0C65E68336246"]
			id: "3E3E6553CBF3C30D"
			tasks: [{
				id: "2A3D2831996727A1"
				type: "checkmark"
				title: "Advent Hunting : Overworld"
			}]
		}
		{
			title: "Ancient Golems"
			x: -4.75d
			y: 1.5d
			shape: "rsquare"
			description: [
				"&5Ancient Golems are old powered mechanical creatures found in Plains type biomes. Careful, they are very hostile and hit pretty hard for a new User."
				""
				"&5The main thing they drop is Rusted Iron Ingots. Not much can be done with these except to Smelt them into some Scrap Metal."
				""
				"&5Like most mechanical creatures in Advent of Ascension, they also drop Power Cores and Armour Plating. Be sure to collect and save these up, you'll need em for making and upgrading some higher tier gear."
			]
			dependencies: ["3E3E6553CBF3C30D"]
			id: "58661D566CCF0B40"
			tasks: [
				{
					id: "5774BA322E78A7A4"
