				"5E574242513BE343"
			]
			id: "69C663CDD23190A9"
			tasks: [{
				id: "30D523C2C4340605"
				type: "item"
				item: "tfb2:shipping_crate_pouch"
				consume_items: true
				weak_nbt_match: true
			}]
		}
		{
			title: "Research for that too?"
			x: -7.915178571428584d
			y: -0.6607142857142847d
			shape: "gear"
			description: [
				"&5Wow, so many useful things are just... locked behind Research and DLC."
				""
				"&dKind of ridiculous, especially when you WANT people to tear out all the resources for you."
				""
				"&5Eh, guess if someone works hard enough to 'earn' it, they'll feel like they HAVE to utilize it as much as possible."
				""
				"&dWe can offer some of the resources in our Shop Tablet that they don't in their DLC shop, but we have to be careful what we pull out through the pipe."
			]
			dependencies: ["69C663CDD23190A9"]
