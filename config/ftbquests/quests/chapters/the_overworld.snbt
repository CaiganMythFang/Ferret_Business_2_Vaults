			}]
		}
		{
			title: "Fishix and Furlions"
			x: -0.75d
			y: 3.5d
			shape: "rsquare"
			description: [
				"&5The Fishix can be found in Swamp type biomes. It's a pretty tough monster, so be careful. It doesn't drop anything unique."
				""
				"&5The Furlion, on the other hand, spawns in Desert and Mesa type biomes. They travel in packs but can be dangerous in singles as well. They drop Furlion Chops, a decent food when cooked."
				""
				"&5Furlions have nothing to do with lions, and don't have fur. Don't ask me, it's weird."
			]
			dependencies: ["3E3E6553CBF3C30D"]
			id: "46050C16A04F0DA4"
			tasks: [
				{
					id: "7E5116795E0D025D"
