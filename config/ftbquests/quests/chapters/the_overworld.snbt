		{
			icon: "pneumaticcraft:stop_worm"
			x: 3.25d
			y: -2.25d
			shape: "gear"
			subtitle: "Portal Dangers"
			description: [
				"&dBandit! When you enter a portal to another world, you need to be very careful."
				""
				"&5The FOP locked off dimension access to their DLC, so it'll stop you on the spot if you try to go into a portal you don't have the DLC for yet."
				""
				"&dThe problem is sometimes it locks you in place and you start vibrating wildly."
				""
				"&5To death in fact."
				""
				"&dSlowly. Slow vibrating death. It's very hard to get out of the portal trap loop without dieing, but you can avoid getting INTO the loop."
				""
				"&5Try walking into the portal slowly. Don't jump, don't run. At least the first time you enter a new portal to make sure you have the DLC."
				""
				"&dI wonder... is that function an accident of the DLC layer.... or by design to have a laugh?"
			]
			dependencies: ["3E2831A2D27654C0"]
			size: 0.75d
			id: "032BF8AA988208DD"
			tasks: [{
				id: "5DD89B0F352E5198"
				type: "checkmark"
				title: "BE CAREFUL!"
			}]
		}
