		{
			title: "A Bounty of Missions"
			icon: "the_vault:bounty_block"
			x: -6.25d
			y: -2.5d
			shape: "rsquare"
			subtitle: "Extra Effort, Extra Loot"
			description: [
				"&dBandit, see those Bounty Pearls you've been finding in Wooden Chests? They're quite useful for creating and using the Bounty Table."
				""
				"&5The Bounty Table is a pretty good way to get some extra resources and gear. It'll ask you to either do something, or submit something to the table for the reward."
				""
				"&dDoing things like killing certain types of monsters in Vaults, or looting an amount of a specific item."
				""
				"&5Though it only counts if the item is from an 'unlooted' chest, mind. "
				""
				"&dSubmitting things is easy too. Just hold it in your hand and Right Click the Bounty Table."
				""
				"&5Oh, and the Table has a slot to store all your Bounty Pearls. You use these to 'reroll' a bounty you don't want by selecting it, the hitting the circular arrow."
			]
			dependencies: ["232779928B96328E"]
			hide_text_until_complete: false
