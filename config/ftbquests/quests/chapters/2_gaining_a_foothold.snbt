		{
			title: "A Guiding Hand"
			icon: "the_vault:vault_compass"
			x: 4.25d
			y: -2.5d
			shape: "rsquare"
			subtitle: "This Thing Says To Go North Left?"
			description: [
				"&dBandit, a helpful tool for navigating Vaults you can Research is the Vault Compass."
				""
				"&5Tis not just a simple Compass that points to the Vault Portal, the Vault Compass is quite powerful. It can point to a variety of things, from special doors to objectives to other things."
				""
				"&dAt first, the Compass can only point to the Vault Portal, but as you explore more Vaults, you'll unlock the ability to point the Compass  at other things."
				""
				"&5Ye can set the target of the Compass outside the Vault for free, but changing it in the middle of a Vault will cost ye 10% of yer Health. (Ye'll get this back after the Vault, of course)"
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
			id: "028DF61EF05F2577"
