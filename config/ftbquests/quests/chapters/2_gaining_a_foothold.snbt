				exclude_from_claim_all: true
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Eggy Surprise"
			x: -2.0d
			y: 2.0d
			shape: "rsquare"
			subtitle: "Is it a Kinder Creature?"
			description: [
				"&dMystery Eggs are a good find if you are having trouble locating certain animals to farm for Vault Crystal costs."
				""
				"&5Aye, a wide variety of peaceful mobs are available from Mystery Eggs, which drop them as 'Spawn Eggs'."
				""
				"&dSome of the Mods you can Research will require these Spawn Eggs to use them, like Cagerium for example."
				""
				"&5Ye can also turn the Mystery Egg into a Hostile version. These ones will drop, well, hostile Spawn Eggs."
				""
				"&dLike it says on the tin, yeah. Zombies, Endermen, etc Spawn Eggs will drop out of these."
			]
			hide_dependency_lines: true
			dependencies: ["50D9EFE8ABEA9779"]
			id: "4AD8ED2C12A8B58D"
			tasks: [
