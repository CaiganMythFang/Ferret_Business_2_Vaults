		{
			title: "Player Versus Player"
			icon: "the_vault:crystal_seal_pvp"
			x: 0.25d
			y: 1.0d
			shape: "rsquare"
			subtitle: "A Fight for the Top"
			description: [
				"&dIf you are playing on a Server and want a bit of competition between yourself and other Players, you can use the &lVault PVP Rock."
				""
				"&5When a second player enters the Vault, a two minute timer will start up and lock the Vault so ye cannot leave. Once the two minutes are up, all players are teleported to random positions in the Vault."
				""
				"&dTo win, you must either be the first person to complete the objective, or be the last player standing. Your reward? A trophy!"
				""
				"&5Death in a PVP Vault will return yer inventory to how it was before ye entered the Vault."
				""
				"&dLooks like you might get a neat trophy for winning one of these?"
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
