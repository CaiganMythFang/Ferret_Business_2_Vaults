		{
			title: "Uniquely Chunked"
			x: 2.75d
			y: 1.0d
			shape: "rsquare"
			subtitle: "Break the Unique to Make the Unique"
			description: [
				"&5There are a wide variety of Uniques that you can find, and each has a special location you can find them."
				""
				"&5But sometimes you get a bad roll on a unique, or you upgrade past a unique and now have no use for it."
				""
				"&5Now when you Recycle a unique, you get Unique Shards, which can be used in the Vault Forge to craft a random Unique."
			]
			hide_dependency_lines: true
