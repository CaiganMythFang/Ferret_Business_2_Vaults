		{
			title: "Steep Infusion"
			x: -5.5d
			y: 1.0d
			shape: "rsquare"
			subtitle: "Let's Give It Power"
			description: [
				"&5Early on, recipes for both Vault Hunters items and Researched items will use basic Vault ingredients. Magic Silk, Vault Diamonds, etc."
				""
				"&5But soon you'll be needing more complex ingredients. Enter the Chromatic Iron Vault Infuser. With this, you can infuse various Vault ingredients together into more powerful resources."
				""
				"&5Recipes have a base ingredient in the left slot, and in the middle slot is the ingredient you infuse into it. The bar below this shows how many you need if you hover over it. "
				""
				"&5When the Choromatic Iron Vault Infuser becomes too slow, you can upgrade it into a Chromatic Steel Vault Infuser instead."
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
