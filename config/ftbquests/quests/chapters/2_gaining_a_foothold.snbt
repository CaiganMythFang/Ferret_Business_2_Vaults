				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Uniquely Found"
			x: 1.75d
			y: 2.0d
			shape: "rsquare"
			subtitle: "Tucked Away for a Rainy Day"
			description: [
				"&dHey Bandit, the FOP added some interesting things lately. Primarily something they call Uniques."
				""
				"&5Aye, uniques are...well, ye can figure out that they are Unique items, pieces of equipment mostly, with unique looks and special stats."
				""
				"&dYou can find them in various ways, usually in specific rooms, or on the Black Market, or in Vendoors."
				""
				"&5And most recently they added these Unique Crates. Ye can find em in those big crates in Factory Rooms, or in the catacombs beneath Village Rooms in the Vaults."
			]
			hide_dependency_lines: true
			dependencies: ["76B7D44E338DC9B7"]
