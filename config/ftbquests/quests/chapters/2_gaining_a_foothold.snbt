				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Rolling Wildly"
			x: -4.5d
			y: 1.0d
			shape: "rsquare"
			subtitle: "Let's Go Gambling!"
			description: [
				"&dThe Wild Focus' primary use is to reroll all the Prefix and Suffix slots on a piece of gear."
				""
				"&5This means what prefix or suffix AND what tier they are. And also can roll an empty slot as well, keep that in mind, Bandit."
				""
				"&dSometimes it isn't worth rerolling a piece unless its a higher rarity."
				""
				"&5Or if you are wanting a specific suffix or prefix to recycle."
				""
				"&dOh, right, Bandit. A good thing to keep in mind is each time you reroll or modify a piece of Vault Gear, you lower its \"Crafting Potential\" stat."
				""
				"&5This makes it more and more expensive to modify!"
			]
			hide_dependency_lines: true
			dependencies: ["6473A9F33F692821"]
			id: "534D269A9450DA3C"
