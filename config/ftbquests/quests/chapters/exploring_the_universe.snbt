				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Storage Helpers"
			icon: "sophisticatedbackpacks:stack_upgrade_tier_1"
			x: -5.25d
			y: 6.25d
			shape: "rsquare"
			subtitle: "Cram More and More and More In!"
			description: [
				"&l&4RESEARCH : &r&4BACKPACK UPGRADES 1"
				""
				"&bHaving more inventory slots is all well and good, Bandit, but that isn't making use of the space effectively!"
				""
				"&bWhile out adventuring, you regularly find lots of one item. But a stack only holds so much. And each stack takes an inventory slot... so why not increase the number of stacks in a slot?"
				""
				"&bThe Stack Upgrade comes in multiple tiers, each one multiplying the number of stacks in a slot. And if you use multiple Stack upgrades, the next one will stack on top of the first, making them even better!"
				""
				"&bTo better utilize Backpack space, if you get a lot of an item that can 'compress' with a 2x2 or 3x3 recipe (like iron ingots into an iron block), then the Compacting Upgrade is your friend! It will automatically compress these items for you."
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "126454FAD4F09736"
			tasks: [
				{
					id: "75F4C8D6622AF9ED"
					type: "item"
					item: "sophisticatedbackpacks:stack_upgrade_tier_1"
				}
				{
					id: "43F4DD8B46FBA36E"
					type: "item"
					item: "sophisticatedbackpacks:compacting_upgrade"
				}
			]
			rewards: [{
				id: "6CBA37FC0B6EB976"
				type: "choice"
				exclude_from_claim_all: true
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Take Out Bag"
			x: -3.25d
			y: 4.25d
			shape: "rsquare"
			subtitle: "Feed Me Seymour"
			description: [
				"&l&4RESEARCH : &r&4BACKPACK UPGRADES 1"
				""
				"&bIf you are on the go and don't got the time to feed yourself (which, to be honest, you are stuck in a video game world, I totally understand, Bandit!) then you can use a Feeding Upgrade to avoid the boring stuff."
				""
				"&bThis Upgrade will automatically feed you food from the Backpack. Plain and simple."
				""
				"&bThough, that makes me wonder... you probably taste things being actually in there. But does it taste the same as in Real Life?"
				""
				"&bMaybe that's why everything tastes like chicken... oh no..."
