				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Dismantle and Diffuse"
			icon: "sophisticatedbackpacks:diffuser_upgrade"
			x: -4.25d
			y: 3.25d
			shape: "rsquare"
			subtitle: "Getting Parts and Pieces"
			description: [
				"&bThere are special Vault machine Upgrades you can add to your Sophisticated Backpack to keep them neat and organized on the go. They are basically portable versions of the regular Vault machine."
				""
				"&bNote that these both work best when filtering for specifics, so that you don't lose excellent Gear or Materials."
				""
				"&bThe first is the Vault Diffuser, which will break down items that have a Soul Value."
				""
				"&bThe second is the Vault Recycler, which will break down Vault Gear."
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "22021C72011DC4BF"
			tasks: [
				{
					id: "1CAD85F2E1F67007"
