		}
		{
			title: "Jingling Treasure Keys"
			x: -5.25d
			y: 3.25d
			shape: "rsquare"
			subtitle: "This one is for the Car...This one is for the lockbox..."
			description: [
				"&bThe FOP have their own special Treasure Keyring thing that lets you store Treasure Keys on it, and it'll automatically choose the right Key (if you have it) and open Treasure doors it's used on."
				""
				"&bBut you can do better with the Activator Upgrade! This'll use the appropriate key from the Backpack this is installed in when you Right Click any Treasure Door."
