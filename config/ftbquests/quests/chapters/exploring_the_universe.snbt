					item: {
						id: "waystones:warp_stone"
						Count: 1b
						tag: {
							Damage: 0
						}
					}
				}
			]
			rewards: [{
				id: "706A163FB6BBC6E3"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "The Stones Themselves"
			x: 0.25d
			y: 3.75d
			shape: "rsquare"
			description: [
				"&bNow, while you've been able to collect various Waystones around the game server, they aren't always plentiful. So, being able to make your own is a good thing."
				""
				"&bYou can set up your Waystone to be Global, meaning all assistants who can see the Waystone."
				""
				"&bA pretty new addition, and give the FOP credit its a good idea, is the Portstone. It lets you put a Waystone deeper into your base, but you can only teleport OUT from the Portstone."
			]
			dependencies: ["3C533A41BD14F645"]
			id: "429DCA169BFD7877"
			tasks: [
				{
					id: "1DF1FBC6F4D512B0"
					type: "item"
					item: "waystones:waystone"
				}
				{
					id: "50A6240FBEFB0C3F"
					type: "item"
					item: "waystones:portstone"
				}
			]
			rewards: [{
				id: "61D595FA272FFD0C"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "More Personal Stones"
			x: 0.25d
			y: 4.75d
			shape: "rsquare"
			description: [
				"&bIf you are wanting to make a bit more of a enclosed Waystone system... one that isn't connected to the 'main' system, then you want to make a Sharestone network."
				""
				"&bSharestones cannot be teleported to with Scrolls or Warp Stones. You can only warp to a Sharestone via another Sharestone, and only if they both are the same color."
				""
				"&bIf you want an even more enclosed system, you'll want to use Warp Plates. When you place it down, it will automatically make an Attuned Shard that connects to that Warp Plate. "
				""
				"&bMake another Warp Plate, and place the Attuned Shard into it. Now that Warp Plate will teleport you to the first one. Or randomly to any Attuned Shard you put into it, as each Warp Plate has space for five Attuned Shards."
				""
				"&bYou can also make extra Attuned Shards in each Warp Plate."
			]
			dependencies: ["3C533A41BD14F645"]
			id: "056BDEB0979B74EF"
			tasks: [
				{
					id: "33B2E6D6BFC53031"
