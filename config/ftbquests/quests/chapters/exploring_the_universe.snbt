		{
			title: "A Leap Up High"
			x: 0.25d
			y: -1.25d
			shape: "rsquare"
			description: [
				"&bThe Ender Staff is a useful tool for traversing uneven terrain. "
				""
				"&bIt lets you launch yourself in the direction you are aiming when you Right Click. Great for leaping back and forth across Ravines, or between mountain peaks when you don't have a good place to use your Grappling Hook."
				""
				"&bDo note though, while you can leap pretty high with this, it doesn't handle landing for you. I suggest some slow fall potions perhaps?"
				""
				"&bYou can also craft it into a Hook Upgrade, which lets you launch yourself with your Grappling Hook by Left Clicking. Great for getting that up high hook point thats JUST out of normal reach."
			]
			dependencies: [
				"71565A62CEF04862"
				"196E6348EEEB900B"
			]
			id: "4C5E1CE68BC0B137"
			tasks: [
				{
					id: "2CC048203A2D3967"
					type: "item"
					item: "grapplemod:launcheritem"
				}
				{
					id: "164648B2EB0984DF"
					type: "item"
					item: "grapplemod:staffupgradeitem"
				}
			]
			rewards: [{
				id: "70B1B6145A50958A"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Hook Modification System"
			x: -0.75d
			y: -2.25d
			shape: "rsquare"
			description: [
				"&bYour Grappling Hooks can be upgraded and modified in a variety of ways, to help you tackle all sorts of terrain."
				""
				"&bFirst you'll need a Base Grappling Hook Upgrade. You can make a variety of upgrades with this, and combine them directly with your Grappling Hook, but there's a better way."
				""
				"&bIf you make a Grappling Hook Modifier block, you can Right Click modifiers onto it to 'install' them, then use the Grappling Hook Modifier block to customize settings on each upgrade."
				""
				"&bYou can then Right Click your Grappling Hook onto the Grappling Hook Modifier block to install them into the Grappling Hook. If you change settings, you just need to update them by Right Clicking it on the block again."
			]
			dependencies: ["71565A62CEF04862"]
			id: "196E6348EEEB900B"
			tasks: [
				{
					id: "2A22925BDFAEAA66"
					type: "item"
					item: "grapplemod:baseupgradeitem"
				}
				{
					id: "31BB424B69823E69"
					type: "item"
					item: "grapplemod:block_grapple_modifier"
				}
			]
			rewards: [{
				id: "4F8DD1BD7FFD86CF"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Safely Falling"
			x: 0.25d
			y: -0.25d
			shape: "rsquare"
			description: [
				"&bUsing Grappling Hooks and similar tools always comes with an inherent risk : that of biffing a hook launch and, as they say, eating dirt. And if you are pretty high up, thats a lot of dirt in your face."
				""
				"&bYou could carry a lot of Slow Fall potions, but that's a lot to keep drinking just to be safe. Lot more things to worry about while adventuring about, right?"
				""
				"&bWell, if you find yourself a pair of Diamond Boots, and get a Slow Fall IV enchant on them, you can bring them over to the Grappling Hook Modifier to transform them into a pair of Long Fall Boots."
				""
				"&bThese will prevent all fall damage as long as you wear them."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "6F9A7BF3D0F5AF2D"
			tasks: [{
				id: "2CF96C310E9FFB8F"
				type: "item"
				item: {
					id: "grapplemod:longfallboots"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
			rewards: [{
				id: "246F80B06AFD1001"
				type: "choice"
				table_id: 2245246540467579945L
			}]
		}
		{
			title: "Attract and Repel"
			x: 0.25d
			y: -2.25d
			shape: "rsquare"
			description: [
				"&bThis pair of upgrades is quite useful if you aren't getting the hang of aiming the Grappling Hook or swinging without smacking into stuff."
				""
				"&bThe Forcefield Upgrade will repel you away from blocks while you are swinging from the Grappling Hook. "
				""
				"&bThe Hook Magnet will make your Hook snap towards blocks you launch it at once it gets close. That way if you are trying to hook a couple blocks way up high, you don't need to have pinpoint accuracy."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "3380CA4756EF7639"
			tasks: [
				{
					id: "55CBFBFE459EDC62"
					type: "item"
					item: "grapplemod:forcefieldupgradeitem"
				}
				{
					id: "4EE3FE3CB03CC1DF"
					type: "item"
					item: "grapplemod:magnetupgradeitem"
				}
			]
			rewards: [{
				id: "70737C3C61DF62B8"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Hooking Better"
			x: -0.75d
			y: -1.25d
			shape: "rsquare"
			description: [
				"&bThe Double Grappling Hook Upgrade lets you fire out two grappling hooks at once. This is great for traversing down ravines, city streets, and more. It also gives you double the chance of hooking a block, since you only need one of them to hook!"
				""
				"&bThe Hook Thrower Upgrade lets you change up how you throw the hook. Reduce gravity so it has less arc, change how you reel it in, and more. "
			]
			dependencies: ["196E6348EEEB900B"]
			id: "5DB8A5CF41732CF2"
			tasks: [
				{
					id: "6EF9153F4B83EFBE"
					type: "item"
					item: "grapplemod:doubleupgradeitem"
				}
				{
					id: "188725278D13F36A"
					type: "item"
					item: "grapplemod:throwupgradeitem"
				}
			]
			rewards: [{
				id: "5E3616458BE7F03E"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Rope Business"
			x: -0.75d
			y: -3.25d
			shape: "rsquare"
			description: [
				"&bThe Rope Grappling Hook upgrade lets you change the length of the rope. "
				""
				"&bThe Swing Upgrade lets you change how strong your rope swinging is, whether you slowly build momentum or immediately start swinging around."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "079D4C3AED5B5919"
			tasks: [
				{
					id: "30AD9F160253CA82"
					type: "item"
					item: "grapplemod:ropeupgradeitem"
				}
				{
					id: "099D26B135758182"
					type: "item"
					item: "grapplemod:swingupgradeitem"
				}
			]
			rewards: [{
				id: "5FB7E478A286367F"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Speeeeed!"
			x: 0.25d
			y: -3.25d
			shape: "rsquare"
			description: [
				"&bThe Motor upgrade attatches a motor to your Hook reel, making it automatically reel in you when it hooks a block. You can modify it in the Modifier to change when it reels in."
				""
				"&bThe Rocket upgrade installs a Rocket booster to your Left Click. Hold it down to start rocketing towards where you are aiming."
				""
				"&bKeep in mind you have limited fuel, and it recharges while you are not Rocket boosting."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "3F8F0852D4403EA7"
			tasks: [
				{
					id: "1F9DDDF1DCBE8438"
					type: "item"
					item: "grapplemod:motorupgradeitem"
				}
				{
					id: "5FD145FCB449BDFB"
					type: "item"
					item: "grapplemod:rocketupgradeitem"
				}
			]
			rewards: [{
				id: "7A6826CE6496B739"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "(Mostly) Unlimited Grapples!"
			x: -0.25d
			y: -4.25d
			shape: "rsquare"
			description: [
				"&bThe Limits Upgrade will unlock the potential of your Modifier block. Most every upgrade you can install has control limits in place..."
				""
				"&b...but you are in a digital world, so those limits can be exceeded to a certain point."
				""
				"&bBy adding the Limits Upgrade, you get a wider range on many of your sliders, as well as some extra options."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "228C93BAC9677708"
			tasks: [{
				id: "3347701E045AF193"
				type: "item"
				item: "grapplemod:limitsupgradeitem"
			}]
			rewards: [{
				id: "42ACEADDEA72B191"
				type: "choice"
				table_id: 818089594093312426L
			}]
		}
		{
			title: "Sleeping Under the Stars"
			x: 1.75d
			y: 3.75d
			shape: "square"
			subtitle: "Mod : Comforts"
			description: [
				"&bIf you're travelling around far from home, it's not always a great idea to sleep in a temporary bed, yeah?"
				""
				"&bBut if you are in dangerous territory at night, it's also not a great idea to just hang around, and its boring to sit inside a hut made of dirt and twigs, jumping at every sound."
				""
				"&bFor that, bring yourself a Sleeping Bag! These comfortable beds won't reset your spawn point out in the wilds, and you can still pass the night quickly and safely!"
				""
				"&bBack at home, you can still sleep under the stars in a comfy Hammock! To set one up, you need two tree trunks, walls, pillars, or otherwise 4 blocks apart. You then Right Click a Rope and Nail onto each side of the wall, then Right Click your Hammock onto one of them to set it up!"
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "4C1D2328FC2ABE81"
			tasks: [
				{
					id: "4FEC23882A9CFC4F"
					type: "item"
					title: "Any Sleeping Bag"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "tfb2:comfort_sleepingbag"
						}
					}
				}
				{
					id: "762BAFE29C396412"
					type: "item"
					title: "Any Hammock"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "tfb2:comfort_hammock"
						}
					}
				}
				{
					id: "2D4B07B5C9FDD6AC"
					type: "item"
					item: "comforts:rope_and_nail"
				}
			]
			rewards: [{
				id: "243AD67628CD0A8A"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Take it With You"
			x: -2.25d
			y: 3.75d
			shape: "square"
			subtitle: "MOD : Backpacked"
			description: [
				"&bEver been adventuring around, find yourself a good set of ruins, and all kind of goodies... and just not had the inventory space for all the goodies? Happens to the best of us!"
				""
				"&bBut what adventurer isn't without a Backpack at least? The FOPGame Server has a single option, but it's quite customizable. It's called Backpacked."
				""
				"&bThe Backpacked backpack gives you three additional rows of inventory space, and it fits conveniently in your Curios slot for a backpack! Once equipped, you can open it by pressing the B key."
				""
				"&bWhen you have your backpack open, you can customize the look with the upper right Customize button. Many of the designs are locked behind achievements and tasks, though..."
				""
				"&bThe Backpack can also be enchanted with a variety of unique enchants."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "14C1EE7794D7D6FC"
			tasks: [{
				id: "3F24267A506836AD"
				type: "item"
				item: "backpacked:backpack"
			}]
			rewards: [{
				id: "3E27CBA85412E682"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Show It Off"
			x: -2.25d
			y: 4.75d
			shape: "rsquare"
			description: [
				"&bMany of the Backpack designs you can unlock look really good, and what adventurer doesn't like showing off their collections?"
				""
				"&bBy putting up a Backpack Shelf, you can put your Backpack on it to show off the design."
				""
				"&bEven better, you can use things like Hoppers to interact with the displayed Backpack!"
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "702F6166212848CD"
			tasks: [{
				id: "1BE333698051E8E3"
				type: "item"
				title: "Any Backpack Shelf"
				item: {
					id: "itemfilters:tag"
					Count: 1b
					tag: {
						value: "tfb2:backpackeds"
					}
				}
			}]
			rewards: [{
				id: "435F760DBDF11C8F"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Exploring with Purpose"
			x: 1.75d
			y: -0.25d
			shape: "square"
			subtitle: "MOD : Nature's Compass"
			description: [
				"&bMany times, you aren't exploring just to explore, sometimes you got a purpose. You need a specific material, or a certain animal, or a new place to build."
				""
				"&bAnd the FOPGame Server's Hex Land layout and large number of biomes makes it tricky to find what you want sometimes."
				""
				"&bSo, the FOP added in a little tool for Users called the Nature's Compass."
				""
				"&bWith it, you can Right Click with it and select a biome you want to find. And the compass will point you that way (usually....)."
				""
				"&bNote that the 'closest' location of the biome may be much, much further than you think..."
			]
			hide_dependency_lines: true
