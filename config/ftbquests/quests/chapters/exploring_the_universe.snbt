	quests: [
		{
			title: "Out and About"
			x: -1.0d
			y: 1.75d
			shape: "octagon"
			description: [
				"&bHey there, Bandit! Name's &lExplorer Eric&r&b, remember me? Nah nah, no worries if you don't remember me, got a mind like a sieve myself for names! Last time I helped you get up to speed in all the little things to help you explore and adventure around the world."
				""
				"&bNow the FOP Game Server might be a digital place, but that doesn't change the basics of exploring, nor the adventuring tips I can give."
				""
				"&bLet me get my adventuring crew together to look over what options the FOP gives you."
			]
			dependencies: ["1D0853ADC7295AEB"]
			id: "45A4E38A1E2BA965"
			tasks: [{
				id: "0B4C05639105EE29"
				type: "checkmark"
			}]
		}
		{
			title: "Finding the Goods"
			x: -3.75d
			y: -0.25d
			shape: "square"
			subtitle: "Mod : Advanced Finders"
			description: [
				"&bNow, when exploring around, as we learned before, you want to be on the lookout for important resources!"
				""
				"&bAbove ground that tends to mean plants to eat, animals to hunt, waters to drink, other waters NOT to drink and to avoid, animals to not disturb, and plants to never touch."
				""
				"&bBut you come across lots of caves and ravines. And especially with the Hex grid world the FOP has, its easier to get lost underground. At least I think so."
				""
				"&bSo, you can use one of these Advanced Finders! There's three types: The Mineral one the bosses probably gave you already, or will shortly."
				""
				"&bThe other two are Metal and Gem Finders. Both really useful. They point you towards clumps of Ore. They show an arrow if the closest Ore, Gem, or Mineral is above or below you."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "4645334A0EDD87AA"
			tasks: [
				{
					id: "4CC1A2321023B818"
					type: "item"
					item: {
						id: "adfinders:metal_finder"
						Count: 1b
						tag: {
							Damage: 0
						}
					}
				}
				{
					id: "079379AD58DC751A"
					type: "item"
					item: {
						id: "adfinders:gem_finder"
						Count: 1b
						tag: {
							Damage: 0
						}
					}
				}
			]
			rewards: [{
				id: "3716413FCD35A6B7"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Reel Em In"
			x: -2.25d
			y: -0.25d
			shape: "square"
			subtitle: "Mod : Advanced Hook Launchers"
			description: [
				"&bTraversing the terrain, especially this crazy Hex world the FOP came up with, can be quite daunting if you don't have wings!"
				""
				"&bThankfully, though, you can use some grappling hooks to travel up and down cliff walls safely! "
				""
				"&bThe FOP Game Server has two uh... 'brands', so to speak. One is Advanced Hook Launchers. The classic Spear Launcher is an all around good one, Bandit."
				""
				"&bLaunch the spear out by Left Clicking, then Left Click again to reel it in. To release the hook, Sneak + Right Click to detatch the hook and reel it back in. You can hook items too, as well as creatures, but note that the Spear will damage them and could make them mad."
				""
				"&bThere's more instructions printed on the hook launchers though. "
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "217F4DD8B93E021B"
			tasks: [{
				id: "6F4A66121558A725"
				type: "item"
				item: {
					id: "adhooks:spear_launcher"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
			rewards: [{
				id: "6D3C0D5B5ACEB2FE"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Get Over Here!"
			x: -2.25d
			y: -1.25d
			shape: "rsquare"
			description: [
				"&bThe Pudge Hook Launcher works a bit differently than the Spear Hook Launcher. "
				""
				"&bWhen you successfully hook a block, the Pudge Hook Launcher will immediately reel you in and launch you towards it, disconnecting the hook in the process."
				""
				"&bIf you hook a creature, you'll reel that creature in towards you instead! It still unhooks immediately, but it won't damage the creature in the process like the Spear Hook Launcher."
			]
			dependencies: ["217F4DD8B93E021B"]
			id: "676D38C4018B1CC1"
			tasks: [{
				id: "18CB5798FA305F56"
				type: "item"
				item: {
					id: "adhooks:pudge_launcher"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
			rewards: [{
				id: "6AF1BB0B37DCD15F"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Webbed Up"
			x: -2.25d
			y: -2.25d
			shape: "rsquare"
			description: [
				"&bThe Webhook Launcher works similarly to both the Spear Hook and Pudge Hook Launchers."
				""
				"&bThe Web Hook can latch onto blocks, items, and creatures, but will not damage them."
				""
				"&bYou can then reel in like with the Spear Hook, either pulling yourself towards the block, or the item or creature towards you."
			]
			dependencies: ["217F4DD8B93E021B"]
			id: "702EFD4A0C131D61"
			tasks: [{
				id: "2DEDDFFED2028F22"
				type: "item"
				item: {
					id: "adhooks:web_launcher"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
			rewards: [{
				id: "30DE10786772E211"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			x: -0.75d
			y: -0.25d
			shape: "square"
			subtitle: "Mod : Grappling Hook Mod"
			description: [
				"&bTraversing the terrain, especially this crazy Hex world the FOP came up with, can be quite daunting if you don't have wings!"
				""
				"&bThankfully, though, you can use some grappling hooks to travel up and down cliff walls safely! "
				""
				"&bThe FOP Game Server has two uh... 'brands', so to speak. One is Grappling Hook Mod. A standard Grappling Hook is a good one to start with."
				""
				"&bYou can launch a hook by Right Clicking. It will attach to a block, but if you hit a creature it will yank the creature towards you and disconnect."
				""
				"&bYou can reel in the line with Sneak + Left Click, or reel it out with Sneak + Right Click. Using WASD lets you swing around."
				""
				"&bIf you Right Click, you unhook the line. Double Right Clicking will immediately throw out a new hook after unhooking."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
