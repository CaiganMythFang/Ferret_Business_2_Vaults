		{
			title: "Stones Show the Way"
			x: -0.75d
			y: 3.75d
			shape: "square"
			subtitle: "MOD : Waystones"
			description: [
				"&bYou've no doubt encountered by now, as I'm pretty sure the FOPGame Server starts you off with one, is Waystones. It's their version of a fast travel system."
				""
				"&bYou can find Waystones in Villages and scattered around the wilderness. Right Clicking one will bind the location in your memory, and as long as the Waystone isn't removed, you can teleport to it via a few different means."
				""
				"&bThe cheapest 'early game' way, aside from using a Waystone to teleport to another Waystone, is the use of Return and Bound Scrolls."
				""
				"&bReturn Scrolls simply teleport you back to the last Waystone you touched."
				""
				"&bBound Scrolls, however, can be Right Clicked onto a Waystone to save that Waypoint's location. Then using the Bound Scroll will teleport you to that saved Waystone."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "49705D26D234B0EB"
			tasks: [
				{
					id: "32AFB9F6FD5CF614"
					type: "item"
					item: "waystones:return_scroll"
				}
				{
					id: "0276D2E5804E3610"
					type: "item"
					item: "waystones:bound_scroll"
				}
			]
			rewards: [{
				id: "7D8BA8C83E1FDF85"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Back to Hearth, Back to Stone"
			x: -0.75d
			y: 4.75d
			shape: "rsquare"
			description: [
				"&bIf you want more control over where your teleports take you, create a Warp Scroll. These let you choose any Waystone in your list."
				""
				"&bThe Warp Stone is a more permant version of the Warp Scroll. The downside is there is a 5 minute cooldown between uses."
			]
			dependencies: ["49705D26D234B0EB"]
			id: "3C533A41BD14F645"
			tasks: [
				{
					id: "2DDC2C5A5A3EBD4D"
