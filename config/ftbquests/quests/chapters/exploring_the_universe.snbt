		}
		{
			title: "(Mostly) Unlimited Grapples!"
			x: -0.75d
			y: -3.75d
			shape: "rsquare"
			description: [
				"&bThe Limits Upgrade will unlock the potential of your Modifier block. Most every upgrade you can install has control limits in place..."
				""
				"&b...but you are in a digital world, so those limits can be exceeded to a certain point."
				""
				"&bBy adding the Limits Upgrade, you get a wider range on many of your sliders, as well as some extra options."
			]
			dependencies: ["196E6348EEEB900B"]
			id: "228C93BAC9677708"
