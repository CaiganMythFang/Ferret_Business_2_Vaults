		}
		{
			title: "Sleeping Under the Stars"
			x: -4.75d
			y: -2.25d
			shape: "diamond"
			subtitle: "MOD : Comforts (@comforts)"
			description: [
				"&bIf you're travelling around far from home, it's not always a great idea to sleep in a temporary bed, yeah?"
				""
				"&bBut if you are in dangerous territory at night, it's also not a great idea to just hang around, and its boring to sit inside a hut made of dirt and twigs, jumping at every sound."
				""
				"&bFor that, bring yourself a Sleeping Bag! These comfortable beds won't reset your spawn point out in the wilds, and you can still pass the night quickly and safely!"
				""
				"&bBack at home, you can still sleep under the stars in a comfy Hammock! To set one up, you need two tree trunks, walls, pillars, or otherwise 4 blocks apart. You then Right Click a Rope and Nail onto each side of the wall, then Right Click your Hammock onto one of them to set it up!"
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "4C1D2328FC2ABE81"
			tasks: [
				{
					id: "2D4B07B5C9FDD6AC"
					type: "item"
					item: "comforts:rope_and_nail"
				}
				{
					id: "19524385EFAA3280"
					type: "checkmark"
					title: "ADD SLEEPING BAGS TAG"
				}
			]
			rewards: [{
				id: "243AD67628CD0A8A"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Take it With You"
			icon: {
				id: "sophisticatedbackpacks:backpack"
				Count: 1b
				tag: {
					inventorySlots: 27
					upgradeSlots: 2
					renderInfo: {
						upgradeItems: [
							{
								id: "minecraft:air"
								Count: 1b
							}
							{
								id: "minecraft:air"
								Count: 1b
							}
						]
					}
					contentsUuid: [I;
						-304349604
						499729053
						-1367077136
						1539587766
					]
				}
			}
			x: -2.25d
			y: 3.25d
			shape: "square"
			subtitle: "MOD : Sophisticated Backpacks (@sophisticatedbackpacks)"
			description: [
				"&bEver been adventuring around, find yourself a good set of ruins, and all kind of goodies... and just not had the inventory space for all the treasure? Happens to the best of us!"
				""
				"&bBut what adventurer isn't without a Backpack at least? The FOPGame Server has a single option, but it's quite customizable. It's called Sophisticated Backpacks!"
				""
				"&bThe Sophisticated Backpacks come in multiple tiers, and the first tier (the Pouch) gives you 3 extra rows of inventory space!"
				""
				"&bWith your Backpack open, you'll see there's slots on the left side for Upgrades. The bigger the Backpack, the more Upgrades you can use!"
				""
				"&bWhen you add an Upgrade, like say the Pickup Upgrade, new tabs will appear at the right side to customize those Upgrades."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "14C1EE7794D7D6FC"
			tasks: [
				{
					id: "3F24267A506836AD"
					type: "item"
					item: "sophisticatedbackpacks:backpack"
				}
				{
					id: "57A3E85857C45C53"
					type: "item"
					item: "sophisticatedbackpacks:pickup_upgrade"
				}
			]
			rewards: [{
				id: "3E27CBA85412E682"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Two Pouches, Four Pouches!"
			icon: "sophisticatedbackpacks:iron_backpack"
			x: -2.25d
			y: 4.25d
			shape: "rsquare"
			subtitle: "Ah Ah Ah!"
			description: [
				"&4&lRESEARCH : &r&4DOUBLE POUCHES"
				"&4&lRESEARCH : &r&4BELTS"
				""
				"&bAs you explore more, and run more Vaults, you'll no doubt be wanting more space for treasure!"
				""
				"&bSure, you could just fill your inventory with Pouches, but then you'd need to make Upgrades for, and set up, every pouch. That's so much work!"
				""
				"&bThink smarter AND harder, thats the exploration motto. Each tier of the Sophisticated Backpacks not only adds more inventory space, they also add more Upgrade slots!"
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "702F6166212848CD"
			tasks: [
				{
					id: "2A9664742ACB97D8"
					type: "item"
					item: "sophisticatedbackpacks:iron_backpack"
				}
				{
					id: "0F7CB99B765A3D28"
					type: "item"
					item: "sophisticatedbackpacks:gold_backpack"
				}
			]
			rewards: [{
				id: "253DB51BD1B18871"
				type: "choice"
				exclude_from_claim_all: true
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Exploring Nature"
			x: -2.5d
			y: 1.75d
			shape: "square"
			subtitle: "MOD : Nature's Compass (@naturescompass)"
			description: [
				"&bMany times, you aren't exploring just to explore, sometimes you got a purpose. You need a specific material, or a certain animal, or a new place to build."
				""
				"&bAnd the FOPGame Server's somewhat erratic world generation layout and large number of biomes makes it tricky to find what you want sometimes."
				""
				"&bSo, the FOP added in a little tool for Users called the Nature's Compass."
				""
				"&bWith it, you can Right Click with it and select a biome you want to find. And the compass will point you that way (usually....)."
				""
				"&bNote that the 'closest' location of the biome may be much, much further than you think..."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "6F7447898395A047"
			tasks: [{
				id: "5B4BEE01DAB32D01"
