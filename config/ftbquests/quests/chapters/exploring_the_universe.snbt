					tag: { }
				}
			}]
			rewards: [{
				id: "71C4D2D95F666CFB"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Stones Show the Way"
			x: -0.25d
			y: 3.25d
			shape: "square"
			subtitle: "MOD : Waystones (@waystones)"
			description: [
				"&4&lRESEARCH: &r&4WAYSTONES"
				""
				"&bYou've no doubt encountered by now, if you've been visiting Villages, is Waystones. It's the FOP Game Server's basic version of a fast travel system."
				""
				"&bYou can find Waystones in Villages and scattered around the wilderness. Right Clicking one will bind the location in your memory, and as long as the Waystone isn't removed, you can teleport to it via a few different means."
				""
				"&bUnlocking the Research enables you to craft your own Waystones, and other Waystone adjacent tools."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "49705D26D234B0EB"
			tasks: [{
				id: "5E53C2EB5BCF9C17"
				type: "item"
				item: "waystones:waystone"
			}]
			rewards: [{
				id: "7D8BA8C83E1FDF85"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Back to Hearth, Back to Stone"
			x: -0.25d
			y: 4.25d
			shape: "rsquare"
			description: [
				"&bIf you want more control over where your teleports take you, create a Warp Stone. This lets you choose any Waystone in your list."
				""
				"&bThere will be a cooldown after you use it, however."
			]
			dependencies: ["49705D26D234B0EB"]
			id: "3C533A41BD14F645"
			tasks: [{
				id: "3E788348096D3500"
				type: "item"
				item: {
					id: "waystones:warp_stone"
					Count: 1b
					tag: {
						Damage: 0
					}
				}
			}]
			rewards: [{
				id: "706A163FB6BBC6E3"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "The Stones Themselves"
			x: -0.75d
			y: 5.25d
			shape: "rsquare"
			description: [
				"&bNow, while you've been able to collect various Waystones around the game server, they aren't always plentiful. So, being able to make your own is a good thing."
				""
				"&bYou can set up your Waystone to be Global, meaning all assistants who can see the Waystone."
				""
				"&bA pretty new addition, and give the FOP credit its a good idea, is the Portstone. It lets you put a Waystone deeper into your base, but you can only teleport OUT from the Portstone."
			]
			dependencies: ["3C533A41BD14F645"]
