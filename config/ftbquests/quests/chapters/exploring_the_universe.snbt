		}
		{
			title: "A Leap Up High"
			icon: "grapplemod:staffupgradeitem"
			x: 0.25d
			y: -3.75d
			shape: "rsquare"
			description: [
				"&bThe Ender Staff is a useful tool for traversing uneven terrain. "
				""
				"&bIt lets you launch yourself in the direction you are aiming when you Right Click. Great for leaping back and forth across Ravines, or between mountain peaks when you don't have a good place to use your Grappling Hook."
				""
				"&bDo note though, while you can leap pretty high with this, it doesn't handle landing for you. I suggest some slow fall potions perhaps?"
				""
				"&bYou can also craft it into a Hook Upgrade, which lets you launch yourself with your Grappling Hook by Left Clicking. Great for getting that up high hook point thats JUST out of normal reach."
			]
			dependencies: [
				"71565A62CEF04862"
				"196E6348EEEB900B"
			]
			id: "4C5E1CE68BC0B137"
			tasks: [
