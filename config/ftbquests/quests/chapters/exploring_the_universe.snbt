					type: "item"
					item: "sophisticatedbackpacks:refill_upgrade"
				}
				{
					id: "6AFC3EBFC8F1A6CE"
					type: "item"
					item: "sophisticatedbackpacks:tool_swapper_upgrade"
				}
			]
