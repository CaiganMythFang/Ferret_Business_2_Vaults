		{
			x: -0.25d
			y: 0.25d
			shape: "square"
			subtitle: "MOD : Grappling Hook Mod (@grapplemod)"
			description: [
				"&l&4RESEARCH : &r&4TRAVERSAL"
				""
				"&bTraversing the terrain, especially whatever crazy lands the FOP digitized, can be quite daunting if you don't have wings!"
				""
				"&bThankfully, though, you can use some grappling hooks to travel up and down cliff walls safely! "
				""
				"&bThe FOP Game Server has Grappling Hooks to get around by hand...or by rope I guess?"
				""
				"&bYou can launch a hook by Right Clicking. It will attach to a block, but if you hit a creature it will yank the creature towards you and disconnect."
				""
				"&bYou can reel in the line with Sneak + Left Click, or reel it out with Sneak + Right Click. Using WASD lets you swing around."
				""
				"&bIf you Right Click, you unhook the line. Double Right Clicking will immediately throw out a new hook after unhooking."
			]
			hide_dependency_lines: true
			dependencies: ["45A4E38A1E2BA965"]
			id: "71565A62CEF04862"
			tasks: [{
				id: "5B061C4E2F977DE8"
				type: "item"
				item: {
					id: "grapplemod:grapplinghook"
					Count: 1b
					tag: {
						Damage: 0
						custom: {
							doublehook: 0b
							motor: 0b
							phaserope: 0b
							attract: 0b
							rocket: 0b
							hookgravity: 1.0d
