				type: "choice"
				exclude_from_claim_all: true
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Tank of Your Own"
			icon: "sophisticatedbackpacks:tank_upgrade"
			x: -5.25d
			y: 4.25d
			shape: "rsquare"
			subtitle: "A Camelback And Then Some"
			description: [
				"&l&4RESEARCH : &r&4MISC BAG UPGRADES"
				""
				"&bWith the Pump and Tank Upgrades, you can turn part of your Backpack into a Liquid Tank! "
				""
				"&bThese let you move and store liquids to and from your Backpack, using the Tank as storage space."
				""
				"&bWith the Experience Pump, you can use the Tank to store Experience from yourself instead of another liquid."
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "7E850D23CFBC4CE1"
			tasks: [
				{
					id: "0695CE69DD3ABD83"
