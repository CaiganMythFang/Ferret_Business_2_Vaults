				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Identify Everything"
			icon: "sophisticatedbackpacks:identification_upgrade"
			x: -3.25d
			y: 3.25d
			shape: "rsquare"
			subtitle: "Roll and Open That Box"
			description: [
				"&bExploring and looting Vaults gets you two major things : materials to craft with, and Gear to run Vaults better with!"
				""
				"&bBut as you get better at exploring, looting, and going faster in Vaults, you'll start amassing more materials and more Gear each run, which take longer to open up and identify."
				""
				"&bEnter the Vault Opener and Vault Identifier upgrades!"
				""
				"&bThe Vault Opener will open up those Jewel Bags and Card Booster Packs for you, while the Vault Identifier will examine any Unidentified Gear that enters that Backpack."
				""
				"&bIf you combine these with Filters and other Vault Backpack Upgrades, you can get a nice little automated setup that breaks down low tier Gear for you!"
			]
			dependencies: ["14C1EE7794D7D6FC"]
			id: "6312DE91EE254E18"
