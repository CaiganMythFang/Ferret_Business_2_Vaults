		{
			title: "A Spooky Mannequin"
			x: -2.0d
			y: -2.0d
			shape: "rsquare"
			subtitle: "MOD : Mannequins (@mannequins)"
			description: [
				"&7So, the code of the Liminal Mall, when it was the Grand Mall, included having random NPCs wander around to make it feel even more lively."
				""
				"&7When it was shut down, the code was left and eventually got corrupted somehow."
				""
				"&7Now, occasionally, you'll find these strange mannequin showing up. They are harmless...I think."
			]
			dependencies: ["3EB5B79FC05245E2"]
			id: "3C45BDE9A39CC61C"
