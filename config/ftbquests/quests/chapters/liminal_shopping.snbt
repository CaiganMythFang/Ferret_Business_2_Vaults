		{
			title: "Emergency Return Home"
			icon: "minestuck:skaia_portal"
			x: -0.75d
			y: 3.25d
			shape: "heart"
			description: [
				"&7Bandit, I've included this as a way to return to the Overworld in case you forgot to bring a way back home."
				""
				"&7You can find Strange Coins by searching the various abandoned shops and bases."
				""
				"&7Usually you'll use these on the mysterious vending machines you can find around, but in a pinch I can use it to quietly teleport you home without the FOPGame Server security tripping."
			]
			hide_dependency_lines: true
			dependencies: ["16A325B14A4EBB16"]
			hide: true
			can_repeat: true
			id: "6EBC0C16B0CE2E94"
			tasks: [{
