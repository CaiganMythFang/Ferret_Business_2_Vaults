	quests: [
		{
			title: "Living Dead Mall"
			icon: "tfb2:liminal_coin"
			x: -0.75d
			y: 2.0d
			shape: "hexagon"
			subtitle: "Catch a Ride to the Mall"
			description: [
				"&7In the previous iteration of the FOPGame Server, players could only build houses or run shops in a special dimension."
				""
				"&7They called it The Grand Mall. It was endless, always growing as more players opened shops and built bases."
				""
				"&7When the FOPGame Server went offline to blend in the Vault Hunters game, they no longer needed the Grand Mall, so it could no longer be accessed."
				""
				"&7But its still here, just....abandoned. When we first found it, we renamed it the Liminal Mall. It felt appropriate."
				""
				"&7Want to check it out yourself? Make these Liminal Tiles, and place them down between height Y73 and Y80. Then place a bed on top of the tiles, and surround the bed with Skulls (usually Skeleton). Then take a nap."
				""
				"&7Bring yourself another set of tiles, bed, and skulls to make a way back home...or a Waystone or something else similar. You might be searching for a while to get the materials to return home."
			]
			dependencies: ["45D2E30FD73E062E"]
			id: "16A325B14A4EBB16"
			tasks: [{
				id: "48D3A7528E83C5B5"
				type: "item"
				item: "tfb2:liminal_tile"
				count: 2L
			}]
		}
