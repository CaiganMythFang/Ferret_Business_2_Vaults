		{
			title: "A Few Lines Difference"
			x: -0.25d
			y: 2.75d
			shape: "square"
			subtitle: "MOD : Rechiseled (@rechiseled)"
			description: [
				"&eIt's quite amazing the difference a few lines can make in a design. As simple as an extra line here, a removed line there, and it feels brand new."
				""
				"&eYou can take Rechiseled for example. Just some simple line changes and you have a good variety with a single block."
				""
				"&eJust make a Chisel, and Right Click with it. You can then put in stone, wool, wood, etc and many of them will have Rechiseled varieties of designs."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
