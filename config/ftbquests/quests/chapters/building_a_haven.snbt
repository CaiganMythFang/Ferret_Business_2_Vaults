				table_id: 5632731352558517809L
			}]
		}
		{
			title: "By Bit and Piece"
			x: 3.75d
			y: -0.75d
			shape: "square"
			subtitle: "MOD : Chisels and Bits"
			description: [
				"&eEver look at some stairs, or a slab, and wish you could make a bit more of a...unique shape? The standard blocks in the FOPGame Server feel pretty limited, as they do in many games."
				""
				"&eOne of the things the FOP took from our own games is a system called Chisels and Bits. It lets you break down a block into a 16x16x16 pile of Bits."
				""
				"&eTo do so, you'll need a Chisel. Chisels and Bits offers a variety of Chisels, which you can use to Chisel bits out of placed Blocks by Left Clicking. These bits can be placed back themselves, or used to create whole new Blocks, with the shapes you want!"
				""
				"&eHolding a Chisel and holding R will bring up a menu for how you carve out Bits. If you want to see if a block can be Chiseled, hold a Magnifying Glass and look at it. "
				""
				"&eTo keep your inventory tidy(16x16x16 is a LOT), make a Chiseled Bit Bag."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "310FC85A5C9BA1B7"
			tasks: [
				{
					id: "67EAC9E37BC8AF48"
					type: "item"
					item: {
						id: "chiselsandbits:chisel_stone"
						Count: 1b
						tag: {
							Damage: 0
						}
					}
				}
				{
					id: "697C6ED5107EC4AD"
					type: "item"
					item: "chiselsandbits:magnifying_glass"
				}
				{
					id: "7869C7EBC3610D32"
					type: "item"
					item: {
						id: "chiselsandbits:bit_bag"
						Count: 1b
						tag: {
							Inventory: { }
						}
					}
				}
			]
			rewards: [{
				id: "06A1C7ED36C3DA17"
