			}]
		}
		{
			title: "A Good Design Forever"
			x: 4.75d
			y: -1.25d
			shape: "rsquare"
			description: [
				"&eSo, you've made yourself a killer designed block with Chisels and Bits... but how do you make MORE of it? That's where Patterns come in!"
				""
				"&ePut some Paper in your Offhand, and hold a Quill. Then look at the Chisels and Bits block, and hold Right Click to start copying the pattern to get a Simple Pattern."
				""
				"&eThis pattern can be used to place out a copy of the block one time. You can change how it places the new block by holding R to get the options menu."
				""
				"&eWant to keep that Pattern for multiple uses? Then get some Sealant. Hold the Pattern in your Offhand, then hold Right Click with the Sealant to seal the Pattern."
				""
				"&eIf you want to remove Sealant on a Pattern, use Sealant Remover the same way as adding Sealant."
			]
			dependencies: ["310FC85A5C9BA1B7"]
			id: "4245C58C1F608F89"
			tasks: [
				{
					id: "048BA78B09D37959"
