			}]
		}
		{
			title: "Bit o' Magic"
			x: 1.25d
			y: 3.75d
			shape: "rsquare"
			description: [
				"&eQuark adds a variety of little magical things that are quite nice, I must say. Even if they fall outside of the 'base construction' thing, they each have a decorative or similar purpose."
				""
				"&eDeep underground, you may find a Stoneling. You can sneak up to it while holding a Glowshroom. Killing it gets you a Heart of Diamond, which makes a Pickarang, a useful magical throwing mining tool."
				""
				"&eIn the Nether, Wraiths haunt certain Soul Sand biomes, and drop a Soul Bead. Much like an Eye of Ender, when Right Clicked with a Soul Bead, it will float out towards the nearest Nether Fortress."
				""
				"&eRunes can be found as loot and crafted. When combined with an enchanted item, the glow on the item will change colors to the Rune's color."
			]
			dependencies: ["4DC50AC316891B1D"]
			id: "2E45A2A4BED1033E"
			tasks: [
				{
					id: "4ABF787BDCCBCA21"
					type: "item"
					item: {
						id: "quark:pickarang"
						Count: 1b
						tag: {
							Damage: 0
						}
					}
				}
				{
					id: "1B4F0002995B320A"
					type: "item"
					item: "quark:soul_bead"
				}
				{
					id: "414AF697F270A93D"
					type: "item"
					title: "Any Quark Rune"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "quark:runes"
						}
					}
				}
			]
			rewards: [{
