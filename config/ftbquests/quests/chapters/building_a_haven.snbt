				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Your Lights, Your Style"
			x: 1.25d
			y: 0.75d
			shape: "rsquare"
			description: [
				"&eAs you can already see, Fairy Lights are fairly customizable to your design needs. But there's a few things you may like to know!"
				""
				"&eIf you combine a Fairy Light with a Gold Nugget and one or more Dyes, you'll get a Color Changing Fairy Light that will cycle through the different colors!"
				""
				"&eWant some extra sparkle? Then craft a Fairy Light with some Glowstone Dust to make it Twinkle!"
				""
				"&eAs for the hung up strings themselves, you can adjust how much slack there is. Right Click with some String to make it droop down more, or Right Click with a Stick to shorten the length."
				""
				"&eOh, and if you want to turn the Fairy Lights off or back on? Just Right Click them."
			]
			dependencies: ["584C2E55F0843EFA"]
			id: "2B7E4D4FFF718D85"
			tasks: [
				{
					id: "1D8D52206EA7299E"
					type: "item"
					item: "minecraft:gold_nugget"
				}
				{
					id: "5AD73AB2F1601E9D"
					type: "item"
					item: "minecraft:glowstone_dust"
				}
			]
			rewards: [{
				id: "02231BA41CF16721"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "A Little Bit of Everything"
			x: 0.25d
			y: 2.75d
			shape: "square"
			subtitle: "MOD : Quark"
			description: [
				"&eBandit, a bunch of us researchers were debating on where to cover this FOPGame Server brand. It kind of covers a little bit of everything, but we agreed to put it into my section. "
				""
				"&eAnyways, its called Quark. It adds a lot of new decorative and functional blocks and items, and also tweaks some of the vanilla core systems in the FOPGame Server."
				""
				"&eTake the Iron Rod for example. You can place it in front of a Piston, and blocks it is pushed into will be mined (but only if they could have been pushed by the Piston itself)"
				""
				"&eOr, looking for good deco? Try a comfy Stool. Or a colored Item Frame. Or, even better, the Glass frame goes invisible to show ONLY the item in it!"
				""
				"&eOh, you can also add Glowstone to the Glass Item Frame to make the item in it really stand out."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "4DC50AC316891B1D"
			tasks: [
				{
					id: "1E23BC1C87E8B453"
					type: "item"
					item: "quark:iron_rod"
				}
				{
					id: "05E3072D065E1052"
