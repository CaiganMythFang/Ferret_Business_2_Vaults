			}]
		}
		{
			title: "Other Stringed Designs"
			x: 1.25d
			y: -0.25d
			shape: "rsquare"
			description: [
				"&eOther than Lights, you can hang a few other things!"
				""
				"&eLetter Bunting lets you put up those strings of HAPPY BIRTHDAY or other celebratory messages. Though you could do some creepy things for a haunted house...hmmmm ideas... Oh, well, you customize the message, even the colors of each letter, when you string them up!"
				""
				"&eOh, for more Christmassy designs, you have the classic Tinsel and Vine Garlands you can hang up."
			]
			dependencies: ["584C2E55F0843EFA"]
			id: "264CF73374EFA726"
			tasks: [
				{
					id: "6193747112D6C566"
					type: "item"
