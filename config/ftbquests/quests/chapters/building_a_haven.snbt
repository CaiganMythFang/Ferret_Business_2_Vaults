			}]
		}
		{
			title: "Light in the Darkness"
			x: -4.5d
			y: 2.25d
			shape: "rsquare"
			description: [
				"&eIf you are wanting to light up an area to stop dangerous creatures from appearing, and so you can also see, deploy a Feral Flare Lantern."
				""
				"&eThe Feral Flare Lantern will place invisible lights wherever it is a bit too dark. "
				""
				"&eIf you remove the Feral Flare Lantern, sometimes the lights will stick around. You can use a Frozen Pearl to clear them out in an area around you."
			]
			dependencies: ["15C4DE355F5089D1"]
			id: "57817B34A9841285"
			tasks: [
				{
					id: "251EF8BB50ECE7C1"
