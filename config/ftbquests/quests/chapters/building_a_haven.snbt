				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Extra Tools and Bits"
			x: 4.75d
			y: -0.25d
			shape: "rsquare"
			description: [
				"&eNow, you can make Bits out of any solid block...did you know you can do the same with Fluids? Just put some Fluid into a Chiseled Bit Storage and Right Click it to remove some Bits. They will be animated with the liquid!"
				""
				"&eThe Wrench is used to rotate your placed Chisels and Bits blocks around."
				""
				"&eThe Tape measure is good for measing out how many Bits you'll need for larger areas. Right Click the first Bit on a block, then Right Click the other corner, and you'll get a visual showing you the size of the area."
			]
			dependencies: ["310FC85A5C9BA1B7"]
			id: "6F078DF7D44AF0EE"
			tasks: [
				{
					id: "00A011358A819F97"
