		{
			title: "Serene Panoramas"
			icon: "xercapaint:item_palette"
			x: -4.75d
			y: -0.25d
			shape: "square"
			subtitle: "MOD : Joy of Painting (@xercapaint)"
			description: [
				"&eWhile the FOPGame Server has many paintings you can use for decorating your house or base, sometimes you want to try your own hand at painting."
				""
				"&eEnter Joy of Painting, which...well, it's obvious what they took the name from. But with it, you can paint your own pixel paintings right in the game itself."
				""
				"&eTo start with, you'll need a Palette, which is crafted with three Planks in a row, and up to 6 dyes above it. You can add more dyes after, and mix them on the right side of the Palette to make custom colors. The left side holds all 16 default colors, and the right side has all your custom colors."
				""
				"&eYou can then set out an Easel, and put a Canvas on it. Then Right Click you Palette onto the Canvas to start painting!"
				""
				"&eWhen you are done, Sneak + Right Click the Canvas with an empty hand to remove it and hang it up elsewhere."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "58753DA18415EBDA"
			tasks: [
				{
					id: "0D666D71D9CEF753"
					type: "item"
					item: "xercapaint:item_palette"
				}
				{
					id: "2BEF824B59956E43"
					type: "item"
					item: "xercapaint:item_canvas"
				}
				{
					id: "783706B29ABA942C"
					type: "item"
					item: "xercapaint:item_easel"
				}
			]
			rewards: [{
				id: "6EDF60D97C8BD59B"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Going Up"
			x: -3.25d
			y: 2.75d
			shape: "square"
			subtitle: "MOD : Elevator Mod (@elevatorid)"
			description: [
				"&4&lRESEARCH : &r&4ELEVATORS"
				""
				"&eBeing able to make large bases without worrying about architectual concerns like support pillars, etc can make for some fantastic designs...."
				""
				"&eBut it also can make it quite difficult to design staircases that go to all the floors that also look nice... or that don't take lots of room themselves."
				""
				"&eEnter the handy dandy magical Elevator. By placing one of these down, then another above or below it at any distance (even with blocks in between them!), you can teleport between them just by Jumping or Sneaking."
				""
				"&eYou can even Right Click the Elevator with an empty hand to configure which way you face when you teleport to that Elevator. Then you can Right Click any block onto the Elevator to disguise it."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "346A39F3E5E0AA7D"
			tasks: [{
				id: "25B8696EA20DC1E4"
				type: "item"
				title: "Any Color Elevator"
				item: {
					id: "itemfilters:tag"
					Count: 1b
					tag: {
						value: "elevatorid:elevators"
					}
				}
			}]
			rewards: [{
				id: "795CB37E26218E27"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Framed in Style"
			icon: "blockcarpentry:frameblock"
			x: -0.25d
			y: -0.25d
			shape: "square"
			subtitle: "MOD : BlockCarpentry (@blockcarpentry)"
			description: [
				"&eNow, most blocks in the FOPGame Server only have a couple of shapes (if you are lucky). Block, stairs, slab. If its wood, it probably has a Door, Trap Door, and maybe Fences and Fence Gates. But not all the time, right?"
				""
				"&eSo instead of bothering with making versions for each Block material, a brand was introduced to cover missing shapes, and add new shapes to build with : Block Carpentry"
				""
				"&eStarting with the Frame Block, you can use it to build a quick structure. Then, you take a solid block, like say Bricks, and Right Click it onto a bare Frame Block to 'camo' it as that block. Want it to make light? Right Click some Coal, Charcoal, or Glowstone Dust onto it too."
				""
				"&eYou can take a Hammer from BlockCarpentry and Right Click the Frame Block to remove the Camo."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "5BA547287C13B0F1"
			tasks: [
				{
					id: "626AAEB10DF61FC1"
					type: "item"
					item: "blockcarpentry:frameblock"
				}
				{
					id: "5F48BF8DB0451E4B"
					type: "item"
					item: "blockcarpentry:hammer"
				}
			]
			rewards: [{
				id: "355F56A6740B6FC6"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Framing Accurately"
			icon: "blockcarpentry:illusion_block"
			x: 0.75d
			y: -0.25d
			shape: "rsquare"
			description: [
				"&eFrame Blocks come in many shapes, but each shape has two versions : normal and Illusion."
				""
				"&eIllusion blocks are different than normal Frame Blocks, primarily in that they 'copy' the model of the block, not just the textures. For example, a Furnace has a different top and sides, and that'll match up in an Illusion Block."
				""
				"&eYou can see it best if you use a Texture Wrench. You can use it to change the texture on each side of a normal Frame Block, but if you use it on an Illusion Block, you rotate the whole block instead."
			]
			dependencies: ["5BA547287C13B0F1"]
			id: "1EBB7D36D3AE7C34"
			tasks: [
				{
					id: "54AEFF1FF6E68CAC"
					type: "item"
					item: "blockcarpentry:texture_wrench"
				}
				{
					id: "4C4E06F588812423"
					type: "item"
					item: "blockcarpentry:illusion_block"
				}
			]
			rewards: [{
				id: "01D6CCB2B87A3B18"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "More Frame Tools"
			icon: "blockcarpentry:paintbrush"
			x: 1.75d
			y: -0.25d
			shape: "rsquare"
			description: [
				"&eAlong with the Wrench, you have two other tools to customize your Frame Blocks."
				""
				"&eThe Chisel lets you cycle through certain Frame Block designs. Not all Frame Blocks have alternate designs though!"
				""
				"&eThe Paintbrush lets you color special parts of some Frame Blocks. Things like the glass on windows, or the fabric on Beds."
				""
				"&eYou can also increase the Blast Resistance of Frame Blocks a little by Right Clicking a Flint onto them, or increase a LOT by using an Obsidian Compound Chunk!"
			]
			dependencies: ["5BA547287C13B0F1"]
			id: "22109511478BB0A6"
