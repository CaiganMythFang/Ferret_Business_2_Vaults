			}]
		}
		{
			title: "Serene Panoramas"
			x: -3.5d
			y: -3.0d
			shape: "square"
			subtitle: "MOD : Joy of Painting"
			description: [
				"&eWhile the FOPGame Server has many paintings you can use for decorating your house or base, sometimes you want to try your own hand at painting."
				""
				"&eEnter Joy of Painting, which...well, it's obvious what they took the name from. But with it, you can paint your own pixel paintings right in the game itself."
				""
				"&eTo start with, you'll need a Palette, which is crafted with three Planks in a row, and up to 6 dyes above it. You can add more dyes after, and mix them on the right side of the Palette to make custom colors. The left side holds all 16 default colors, and the right side has all your custom colors."
				""
				"&eYou can then set out an Easel, and put a Canvas on it. Then Right Click you Palette onto the Canvas to start painting!"
				""
				"&eWhen you are done, Sneak + Right Click the Canvas with an empty hand to remove it and hang it up elsewhere."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "58753DA18415EBDA"
			tasks: [
				{
					id: "0D666D71D9CEF753"
					type: "item"
					item: "xercapaint:item_palette"
				}
				{
					id: "2BEF824B59956E43"
