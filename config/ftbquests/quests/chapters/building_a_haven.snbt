			}]
		}
		{
			title: "Internet Famous"
			x: -6.25d
			y: -0.75d
			shape: "square"
			subtitle: "MOD : Modern Online Picture Frame"
			description: [
				"&eWow, why is this locked behind the Orange rank? It's a single item and...oh, of course. Enticement..."
				""
				"&eWhat is it, you ask? Well, Bandit, this is called Modern Online Picture Frame. It enables you to load an image from the internet into the game. "
				""
				"&eWell, as long as the image link ends in .jpg, .png, or .gif (yep, animated gifs are supported!)."
				""
				"&eWhen you first place it, it will be sticking out from the wall (it acts like a full block behind it). You can Right Click it to change options. If you want it flush with the wall like a Painting, click Stitch."
				""
				"&eYou can also place the picture frame on a wall or ceiling by Sneak + Right Clicking when placing it."
				""
				"&eYou can change how big the image is as well as a few other options."
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "436D800FA8D9B4DF"
			tasks: [{
