				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Never Enough Blocks"
			x: -4.5d
			y: -1.5d
			shape: "rsquare"
			description: [
				"&eGot a large build that needs a lot of Chiseled blocks? Look no further, Bandit."
				""
				"&eThe Auto Chisel will automatically convert stacks of Chiselable materials into the design of your choice."
				""
				"&eSimply put in one of the Chisels in the top center, and the Chiseled block you want in the bottom center. Then put blocks that can be Chiseled to your chosen design in the left, and they'll pop over to the right after being Chiseled!"
				""
				"&eOh, right, the AutoChisel requires power. Kind of important."
			]
			dependencies: ["749B56B34708C3D7"]
			id: "0FBFAC82CDA27370"
			tasks: [{
				id: "1550B79BDB6536A4"
				type: "item"
				item: "chisel:auto_chisel"
			}]
			rewards: [{
				id: "04CD9B407233B195"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Sparkling Lights Strung High"
			x: 0.25d
			y: 0.25d
			shape: "square"
			subtitle: "MOD : Fairy Lights"
			description: [
				"&eThere's something lovely about light strings. You see them during Christmas, but they are an everyday thing as they are a cheap and fantastic way to light paths and large areas."
				""
				"&eThey are called Fairy Lights, Hanging Lights, Light Strings, and a few others (usually holiday related of course)."
				""
				"&eYou can make your very own, and customize them in a variety of ways to fit in with your architectural designs!"
				""
				"&eTo start simple, all you need is at least one Fairy Light. There's a lot of designs to choose from, which you can dye like Leather Armor (crafting them with any combination of Dyes.)"
				""
				"&eYou can then make a string of Hanging Lights by combining any number of Fairy Lights with Iron Ingots and String! Then to string them up, just hold them and Right Click on the side of any solid block, then again on another block to string up the lights between them!"
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "584C2E55F0843EFA"
			tasks: [
				{
					id: "00D4FC079F7AFDBE"
					type: "item"
					title: "Any Fairy Light Light"
					item: {
						id: "itemfilters:tag"
						Count: 1b
						tag: {
							value: "fairylights:lights"
						}
					}
				}
				{
					id: "679699AA48CA519F"
					type: "item"
					item: "fairylights:hanging_lights"
				}
			]
			rewards: [{
				id: "6DFFE2172C61293B"
				type: "choice"
				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Pennant Banners"
			x: 2.25d
			y: 0.25d
			shape: "rsquare"
			description: [
				"&eA great way to show your spirit, be it for a team, a group, or just your favorite colors, but without lighting an entire area, you can use Pennants!"
				""
				"&eThese paper designs are cheap to make, can be dyed just like the illuminating Fairy Lights."
				""
				"&eNote though, you cannot mix Fairy Lights and Pennants on the same string. It's a bit of a fire hazard..."
				""
				"&e...if it was real life. The FOPGame Server just limits you for some reason. Go figure."
			]
			dependencies: ["584C2E55F0843EFA"]
			id: "0392C5267F28799A"
			tasks: [
				{
					id: "005089A47FDF427D"
