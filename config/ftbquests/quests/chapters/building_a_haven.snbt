		}
		{
			title: "Pattern Perfect"
			x: 5.75d
			y: -0.75d
			shape: "rsquare"
			description: [
				"&eNow that you know how to make Patterns, now you can learn how to modify them! At least a bit."
				""
				"&eThe Modification Table lets you Flip or Mirror the design on the different axis."
				""
				"&eThe Chisel Station is a super useful tool for big builds that use primarily ONE material of Bit. If you aren't mixing the Bits together, you can use the Chisel Station to produce multiple of the block from the Pattern, as long as you provide the Bits as well."
			]
			dependencies: ["4245C58C1F608F89"]
