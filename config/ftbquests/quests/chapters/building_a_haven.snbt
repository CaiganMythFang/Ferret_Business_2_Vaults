		{
			title: "Mob Protection Racket"
			x: -3.25d
			y: 1.25d
			shape: "square"
			subtitle: "MOD : Torchmaster (@torchmaster)"
			description: [
				"&4&lRESEARCH : &r&4TORCH MASTER"
				""
				"&eAh, an old favorite was put into the FOPGame Server I see! Torchmaster is quite a popular brand in The Ferret Business' own exploration endeavours. Not surprised to see the FOP has copied it into their own place too."
				""
				"&eIn hostile, dangerous places, you need some kind of magic or technology that will prevent the creepy crawlies from appearing close to your camp. The Mega Torch is one such device."
				""
				"&ePlace it, and in a very large radius around it, hostile creatures cannot (usually) spawn. I say usually, because as is with magic and the laws of the universe, sometimes something just doesn't agree with the Mega Torch and appears anyways."
				""
				"&eBut hey, stopping 99.9% of hostile creatures is still pretty good!"
			]
			hide_dependency_lines: true
			dependencies: ["06FED1C3C1EA8361"]
			id: "15C4DE355F5089D1"
			tasks: [{
				id: "0AA97B82A0691B6F"
				type: "item"
				item: "torchmaster:megatorch"
			}]
			rewards: [{
				id: "580DB78F1050DD83"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			x: -5.25d
			y: 1.25d
			shape: "rsquare"
			description: [
				"&eThe Dread Lamp is sort of like the Mega Torch, except it stops passive creatures from spawning. "
				""
				"&eSo if you got a cave, or a river, or something like that where calm critters like to appear, but they are a bit of an issue... then you want to place down a Dread Lamp!"
			]
			dependencies: ["15C4DE355F5089D1"]
			id: "5CCF4969E919BE0C"
			tasks: [{
				id: "600EB1BD187D2758"
