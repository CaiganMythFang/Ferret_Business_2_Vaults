			}]
		}
		{
			title: "Never Enough Blocks"
			x: 0.75d
			y: 2.75d
			shape: "rsquare"
			subtitle: "Mod : ReChiseled Create"
			description: [
				"&eGot a large build that needs a lot of Chiseled blocks? Look no further, Bandit."
				""
				"&eThe Mechanical Chisel will automatically convert the appropriate materials to the set Rechiseled block."
				""
				"&eSimply Right Click the target block on the white square on the Mechanical Chisel, then run Create or other Conveyor Belts to it."
				""
				"&eNote that the Mechanical Chisel itself will require Rotational Power from Create to operate."
			]
			dependencies: ["749B56B34708C3D7"]
			id: "0FBFAC82CDA27370"
			tasks: [{
