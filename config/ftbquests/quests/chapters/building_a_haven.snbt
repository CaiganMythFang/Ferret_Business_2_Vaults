		}
		{
			title: "Little Lights"
			x: 1.25d
			y: 2.75d
			shape: "rsquare"
			description: [
				"&eQuark adds a few nice decorative lights, that give a certain ambience to your builds."
				""
				"&eCandles can be made from Tallow collected after killing various creatures. "
				""
				"&ePaper Lanterns come in two varieties: plain, and then if you add any sapling to it, turns it into a very pretty Decorated Paper Lantern."
			]
			dependencies: ["4DC50AC316891B1D"]
