				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Computers and Upgrades"
			x: -9.5d
			y: -2.0d
			shape: "square"
			description: [
				"&7To access the Medium, you would need a special SBurb Computer with special Client and Server discs. The Client and Server discs don't really exist now, but the SBurb Computer does."
				""
				"&7You can find some electronics in the Shop Tablet, and then make yourself a SBURB Computer, then Captchalogue it so you can upgrade it."
				""
				"&7The first Computer upgrade you can do is getting yourself a Laptop instead! It looks nicer and is more portable. Kinda. "
				""
				"&7Though really, none of these computers can really be used for anything other than decoration (without the SBurb code I mean)"
			]
			dependencies: ["4EAEC7D5C5DD1893"]
			id: "6F2679D258D56AD2"
			tasks: [
				{
					id: "1F42AE925654F800"
					type: "item"
					item: "minestuck:computer"
				}
				{
					id: "36CF98A62782E4CC"
