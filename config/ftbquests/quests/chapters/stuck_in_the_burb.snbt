				table_id: 2640422954496342337L
			}]
		}
		{
			title: "Sporkkind"
			x: 4.0d
			y: 2.5d
			shape: "rsquare"
			description: [
				"&7Sporkkind is a type of weapon. In the original SBURB you could specialize in weapon types, but it doesn't seem like that functionality is in Minestuck. But you can still make and use the powerful Sporkkind weapons!"
				""
				"&7The Wooden Spoon is easily made with a bowl and some sticks. Or Alchemied up, either way its not a very powerful weapon, but its a start."
				""
				"&7By Latheing Wooden Spoon and Iron Ingot (Punched) Cards, you get a Silver Spoon. You can also make a Fork, which also falls under Sporkkind."
				""
				"&7To make one of the ultimate Sporkkind weapons, Lathe (Punched) Silver Spoon and Cake cards together to make a Junior Battlemasters Bowl Buster Stirring Solution 5000 (aka : JBBSS)"
				""
				"&7This weapon transforms from Spoon to Fork and back by Sneak + Right Clicking with it."
			]
			dependencies: ["4EAEC7D5C5DD1893"]
