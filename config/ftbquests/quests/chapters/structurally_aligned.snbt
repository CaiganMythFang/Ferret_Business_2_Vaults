		{
			title: "Enforce and Mechamaton"
			x: 0.5d
			y: 0.75d
			shape: "rsquare"
			description: [
				"&5Enforcers and Mechamatons are hostile melee robots that spawn in Iromine. Enforcers spawn mostly in Iro Passages, while Mechamatons spawn everywhere."
				""
				"&5Mechamatons hit quite hard and can push you back far. "
				""
				"&5Enforcers can drop Scrap Metal and Armour Plating, both good for crafting. They can also drop Overshot, a gun that fires two bullets at once."
				""
				"&5Mechamatons can drop Power Cores and Armour Plating, both good for crafting. They can also drop Gold Springs, needed to spawn the boss of Iromine."
			]
			dependencies: ["74EECDA839B87041"]
			id: "0F8EBD5763937B40"
			tasks: [
				{
