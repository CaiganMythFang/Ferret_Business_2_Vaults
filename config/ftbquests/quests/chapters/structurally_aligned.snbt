	title: "Structurally Aligned"
	default_quest_shape: ""
	default_hide_dependency_lines: false
	quests: [
		{
			x: -5.75d
			y: 1.25d
			shape: "pentagon"
			description: [
				"&dSo it seems our next worlds will be branching off of Barathos and the Deeplands."
				""
				"&5Both worlds are usually cold ones. And not in the way of ice and snow."
				""
				"&dMore on the coldness of their populaces. You see, the two world spots are reserved for worlds with constructed creatures."
				""
				"&5Robots, inanimate constructs, etc. These worlds take special handling, so they have dedicated spots in the FOP Game Server."
				""
				"&dWe'll have to see if the citizens are friendly or not. Though like most of the worlds, they are probably mostly hostile as their world slowly decimates from the FOP Game Server."
			]
			dependencies: ["0A67F99F89487841"]
			id: "7FFED67FB77CBB40"
			tasks: [{
				id: "6C79F11EA85DE72C"
				type: "checkmark"
				title: "Cold Worlds Ahead"
			}]
		}
		{
			title: "Mechanical World"
			x: -4.0d
			y: -1.5d
			shape: "diamond"
			description: [
				"&dIromine is a world of robots, Bandit. It's also a fairly... chaotic dimension."
				""
				"&5You'll see what we mean when you get there. Here's hoping the populace isn't reprogrammed or anything."
				""
				"&dProbably just angry and trying to survive, like every Power User in this dang game."
				""
				"&5True. Okay Bandit, getting the Iromine Realmstone is easy : Just Right Click a blank Realmstone onto a Mineralization Station."
				""
				"&dIf you didn't keep one from your first trip to Barathos, you can find them in Baron Castles, the tall dark grey towers that dot the landscape."
			]
			dependencies: ["7FFED67FB77CBB40"]
			id: "314363C30CBD4A72"
			tasks: [{
				id: "762F71FB3A551EFE"
				type: "item"
				item: "aoa3:iromine_realmstone"
			}]
			rewards: [{
				id: "0234FEA95787DF79"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Golden Hills"
			x: -1.75d
			y: -1.5d
			shape: "pentagon"
			description: [
				"&dWelcome to Iromine, Bandit. In its own way, its very pretty."
				""
				"&5Black and gold is a very good color combination. Seems a bit odd for a  whole 'world', but it definitely seems to fit here."
				""
				"&dSeeing a variety of structures in the scans. Lots of robots guarding them. So, probably hostile?"
				""
				"&5Safest bet, of course. Be careful exploring, Bandit. "
			]
			dependencies: ["314363C30CBD4A72"]
			id: "0E04A165AB54DBDA"
			tasks: [{
				id: "3F29CB64074EE3AE"
				type: "dimension"
				dimension: "aoa3:iromine"
			}]
			rewards: [{
				id: "2D9AD8D4A64F2B9F"
				type: "choice"
				table_id: 5632731352558517809L
			}]
		}
		{
			title: "Steel and Gold"
			x: 0.5d
			y: -1.5d
			shape: "hexagon"
			description: [
				"&dBelow the surface of Iromine, you can find caves and other things, as well as one pretty and strong ore: Lyon Ore. Smelting this gets you Lyon Ingots."
				""
				"&5Pretty good stuff, lot you can make with it. "
				""
				"&dAlong with the metal ingot, you'll want to find Magnet Shards. You'll find them in some structures, but mostly they are collected and held by the denizens of Iromine, so you'll want to collect some of them as well."
				""
				"&5Oh, right. Various buildings and structures in Iromine contain Iro Crates. One of the robotic denizens seems to pack these randomly around, for reasons we haven't figured out yet."
				""
				"&dBust one open with a pickaxe, it might have some interesting things in it! Or hit it with Silk Touch to collect it for later."
			]
			dependencies: ["0E04A165AB54DBDA"]
			id: "20A8A0903136EE35"
			tasks: [
				{
					id: "1DE6382DD714FAED"
					type: "item"
					item: "aoa3:lyon_ingot"
				}
				{
					id: "647537A17AD0152C"
