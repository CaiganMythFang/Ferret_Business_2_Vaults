    {
      "uuid": "9b991f2a-7a6d-4995-b74e-ce4f72478dd1",
      "name": {
        "text": " Opening the Shop",
        "isTranslationKey": false
      },
      "description": {
        "text": "    Those are the basics of the Shipping System and the Shop Tablet. We\u0027ll open up the rest of the tablet to you. Each section will explain have their own explanations you should read.\n    The rest of this Shop page will be tools and machines you can buy that aid you in making and collecting FMC.",
        "isTranslationKey": false
      },
      "x": 115,
      "y": 21,
      "icon": {
        "id": "everycomp:mcd/hexcasting/akashic_glass_door",
        "Count": 1
      },
      "tasks": [
        {
          "type": "DETECT",
          "description": {
            "text": "Quarter Hundro",
            "isTranslationKey": false
          },
          "longDescription": {
            "text": "    I\u0027ll have the system check that you have 25 Ferret Dollars minimum before proceeding. Things are going to cost a lot here, due to time and effort needed to spread the Worm.\n    I estimate items will cost 5x to 10x more than they sell for.\n    You can follow the main Q.U.E.S.T. Tablet to get more Ferret Dollars, or combine an Ender Pearl with a Vault Bronze to \u0027emergency sell\u0027 it.",
            "isTranslationKey": false
          },
          "items": [
            {
              "item": {
                "id": "tfb2:ferret_dollar",
                "Count": 1
              },
              "required": 25,
              "precision": "NBT_FUZZY"
            }
          ]
        }
      ],
      "prerequisites": [
        "3ac5316e-5492-4bd2-b0de-a8b695469b91"
      ],
