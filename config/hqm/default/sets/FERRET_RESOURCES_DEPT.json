    {
      "uuid": "2f03f6e6-7c74-496e-b834-97ef6c01ea31",
      "name": {
        "text": "  Start Here!",
        "isTranslationKey": false
      },
      "description": {
        "text": "    Welcome to the Business Shop, Bandit!\n    So, to go over things simply, this tablet will teach you how to \u0027sell\u0027 things to us back home at The Ferret Business, and how to use this tablet to buy items.\n    For now, take this TFB Copper Debit Card. This will be a useful tool we\u0027ll explain later.",
        "isTranslationKey": false
      },
      "x": 23,
      "y": 21,
      "icon": {
        "id": "projecte:klein_star_ein",
        "Count": 1
      },
      "tasks": [
        {
          "type": "CHECKBOX",
          "description": {
            "text": "Click the Tiny Box",
            "isTranslationKey": false
          },
          "longDescription": {
            "text": "To progress this quest, simply mark the checkbox below.",
            "isTranslationKey": false
          }
        }
      ],
